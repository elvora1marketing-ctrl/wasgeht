---
import GlitchCta from './GlitchCta.astro';
import Texture from './Texture.astro';
import Scramble from './Scramble.astro';
import ReviewBadge from './ReviewBadge.astro';
import { cta, contactLinks } from '~/config/site';

/**
 * Wiederkehrender Abschluss jeder Seite.
 *
 * Genau ein hervorgehobener CTA, der zweite bleibt untergeordnet und ist
 * zugleich eine Vorführung: wer schreibt, erlebt die KI-Assistenz selbst.
 *
 * Nicht mehr mittig gesetzt. Ein zentrierter Kasten ist die Standardform für
 * einen Abschluss und sieht auf jeder zweiten Website so aus. Linksbündig mit
 * der Handlung rechts nimmt die Achse der übrigen Seite auf.
 */
interface Props {
  heading?: string;
  text?: string;
  kennung?: string;
}

const {
  heading = 'Klingt das nach Ihrem Betrieb?',
  text = 'In einem kurzen Gespräch schauen wir, wo bei Ihnen gerade Anfragen verloren gehen. Ohne Vorbereitung, ohne Verpflichtung.',
  kennung = 'Loslegen',
} = Astro.props;
---

<section class="schlussband">
  <Texture variant="schraffur" />

  <div class="container-content schlussband-inner">
    <div class="schlussband-text">
      <p class="schlussband-kennung kennung">
        <Scramble text={kennung} />
      </p>
      <hr />
      <h2 class="schlussband-schlag">{heading}</h2>
      <p class="schlussband-satz">{text}</p>
    </div>

    <div class="schlussband-handlung">
      <GlitchCta href={cta.primary.href} label={cta.primary.label} ton="hell" size="lg" />
      <p class="schlussband-notiz">{cta.primary.note}</p>

      {/* Der Beleg gehoert NEBEN den Aufruf, nicht nur an den Seitenanfang.
          An der Stelle, an der jemand sich entscheidet, ist die Frage
          „kann der das ueberhaupt" wieder da. */}
      <ReviewBadge tone="inverse" class="schlussband-beleg" />

      {/* DER ZWEITE WEG IST EIN KNOPF, wie im Aufschlag und im Fuss.
          Vorher lag er als unterstrichenes Satzstueck in einem Absatz,
          zwischen zwei weiteren Absaetzen in derselben Groesse -- man
          musste die Zeile lesen, um zu merken, dass da ueberhaupt etwas
          anzuklicken war.

          HIER STANDEN AUSSERDEM ZWEI ZUSAGEN UNTEREINANDER: die Antwort-
          zeit und darunter noch einmal, dass die Assistenz sofort
          antwortet. Zweimal dasselbe unter demselben Knopf. Geblieben ist
          der Satz, der zugleich eine Vorfuehrung ankuendigt. */}
      <a
        class="schlussband-whatsapp"
        href={contactLinks.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 2a8 8 0 0 0-6.9 12l-1 3.7 3.8-1A8 8 0 1 0 10 2zm0 1.6a6.4 6.4 0 1 1-3.3 11.9l-.3-.2-2.2.6.6-2.1-.2-.3A6.4 6.4 0 0 1 10 3.6zM7.4 6.3c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.4s.6 1.6.7 1.8c.1.1 1.2 2 3 2.7 1.5.6 1.8.5 2.1.5.4 0 1.1-.4 1.3-.9.2-.5.2-.9.1-1l-.4-.2-1.2-.6c-.2 0-.3-.1-.4.1l-.6.7c-.1.2-.2.2-.4.1-.2-.1-.9-.3-1.6-1a6 6 0 0 1-1.1-1.4c-.1-.2 0-.3.1-.4l.3-.4.2-.3v-.4l-.6-1.4c-.1-.4-.3-.3-.4-.3z" />
        </svg>
        Auf WhatsApp schreiben
      </a>

      <p class="schlussband-notiz">
        Dort antwortet zuerst die Assistenz. Sie sehen sie also gleich in
        Aktion.
      </p>
    </div>
  </div>
</section>

<style>
  .schlussband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #16193a;
    color: #fff;
  }

  .schlussband-inner {
    position: relative;
    z-index: 10;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  @media (width >= 64rem) {
    .schlussband-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    }
  }

  .schlussband-text {
    display: flex;
    flex-direction: column;
    gap: clamp(0.875rem, 1.8vw, 1.25rem);
  }

  .schlussband-kennung {
    margin: 0;
    opacity: 0.85;
  }

  .schlussband hr {
    margin: 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.28);
  }

  .schlussband-schlag {
    margin: 0;
    color: #fff;
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  .schlussband-satz {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    opacity: 0.92;
  }

  .schlussband-handlung {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .schlussband-beleg {
    margin-top: 1rem;
  }

  .schlussband-notiz {
    margin: 0;
    max-width: 40ch;
    font-size: 0.875rem;
    opacity: 0.82;
  }

  /* Umriss in WhatsApp-Gruen statt Flaeche: der weisse Haupt-Aufruf
     darueber bleibt damit der hellste Punkt der Tafel, das Gruen wird
     trotzdem sofort erkannt. */
  .schlussband-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0.8rem 1.5rem;
    border: 1px solid color-mix(in oklab, #25d366 55%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, #25d366 12%, transparent);
    color: color-mix(in oklab, #25d366 55%, #fff);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .schlussband-whatsapp:hover {
    transform: translateY(-1px);
    border-color: #25d366;
    background: color-mix(in oklab, #25d366 22%, transparent);
  }

  .schlussband-whatsapp:active {
    transform: translateY(0);
  }

  .schlussband-whatsapp svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #25d366;
  }

  @media (width < 30rem) {
    .schlussband-whatsapp {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .schlussband-text,
      .schlussband-handlung {
        animation-name: auftauchen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }

      .schlussband-text {
        animation-range: entry 8% entry 52%;
      }

      .schlussband-handlung {
        animation-range: entry 16% entry 62%;
      }
    }
  }
</style>
