---
import Logo from './Logo.astro';
import ShimmerCta from './ShimmerCta.astro';
import {
  site,
  address,
  contact,
  contactLinks,
  openingHours,
  services,
  serviceArea,
  cta,
} from '~/config/site';

/**
 * Fußbereich.
 *
 * Dunkel wie das Schlussband darüber, damit die Seite in EINER Fläche
 * ausklingt statt in einem grauen Anhang.
 *
 * Der Fuß bietet noch EINEN Weg an -- WhatsApp, den mit der geringsten
 * Hemmschwelle -- und hört danach auf zu werben. Vorher stand hier ein
 * Satz in Überschriftengröße und darunter noch das Antwortzeit-Versprechen
 * aus dem Abschluss: dieselbe Zusage zum zweiten Mal, zwanzig Zentimeter
 * tiefer. Wiederholung an dieser Stelle überzeugt niemanden mehr, sie
 * lässt die Seite nur nicht enden.
 */
const year = new Date().getFullYear();

const legalLinks = [
  { label: 'Impressum', href: '/impressum/' },
  { label: 'Datenschutz', href: '/datenschutz/' },
];

const seiten = [
  { label: 'Leistungen', href: '/leistungen/' },
  { label: 'Über mich', href: '/ueber-mich/' },
  { label: 'Kontakt', href: '/kontakt/' },
  { label: 'Erstgespräch', href: cta.primary.href },
];
---

<footer class="fuss">
  <div class="container-content">
    {/* --- Der letzte Aufruf ----------------------------------------------
        FRÜHER STAND HIER EIN GROSSER SERIFENSATZ mit kursivem „Hallo",
        knapp drei Zentimeter hoch. Der Fuß ist die letzte Fläche der
        Seite; ein Auftritt in dieser Größe direkt unter dem Abschluss ließ
        die Seite zweimal enden und gab dem Ganzen einen schiefen Ton.

        Jetzt eine ruhige Zeile in der Grundschrift. Der Fuß darf hier
        etwas anbieten, aber er soll nichts mehr verkaufen -- das ist
        einen Abschnitt weiter oben schon passiert. */}
    <div class="fuss-kopf">
      <p class="fuss-schlag">Kurz Hallo sagen genügt.</p>

      <div class="fuss-handlung">
        <ShimmerCta
          href={contactLinks.whatsapp}
          ton="whatsapp"
          size="md"
          class="fuss-knopf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 2a8 8 0 0 0-6.9 12l-1 3.7 3.8-1A8 8 0 1 0 10 2zm0 1.6a6.4 6.4 0 1 1-3.3 11.9l-.3-.2-2.2.6.6-2.1-.2-.3A6.4 6.4 0 0 1 10 3.6zM7.4 6.3c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.4s.6 1.6.7 1.8c.1.1 1.2 2 3 2.7 1.5.6 1.8.5 2.1.5.4 0 1.1-.4 1.3-.9.2-.5.2-.9.1-1l-.4-.2-1.2-.6c-.2 0-.3-.1-.4.1l-.6.7c-.1.2-.2.2-.4.1-.2-.1-.9-.3-1.6-1a6 6 0 0 1-1.1-1.4c-.1-.2 0-.3.1-.4l.3-.4.2-.3v-.4l-.6-1.4c-.1-.4-.3-.3-.4-.3z" />
          </svg>
          Auf WhatsApp schreiben
        </ShimmerCta>
      </div>
    </div>

    <hr class="fuss-linie" />

    {/* --- Spalten --------------------------------------------------------- */}
    <div class="fuss-spalten">
      <div class="fuss-marke">
        <Logo ton="hell" />
        <p>
          Digitale Sichtbarkeit und weniger Bürokratie für Betriebe und
          Selbstständige in {serviceArea.display}.
        </p>
      </div>

      <nav aria-label="Leistungen">
        <h2 class="fuss-titel kennung">Leistungen</h2>
        <ul class="fuss-liste">
          {
            services.map((service) => (
              <li>
                <a href={service.href} class="fuss-link">
                  {/* Der Punkt traegt die Farbe der Leistung, aufgehellt:
                      die Originaltoene sind fuer dunklen Grund zu dunkel. */}
                  <span
                    class="fuss-punkt"
                    style={`--punkt:${service.color}`}
                    aria-hidden="true"
                  />
                  {service.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Seiten">
        <h2 class="fuss-titel kennung">Seiten</h2>
        <ul class="fuss-liste">
          {
            seiten.map((eintrag) => (
              <li>
                <a href={eintrag.href} class="fuss-link">
                  {eintrag.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="fuss-titel kennung">Kontakt</h2>
        <address class="fuss-liste fuss-adresse">
          <span>
            {site.name}<br />
            {address.street}<br />
            {address.postalCode}&nbsp;{address.city}
          </span>
          <a href={contactLinks.tel} class="fuss-link">{contact.phoneDisplay}</a>
          <a href={contactLinks.mail} class="fuss-link">{contact.email}</a>
          <span class="fuss-dezent">{openingHours.display}</span>
          {/* Die Öffnungszeiten sind die Zeiten, zu denen LUAN erreichbar
              ist. Die Assistenz ist es immer -- und das ist auf dieser
              Seite kein Nebensatz, sondern das Produkt. Direkt unter der
              Zeile mit den Bürozeiten steht es genau da, wo jemand gerade
              denkt „jetzt ist zu". */}
          <span class="fuss-rundumdieuhr">
            <span class="fuss-punkt-live" aria-hidden="true"></span>
            Nachrichten beantwortet die Assistenz rund um die Uhr
          </span>
        </address>
      </div>
    </div>

    {/* --- Schlusszeile ----------------------------------------------------- */}
    <div class="fuss-schluss">
      {/* Nur Jahr und Name. Der Zusatz „Aus Essen, im Einsatz im
          Ruhrgebiet und darüber hinaus" stand hier als letzte Zeile der
          Seite -- ein Werbesatz an der Stelle, an der ein Rechtshinweis
          steht. Das Einsatzgebiet steht ohnehin oben in der Spalte. */}
      <p>&copy; {year} {site.name}</p>
      <ul class="fuss-recht">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="fuss-link">{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

</footer>

<style>
  .fuss {
    position: relative;
    overflow: hidden;
    background: #101227;
    color: rgb(255 255 255 / 0.78);
  }

  .fuss-kopf {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  @media (width >= 56rem) {
    .fuss-kopf {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  /* In der GRUNDSCHRIFT, nicht in der Serif der Überschriften, und in
     einem Maß, das eine Einladung ist und kein Auftritt. */
  .fuss-schlag {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: #fff;
  }

  .fuss-handlung {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* HIER STAND EIN EIGENER GRUENER KNOPF.
     Er ist demselben Aufruf gewichen wie ueberall sonst auf der Seite.
     Ein Knopf, ein Aussehen -- vorher gab es vier verschiedene, und
     keiner sah aus wie der naechste. */

  .fuss-linie {
    margin: 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  /* --- Spalten ------------------------------------------------------------ */
  .fuss-spalten {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (width >= 48rem) {
    .fuss-spalten {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.1fr);
      gap: 2rem;
    }
  }

  .fuss-marke p {
    margin: 1rem 0 0;
    max-width: 24ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.6);
  }

  .fuss-titel {
    margin: 0 0 1.1rem;
    color: rgb(255 255 255 / 0.45);
  }

  .fuss-liste {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fuss-adresse {
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .fuss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.75);
    text-decoration: none;
    transition: color 0.15s;
  }

  .fuss-link:hover {
    color: #fff;
  }

  .fuss-punkt {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    /* Aufgehellt: die Leistungsfarben sind fuer helle Flaechen gerechnet
       und gingen auf dem dunklen Grund unter. */
    background: color-mix(in oklab, var(--punkt) 55%, #fff);
  }

  .fuss-dezent {
    color: rgb(255 255 255 / 0.45);
    font-size: 0.875rem;
  }

  .fuss-rundumdieuhr {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: color-mix(in oklab, #25d366 62%, #fff);
  }

  .fuss-punkt-live {
    position: relative;
    top: -0.15em;
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: #25d366;
  }

  /* Derselbe Puls wie am Statusabzeichen im Aufschlag. Bewusst dasselbe
     Zeichen an beiden Enden der Seite: was oben behauptet wird, steht
     unten noch einmal am Kontakt. */
  @media (prefers-reduced-motion: no-preference) {
    .fuss-punkt-live::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: #25d366;
      animation: fuss-pulsen 2.4s ease-out infinite;
    }
  }

  @keyframes fuss-pulsen {
    0% { transform: scale(1); opacity: 0.6; }
    70% { transform: scale(2.6); opacity: 0; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  /* --- Schlusszeile --------------------------------------------------------- */
  .fuss-schluss {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.5);
  }

  .fuss-schluss p {
    margin: 0;
  }

  .fuss-recht {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fuss-recht .fuss-link {
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.6);
  }
</style>
