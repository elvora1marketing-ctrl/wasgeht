---
import { reviews } from '~/config/site';

/**
 * Überlappende Kreise der Bewertenden.
 *
 * ABWEICHUNG VON DER VORLAGE: Die Vorlage zeigt Portraitfotos. Das geht hier
 * aus zwei Gründen nicht.
 *
 * Erstens rechtlich: Profilbilder aus Google-Bewertungen sind
 * personenbezogene Daten Dritter. Sie auf die eigene Website zu übernehmen
 * braucht eine Einwilligung der abgebildeten Person, und die hat man in
 * aller Regel nicht.
 *
 * Zweitens inhaltlich: erfundene Gesichter aus einem Stock-Verzeichnis wären
 * auf einer Seite, die Vertrauen aufbauen soll, ein gefälschter Beleg.
 *
 * Deshalb Initialen statt Fotos. Sie kommen aus den echten Namen der echten
 * Bewertungen und behaupten nichts, was nicht stimmt.
 *
 * Rendert nichts, solange keine Bewertungen hinterlegt sind.
 */
interface Props {
  /** Wie viele Kreise gezeigt werden, bevor die Zählmarke kommt. */
  max?: number;
  /** `inverse` für farbige Flächen. */
  tone?: 'light' | 'inverse';
  class?: string;
}

const { max = 4, tone = 'light', class: className = '' }: Props = Astro.props;

const zeigen = reviews.enabled && reviews.items.length > 0;

const sichtbar = reviews.items.slice(0, max);
const rest = reviews.count - sichtbar.length;

/**
 * Kuerzel fuer den Kreis.
 *
 * Bei einem Namen die Anfangsbuchstaben von Vor- und Nachname. Die anonymen
 * Stimmen haben die Form "Branche aus Stadt"; dort kommen die ersten beiden
 * Buchstaben der Branche in den Kreis. Anfangsbuchstaben taugen da nicht:
 * "Sanitärbetrieb aus Essen" und "Steuerkanzlei aus Essen" ergaeben beide
 * "SE", und zwei gleiche Kreise sehen nach einem Fehler aus.
 */
const initialen = (name: string) => {
  const sauber = name.trim();

  if (/\saus\s/.test(sauber)) {
    const wort = sauber.split(/\s+/)[0] ?? '';
    return wort.charAt(0).toUpperCase() + wort.charAt(1).toLowerCase();
  }

  return sauber
    .split(/\s+/)
    .slice(0, 2)
    .map((teil) => teil[0]?.toUpperCase() ?? '')
    .join('') || '?';
};
---

{
  zeigen && (
    <span
      class={`kreise ${tone === 'inverse' ? 'kreise-invers' : ''} ${className}`}
      aria-label={`${reviews.count} Bewertungen`}
    >
      {sichtbar.map((stimme, i) => (
        <span class="kreis" style={`--rang:${i}`} aria-hidden="true">
          {initialen(stimme.author)}
        </span>
      ))}

      {rest > 0 && (
        <span class="kreis kreis-rest" style={`--rang:${sichtbar.length}`} aria-hidden="true">
          +{rest}
        </span>
      )}
    </span>
  )
}

<style>
  .kreise {
    display: inline-flex;
    align-items: center;
  }

  /* DREI FARBEN IM WECHSEL, NICHT VIERMAL DIESELBE.
     Vier gleich blassrosa Kreise nebeneinander lesen sich als ein Fleck.
     Im Wechsel der drei Markenfarben werden daraus vier Personen -- und
     die Reihe bekommt genau die Lebendigkeit, die eine Bewertungszeile
     braucht, ohne dass ein einziges erfundenes Gesicht dabei waere. */
  .kreis {
    --ton: var(--color-brand-mid, #b23a94);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 999px;
    border: 2px solid var(--color-surface);
    background: color-mix(in oklab, var(--ton) 14%, var(--color-surface));
    color: color-mix(in oklab, var(--ton) 78%, #000);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .kreis:nth-child(3n + 1) { --ton: var(--color-brand-start, #5c67db); }
  .kreis:nth-child(3n + 2) { --ton: var(--color-brand-mid, #b23a94); }
  .kreis:nth-child(3n + 3) { --ton: var(--color-brand-end, #f45e3d); }

  /* Ueberlappung. Der erste Kreis bleibt stehen, die weiteren ruecken auf. */
  .kreis + .kreis {
    margin-inline-start: -0.55rem;
  }

  /* Der vordere Kreis liegt oben, sonst verdeckt der letzte den ersten. */
  .kreis {
    z-index: calc(10 - var(--rang));
  }

  /* Die Zaehlmarke ist keine Person, sondern eine Zahl. Vorher stand sie
     als schwarze Scheibe am Ende der Reihe und zog mehr Aufmerksamkeit
     auf sich als die Bewertung selbst. */
  .kreis-rest {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-ink-faint);
  }

  .kreise-invers .kreis {
    border-color: rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }

  .kreise-invers .kreis-rest {
    background: #fff;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .kreis {
        animation-name: aufrucken;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry calc(15% + var(--rang) * 8%) entry
          calc(50% + var(--rang) * 8%);
      }
    }
  }

  @keyframes aufrucken {
    from {
      opacity: 0;
      transform: translateX(0.75rem) scale(0.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
