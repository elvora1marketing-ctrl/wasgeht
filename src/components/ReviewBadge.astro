---
import { reviews } from '~/config/site';
import Sterne from './Sterne.astro';
import Bewerterkreise from './Bewerterkreise.astro';

/**
 * Bewertungsbeleg.
 *
 * Rendert nichts, solange `reviews.enabled` false ist, damit auf der Seite
 * nie eine Bewertungsbehauptung ohne Grundlage steht.
 *
 * ZWEI GRÖSSEN
 *
 * `kompakt` ist die Zeile für Fußbereiche und Nebenplätze.
 *
 * `gross` ist der Beleg im ersten Sichtbereich. Er steht dort direkt unter
 * der Überschrift und nicht mehr am unteren Rand: auf einem Bildschirm mit
 * 900 Punkten Höhe stand die kompakte Zeile genau an der Kante und war beim
 * ersten Blick nicht dabei. Ein Beleg, den man erst durch Scrollen findet,
 * arbeitet nicht.
 */
interface Props {
  /** `light` fuer helle Flaechen, `inverse` fuer dunkle. */
  tone?: 'light' | 'inverse';
  /** `gross` fuer den ersten Sichtbereich. */
  groesse?: 'kompakt' | 'gross';
  class?: string;
}

const { tone = 'light', groesse = 'kompakt', class: className = '' } = Astro.props;

const show = reviews.enabled && reviews.count > 0;
const gross = groesse === 'gross';

const ratingText = reviews.rating.toLocaleString('de-DE', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});

const label = `${ratingText} von 5 Sternen aus ${reviews.count} ${reviews.quelle}`;

const textColor = tone === 'inverse' ? 'text-white/80' : 'text-ink-muted';
const strongColor = tone === 'inverse' ? 'text-white' : 'text-ink';

const Tag = reviews.profileUrl ? 'a' : 'div';
---

{
  show && !gross && (
    <Tag
      class={`inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.9375rem] ${textColor} ${reviews.profileUrl ? 'hover:opacity-80 transition-opacity' : ''} ${className}`}
      {...(reviews.profileUrl
        ? { href: reviews.profileUrl, target: '_blank', rel: 'noopener noreferrer' }
        : {})}
      aria-label={label}
    >
      {/* Sicherung gegen versehentlich veroeffentlichte Platzhalter.
          Verschwindet, sobald `reviews.platzhalter` auf false steht. */}
      {reviews.platzhalter && <span class="platzhalter-marke">Beispieldaten</span>}

      <Sterne wert={reviews.rating} groesse={1.125} class="shrink-0" />
      <span aria-hidden="true">
        <span class={`font-semibold ${strongColor}`}>{ratingText}</span>
        {' aus '}
        <span class={strongColor}>{reviews.count}</span>
        {` ${reviews.quelle}`}
      </span>
    </Tag>
  )
}

{
  show && gross && (
    <div class:list={['beleg-halter', className]}>
      <Tag
        class:list={['beleg', tone === 'inverse' && 'beleg-invers']}
        {...(reviews.profileUrl
          ? { href: reviews.profileUrl, target: '_blank', rel: 'noopener noreferrer' }
          : {})}
        aria-label={label}
      >
        <Bewerterkreise max={4} tone={tone} class="beleg-kreise" />

        <span class="beleg-wertung" aria-hidden="true">
          <Sterne wert={reviews.rating} groesse={1.25} class="beleg-sterne" />
          <span class="beleg-zahl">{ratingText}</span>
        </span>

        <span class="beleg-text" aria-hidden="true">
          aus {reviews.count} {reviews.quelle}
        </span>
      </Tag>

      {/* Steht NEBEN der Pille, nicht darin: darin sprengte der Hinweis die
          Zeile und machte aus der Pille einen zweizeiligen Klotz. */}
      {reviews.platzhalter && <span class="platzhalter-marke">Beispieldaten</span>}
    </div>
  )
}

<style>
  /* `platzhalter-marke` steht in global.css: dieselbe Marke sitzt auch am
     Bewertungsabschnitt der Startseite. */

  /* --- Die grosse Fassung ------------------------------------------------ */
  .beleg-halter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  /* OHNE PILLE.
   *
   * Der Beleg sass in einem gerahmten Oval mit Fuellung. Im ersten
   * Sichtbereich stand damit ein zweiter Knopf zwischen Ueberschrift und
   * Text -- er sah aus wie etwas zum Anklicken, teilte die Textspalte in
   * zwei Haelften und nahm dem grossen Satz darueber die Wirkung.
   *
   * Eine Bewertung braucht keinen Rahmen. Sie braucht Gesichter, Sterne
   * und eine Zahl, die man aus zwei Metern liest. Alles drei steht jetzt
   * frei in der Spalte, ohne Kasten, ohne Fuellung. */
  .beleg {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    width: fit-content;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .beleg-wertung {
    /* Trennt Zahl und Herkunft mit einem Haarstrich statt mit Abstand.
       Ohne ihn liest sich „4,9 aus 12 Bewertungen" als ein Satz und die
       Zahl verliert genau das Gewicht, das sie tragen soll. */
    padding-inline-end: 0.75rem;
    border-inline-end: 1px solid var(--color-border);
  }

  .beleg-invers .beleg-wertung {
    border-inline-end-color: rgb(255 255 255 / 0.22);
  }

  .beleg-wertung {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Die Zahl in der Serifenschrift und gross: sie ist das Einzige an dieser
     Zeile, das aus zwei Metern Abstand noch zu erkennen ist. Instrument
     Serif hat keinen Fettschnitt, die Wirkung kommt aus dem Mass. */
  .beleg-zahl {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .beleg-invers .beleg-zahl {
    color: #fff;
  }

  .beleg-text {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* Der Hinweis auf Beispieldaten darf auffallen -- er ist die Sicherung
     gegen erfundene Bewertungen im Livegang. Als roter Block unter der
     Zeile schlug er aber alles andere im Aufschlag. Jetzt als schmale
     Kontur: unuebersehbar, wenn man hinsieht, und kein Klotz. */
  .beleg-halter :global(.platzhalter-marke) {
    background: transparent;
    color: var(--color-danger);
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .beleg-invers .beleg-text {
    color: rgb(255 255 255 / 0.8);
  }

  .beleg-kreise {
    flex-shrink: 0;
  }

  /* Unter dieser Breite braeuchte die Zeile drei Zeilen. Die Kreise sind
     die Zugabe und gehen zuerst. */
  @media (width < 26rem) {
    .beleg-kreise {
      display: none;
    }
  }
</style>
