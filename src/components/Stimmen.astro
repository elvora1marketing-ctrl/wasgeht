---
import Sterne from './Sterne.astro';
import { reviews } from '~/config/site';

/**
 * Kundenstimmen im Bento-Raster.
 *
 * Aufbau nach der Vorlage („testimonials"): eine grosse Karte, die zwei
 * Spalten und zwei Zeilen einnimmt, daneben kleinere. Der Reiz daran ist
 * das ungleiche Gewicht -- vier gleich grosse Kacheln liest man als
 * Tabelle und überfliegt sie; eine grosse mit kleineren daneben liest man
 * als „hier ist die Hauptaussage, hier sind die Belege dazu".
 *
 * OHNE REACT, OHNE SHADCN. Die Vorlage benutzt `Card` und `Avatar` aus
 * shadcn/ui; beide sind hier ein paar Zeilen CSS. `Avatar` bringt
 * ausserdem `@radix-ui/react-avatar` mit -- eine Bibliothek, deren einzige
 * Aufgabe es ist, bei einem fehlenden Bild auf die Anfangsbuchstaben
 * zurückzufallen. Hier gibt es gar keine Bilder, also fallen die
 * Anfangsbuchstaben nicht zurück, sie sind der Normalfall.
 *
 * KEINE GESICHTER, KEINE LOGOS. Die Vorlage zeigt Fotos und ein
 * Nike-Logo. Beides ginge hier nur mit erfundenen Personen und fremden
 * Marken -- und ein fremdes Firmenlogo auf der eigenen Seite behauptet
 * eine Kundenbeziehung, die es nicht gibt. Stattdessen: die
 * Anfangsbuchstaben in der Markenfarbe.
 *
 * WARUM DIE SEKTION MEISTENS UNSICHTBAR IST
 *
 * Sie hängt an `reviews.enabled`, und das steht auf `false`. Solange
 * keine echten Rückmeldungen vorliegen, ist jede Stimme hier erfunden --
 * eine irreführende geschäftliche Handlung nach § 5 UWG, abmahnfähig, und
 * zwar unabhängig davon, wie plausibel sie klingt.
 *
 * Die Gestaltung steht trotzdem: sobald in `site.ts` echte Stimmen in
 * `items` stehen, dort `enabled` auf true und `platzhalter` auf false --
 * und dieser Abschnitt erscheint überall von selbst.
 */
interface Props {
  class?: string;
}

const { class: className = '' }: Props = Astro.props;

const sichtbar = reviews.enabled && reviews.items.length > 0;

/** Anfangsbuchstaben, höchstens zwei. */
function kuerzel(name: string): string {
  const woerter = name.split(/\s+/).filter((w) => /\p{L}/u.test(w));
  return woerter
    .slice(0, 2)
    .map((w) => (w.match(/\p{L}/u) ?? [''])[0])
    .join('')
    .toUpperCase();
}
---

{
  sichtbar && (
    <ul class:list={['stimmen-raster', className]}>
      {reviews.items.map((stimme, i) => (
        <li
          class:list={[
            'stimme',
            /* Die erste ist die grosse. Sie traegt die ausfuehrlichste
               Rueckmeldung -- deshalb steht die laengste zuerst in
               `site.ts`. */
            i === 0 && 'stimme-gross',
            i % 2 === 0 ? 'hereinziehen-links' : 'hereinziehen',
          ]}
          style={`--verzug:${i}`}
        >
          <blockquote class="stimme-block">
            <Sterne wert={stimme.rating} groesse={0.95} />

            <p class="stimme-text">{stimme.text}</p>

            <footer class="stimme-quelle">
              <span class="stimme-kuerzel" aria-hidden="true">
                {kuerzel(stimme.author)}
              </span>
              <span class="stimme-wer">
                <cite class="stimme-name">{stimme.author}</cite>
                {stimme.business && (
                  <span class="stimme-betrieb">{stimme.business}</span>
                )}
              </span>
            </footer>
          </blockquote>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* Bento: die erste Karte nimmt zwei Spalten und zwei Zeilen. Ab Tablet,
     darunter stehen sie schlicht untereinander -- ein Bento-Raster auf
     390 Punkten Breite ist eine Spalte, also gar kein Raster. */
  .stimmen-raster {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .stimmen-raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .stimmen-raster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }

    .stimme-gross {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .stimme {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    padding: 1.4rem;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .stimme:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card);
  }

  .stimme-gross {
    padding: clamp(1.6rem, 3vw, 2.25rem);
    background: color-mix(in oklab, var(--color-accent) 4%, var(--color-surface));
    border-color: color-mix(in oklab, var(--color-accent) 18%, transparent);
  }

  /* Der Text oben, die Quelle unten am Kartenrand -- auch wenn die Texte
     verschieden lang sind. Sonst schwimmen die Namen auf unterschiedlichen
     Hoehen und das Raster wirkt schief. */
  .stimme-block {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.9rem;
    margin: 0;
    width: 100%;
  }

  .stimme-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* In der grossen Karte traegt der Text die Sektion und darf so gross
     sein wie Fliesstext. */
  .stimme-gross .stimme-text {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.62;
    color: var(--color-ink);
  }

  .stimme-quelle {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  /* An der Stelle des Profilbilds der Vorlage. Kein erfundenes Gesicht:
     zwei Buchstaben in der Markenfarbe. */
  .stimme-kuerzel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .stimme-wer {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stimme-name {
    font-size: 0.9375rem;
    font-weight: 500;
    font-style: normal;
    color: var(--color-ink);
  }

  .stimme-betrieb {
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
</style>
