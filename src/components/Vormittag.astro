---
import type { Nachricht } from '~/lib/chat';

/**
 * Ein Vormittag im Betrieb: drei Anfragen über drei Wege, alle beantwortet.
 *
 * WAS HIER VORHER STAND, UND WARUM ES WEG IST
 *
 * Ein angedeuteter Rechnerrahmen, darin ein zweispaltiger Posteingang aus
 * Liste und mitlaufendem Verlauf, darunter drei Erklärkarten, darunter eine
 * Bilanzzeile. Fünf Ebenen für eine einzige Aussage, und der Rahmen war
 * oben angedeutet und unten abgeschnitten, sah also unfertig aus statt
 * stilisiert.
 *
 * Dazu kam die Wiederholung: ein Gerät mit einem ablaufenden Verlauf steht
 * schon im ersten Sichtbereich und noch einmal auf der
 * Automatisierungsseite. Ein drittes an dieser Stelle brachte nichts Neues,
 * es kostete nur Aufmerksamkeit.
 *
 * WAS DIE STELLE WIRKLICH SAGEN MUSS: An einem einzigen Vormittag kamen
 * drei Anfragen über drei verschiedene Wege herein. Alle drei wurden
 * beantwortet. Sie waren in der Zeit bei Ihren Kunden.
 *
 * Dafür braucht es kein Gerät, dafür braucht es die Uhrzeiten. Deshalb
 * jetzt ein Zeitstrahl: drei Haltepunkte, an jedem die Uhrzeit als Anker,
 * der Weg, die echte Frage des Kunden in seinen Worten und das Ergebnis.
 *
 * Die Frage steht wörtlich da, weil sie das Menschlichste an der ganzen
 * Seite ist. „Kommt heute noch jemand??" mit zwei Fragezeichen schreibt
 * kein Marketingtext, so schreibt jemand, dessen Küche unter Wasser steht.
 */
interface Ereignis {
  /** Weg, über den die Anfrage kam. */
  kanal: string;
  /** Farbe des Haltepunkts, aus der Leistungspalette. */
  farbe: string;
  /** Pfad im 20er-Raster. */
  zeichen: string;
  zeit: string;
  /** Was daraus geworden ist. */
  text: string;
  gespraech: {
    name: string;
    status?: string;
    kuerzel?: string;
    nachrichten: Nachricht[];
  };
}

interface Props {
  ereignisse: Ereignis[];
  /** Ergebniszeile am Ende des Strahls. */
  bilanz?: string;
  class?: string;
}

const { ereignisse, bilanz, class: className = '' }: Props = Astro.props;

/* Die erste Nachricht des Kunden ist das Zitat. Sie kommt aus derselben
   Quelle wie die Verläufe, damit beides nicht auseinanderlaufen kann. */
const halte = ereignisse.map((e) => ({
  ...e,
  frage: (e.gespraech.nachrichten.find((n) => n.von === 'kunde') ?? e.gespraech.nachrichten[0])
    ?.text ?? '',
}));
---

<ol class={`lauf ${className}`}>
  {
    halte.map((h, i) => (
      <li class="halt einblenden" style={`--verzug:${i};--farbe:${h.farbe}`}>
        <span class="halt-anker" aria-hidden="true">
          <span class="halt-punkt">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round">
              <path d={h.zeichen} />
            </svg>
          </span>
        </span>

        <p class="halt-zeit ziffern">{h.zeit}</p>
        <p class="halt-kanal kennung">{h.kanal}</p>
        <blockquote class="halt-frage">{h.frage}</blockquote>
        <p class="halt-text">{h.text}</p>
      </li>
    ))
  }

  {
    bilanz && (
      <li class="bilanz einblenden" style={`--verzug:${halte.length}`}>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10.5l4 4 8-9" />
        </svg>
        {bilanz}
      </li>
    )
  }
</ol>

<style>
  /* Der Strahl ist EINE Linie durch alle Haltepunkte, gezeichnet als Rand
     der Liste. Eine Linie je Eintrag haette an jedem Uebergang eine feine
     Naht ergeben, und die sieht man. */
  /* EINE Groesse fuer beides: `--spur` ist der Abstand der Linie vom
     linken Rand, und Linie wie Haltepunkte rechnen daraus. Vorher standen
     dort zwei verschiedene clamp()-Ausdruecke, und die Punkte sassen um
     gut einen halben Zentimeter neben der Linie -- der Strahl sah aus,
     als sei er verrutscht. */
  .lauf {
    --spur: 3rem;
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
    padding: 0 0 0 var(--spur);
    list-style: none;
  }

  @media (width < 30rem) {
    .lauf {
      --spur: 2.25rem;
    }
  }

  .lauf::before {
    content: '';
    position: absolute;
    inset-block: 0.6rem 1.4rem;
    inset-inline-start: calc(var(--spur) / 2 - 1px);
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(
      to bottom,
      var(--color-border-strong),
      var(--color-border) 92%,
      transparent
    );
  }

  .halt {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'zeit kanal'
      'frage frage'
      'text text';
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
  }

  /* Sitzt auf der Linie, nicht daneben: ein Punkt, der die Linie nur
     streift, laesst den Strahl gebogen aussehen. */
  .halt-anker {
    position: absolute;
    inset-inline-start: calc(-1 * var(--spur) / 2 - 0.95rem);
    inset-block-start: -0.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--color-surface);
  }

  .halt-punkt {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--farbe) 12%, var(--color-surface));
    color: var(--farbe);
  }

  .halt-punkt svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* Die Uhrzeit ist der Anker der ganzen Stelle und deshalb das Groesste
     in der Kopfzeile. Sie traegt die Aussage: an EINEM Vormittag, zu
     diesen drei Zeiten. */
  .halt-zeit {
    grid-area: zeit;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .halt-kanal {
    grid-area: kanal;
    margin: 0;
    color: var(--farbe);
  }

  /* Woertlich, in Anfuehrungszeichen und in der Serifenschrift: das ist
     die Stimme des Kunden, nicht die des Betriebs. Der Wechsel der
     Schriftart macht den Sprecherwechsel sichtbar, ohne ihn anzusagen. */
  .halt-frage {
    grid-area: frage;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /* Die Zeichen direkt statt als Escape-Folge. `\\201E` mit doppeltem
     Backslash liest CSS als Backslash plus Text und schreibt genau das
     hin: \\201EGuten Morgen statt „Guten Morgen. */
  .halt-frage::before {
    content: '„';
  }

  .halt-frage::after {
    content: '“';
  }

  .halt-text {
    grid-area: text;
    margin: 0;
    max-width: 54ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Steht am Fuss des Strahls und schliesst ihn ab. Deshalb keine eigene
     Karte: eine Bilanz, die in einem Kasten sitzt, wirkt wie eine Werbung
     fuer sich selbst statt wie das Ergebnis dessen, was darueber steht. */
  .bilanz {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: -0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--color-success);
  }

  .bilanz svg {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  /* Ab Tablet stehen Uhrzeit und Weg nebeneinander links, der Inhalt
     rechts davon. Das gibt der Uhrzeit eine eigene Spalte und macht aus
     drei Bloecken eine ablesbare Tabelle. */
  @media (width >= 48rem) {
    /* Die Uhrzeit steht allein in der schmalen Spalte, alles andere
       rechts davon. Vorher stand der Weg unter der Uhrzeit, und
       „Kontaktformular" passte dort nicht hinein: das Wort lief quer
       ueber das Zitat daneben. */
    .halt {
      grid-template-columns: 5.5rem 1fr;
      grid-template-areas:
        'zeit kanal'
        '.    frage'
        '.    text';
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
      row-gap: 0.55rem;
    }
  }
</style>
