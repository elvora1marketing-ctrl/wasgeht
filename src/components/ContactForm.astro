---
import Button from './Button.astro';
import { forms, services, site } from '~/config/site';

/**
 * Kontaktformular über Web3Forms.
 *
 * Funktioniert VOLLSTÄNDIG ohne JavaScript: ein normales POST-Formular mit
 * Weiterleitung auf die Danke-Seite. Das Skript darunter ist nur eine
 * Verbesserung: es hält den Nutzer auf der Seite und zeigt die Rückmeldung
 * direkt im Formular.
 */
const redirectUrl = new URL(forms.redirectPath, site.url).href;

const fieldBase =
  'w-full rounded-button border border-border bg-surface px-3.5 py-2.5 text-[0.9375rem] ' +
  'text-ink placeholder:text-ink-faint transition-colors ' +
  'hover:border-border-strong focus:border-accent focus:outline-none ' +
  'focus:ring-2 focus:ring-accent/20';

const labelBase = 'block text-[0.9375rem] font-medium text-ink';
---

<form
  action={forms.endpoint}
  method="POST"
  data-contact-form
  data-webhook={forms.webhook}
  class="flex flex-col gap-5"
>
  <input type="hidden" name="access_key" value={forms.accessKey} />
  <input type="hidden" name="subject" value={forms.subject} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={redirectUrl} />

  {/* Honigtopf gegen Spam, für Menschen unsichtbar, für Bots verlockend. */}
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={labelBase} for="name">Name</label>
      <input
        class={`mt-2 ${fieldBase}`}
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Vor- und Nachname"
      />
    </div>

    <div>
      <label class={labelBase} for="betrieb">
        Betrieb <span class="font-normal text-ink-faint">(optional)</span>
      </label>
      <input
        class={`mt-2 ${fieldBase}`}
        type="text"
        id="betrieb"
        name="betrieb"
        autocomplete="organization"
        placeholder="Name Ihres Betriebs"
      />
    </div>

    <div>
      <label class={labelBase} for="email">E-Mail</label>
      <input
        class={`mt-2 ${fieldBase}`}
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="name@betrieb.de"
      />
    </div>

    <div>
      <label class={labelBase} for="telefon">
        Telefon <span class="font-normal text-ink-faint">(optional)</span>
      </label>
      <input
        class={`mt-2 ${fieldBase}`}
        type="tel"
        id="telefon"
        name="telefon"
        autocomplete="tel"
        placeholder="Für einen schnellen Rückruf"
      />
    </div>
  </div>

  <div>
    <label class={labelBase} for="anliegen">Worum geht es?</label>
    <select class={`mt-2 ${fieldBase}`} id="anliegen" name="anliegen">
      <option value="Noch unklar">Weiß ich noch nicht genau</option>
      {services.map((service) => <option value={service.label}>{service.label}</option>)}
      <option value="Etwas anderes">Etwas anderes</option>
    </select>
  </div>

  <div>
    <label class={labelBase} for="nachricht">Ihre Nachricht</label>
    <textarea
      class={`mt-2 ${fieldBase} min-h-36 resize-y`}
      id="nachricht"
      name="nachricht"
      required
      placeholder="Beschreiben Sie kurz, was bei Ihnen gerade Zeit frisst oder liegen bleibt."></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      class="mt-1 h-4.5 w-4.5 shrink-0 rounded border-border-strong text-accent focus:ring-2 focus:ring-accent/20"
      type="checkbox"
      id="einwilligung"
      name="einwilligung"
      value="ja"
      required
    />
    <label class="text-sm text-ink-muted" for="einwilligung">
      Ich bin damit einverstanden, dass meine Angaben zur Bearbeitung meiner
      Anfrage gespeichert werden. Weitere Hinweise in der{' '}
      <a
        href="/datenschutz/"
        class="text-accent underline underline-offset-2 hover:no-underline">Datenschutzerklärung</a
      >.
    </label>
  </div>

  {/* Rückmeldung des Skripts. Bleibt ohne JavaScript leer und unsichtbar. */}
  <p
    data-form-status
    role="status"
    aria-live="polite"
    class="hidden rounded-button px-4 py-3 text-[0.9375rem]"
  >
  </p>

  <div class="flex flex-col items-start gap-3">
    <Button type="submit" size="lg" magnet class="max-sm:w-full" data-form-submit>
      Anfrage senden
    </Button>
    <p class="text-sm text-ink-faint">
      Die Assistenz bestätigt sofort, persönlich melde ich mich am selben Tag.
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');
  const submit = document.querySelector<HTMLElement>('[data-form-submit]');

  if (form && status && submit) {
    const originalLabel = submit.textContent;

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.className = ok
        ? 'rounded-button bg-accent-soft px-4 py-3 text-[0.9375rem] text-accent'
        : 'rounded-button bg-surface-subtle px-4 py-3 text-[0.9375rem] text-danger';
    };

    /** Hauptweg: eigener n8n-Workflow. Meldet sofort per WhatsApp. */
    const sendeAnWebhook = async (data: FormData) => {
      const url = form.dataset.webhook;
      if (!url) return false;

      const body: Record<string, string> = {};
      data.forEach((value, key) => {
        body[key] = String(value);
      });

      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return response.ok;
    };

    /** Rückfallebene, falls der eigene Server gerade nicht erreichbar ist. */
    const sendeAnWeb3Forms = async (data: FormData) => {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      return response.ok;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      submit.textContent = 'Wird gesendet …';
      submit.setAttribute('aria-disabled', 'true');

      const data = new FormData(form);

      try {
        let zugestellt = false;

        try {
          zugestellt = await sendeAnWebhook(data);
        } catch {
          zugestellt = false;
        }

        if (!zugestellt) {
          zugestellt = await sendeAnWeb3Forms(data);
        }

        if (zugestellt) {
          form.reset();
          show(
            'Vielen Dank, Ihre Anfrage ist angekommen. Ich melde mich noch heute persönlich bei Ihnen.',
            true,
          );
        } else {
          throw new Error('Zustellung fehlgeschlagen');
        }
      } catch {
        show(
          'Das hat leider nicht geklappt. Schreiben Sie mir gern direkt auf WhatsApp oder rufen Sie an, dann geht es sofort weiter.',
          false,
        );
      } finally {
        submit.textContent = originalLabel;
        submit.removeAttribute('aria-disabled');
      }
    });
  }
</script>
