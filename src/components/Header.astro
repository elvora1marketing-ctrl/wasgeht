---
import Logo from './Logo.astro';
import ShimmerCta from './ShimmerCta.astro';
import { nav, cta, contact, contactLinks } from '~/config/site';

/**
 * Kopfbereich.
 *
 * Klebt oben -- damit bleibt der Haupt-CTA auf dem Handy beim Scrollen
 * jederzeit erreichbar. Das mobile Menue laeuft ueber <details>, also ganz
 * ohne JavaScript.
 *
 * FARBE: Jede Seite beginnt mit einer farbigen Tafel. Stand die Leiste in
 * Weiss darueber, fing die Seite mit einem Streifen an statt mit einem
 * Eindruck. Sie uebernimmt deshalb die Farbe der jeweiligen Tafel und laeuft
 * nahtlos in sie hinein.
 *
 * ABSETZEN BEIM SCROLLEN: geht inzwischen ohne Beobachter. Solange die
 * Seite ganz oben steht, liegt die Leiste flach auf der Kopftafel; sobald
 * man zu lesen anfaengt, hebt sie sich mit einem weichen Schatten ab und
 * die Navigationsinsel zieht sich leicht zusammen. Getrieben von
 * `animation-timeline: scroll()`, also von der Scrollposition selbst --
 * kein Beobachter, kein Skript, kein Nachrechnen bei jedem Scrollschritt.
 */
interface Props {
  /** Farbe der Kopftafel dieser Seite. Ohne Angabe bleibt die Leiste weiss. */
  kopfFarbe?: string;
}

const { kopfFarbe }: Props = Astro.props;
const dunkel = Boolean(kopfFarbe);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);

/* Welcher Eintrag gerade dran ist. Die Pille steht darauf und wandert beim
   Zeigen zum jeweils anderen. Ist keiner dran, etwa auf der Startseite,
   bleibt sie unsichtbar, bis jemand hinzeigt. */
const hier = nav.findIndex((item) => isActive(item.href));
---

<header
  class="kopf sticky top-0 z-50 border-b"
  data-ton={dunkel ? 'dunkel' : 'hell'}
  style={kopfFarbe ? `--kopf-grund:${kopfFarbe}` : undefined}
>
  <div class="container-content">
    <div class="flex h-16 items-center justify-between gap-4 md:h-18">
      <a href="/" class="flex shrink-0 items-center min-h-11" aria-label="Elvora, zur Startseite">
        <Logo ton={dunkel ? 'hell' : 'dunkel'} />
      </a>

      {/*
        Die Pille zeigt, wo man ist, und wandert beim Zeigen zum jeweils
        anderen Eintrag. Ohne JavaScript: die Spalten sind gleich breit, die
        Pille ist eine Spalte breit und wird um ihre Nummer verschoben.
        Welche Nummer gilt, entscheidet `:has()` im Stylesheet.

        Deshalb steht die Nummer NICHT als Stilangabe am Element: eine
        Stilangabe am Element schlaegt jede Regel im Stylesheet, und die
        Pille kaeme beim Zeigen nicht von der Stelle.
      */}
      <nav
        aria-label="Hauptnavigation"
        class="kopf-nav hidden md:block"
        data-hier={hier >= 0 ? String(hier) : undefined}
      >
        <span class="kopf-insel" aria-hidden="true"></span>
        <span class="kopf-pille" aria-hidden="true"></span>
        <span class="kopf-kerbe" aria-hidden="true"></span>

        <ul class="kopf-liste">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'kopf-link text-[0.9375rem] transition-colors',
                    isActive(item.href) && 'ist-hier font-medium',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Der eine Haupt-CTA. Auf farbiger Leiste weiss: die Akzentfarbe
             geht auf der Magenta-Tafel sonst unter.

             NUR AB TABLET. Auf dem Telefon stand er hier oben rechts, an
             der Stelle, die der Daumen am schlechtesten erreicht -- und
             bei 320 Punkten Breite passte er nicht mehr neben Logo und
             Menue: die Kopfleiste lief waagerecht ueber und die ganze
             Seite liess sich seitlich schieben. Auf dem Telefon steht der
             Aufruf jetzt unten in der `Handyleiste`. -->
        <ShimmerCta
          href={cta.primary.href}
          ton={dunkel ? 'hell' : 'marke'}
          size="md"
          class="kopf-cta max-md:hidden"
        >
          {cta.primary.label}
        </ShimmerCta>

        <!-- Mobiles Menue ohne JavaScript -->
        <details class="group relative md:hidden">
          <summary
            class="kopf-knopf flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-button border transition-colors [&::-webkit-details-marker]:hidden"
            aria-label="Menü öffnen"
          >
            <svg
              viewBox="0 0 20 20"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
              <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
            </svg>
          </summary>

          <div
            class="absolute right-0 top-[calc(100%+0.5rem)] w-64 rounded-card border border-border bg-surface p-2 shadow-raised"
          >
            <ul class="flex flex-col">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-2.5 text-[0.9375rem] transition-colors hover:bg-surface-subtle',
                        isActive(item.href) ? 'text-ink font-medium' : 'text-ink-muted',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>

            {/*
              Anrufen und Schreiben gehoeren hierher. Wer auf dem Handy das
              Menue oeffnet, sucht meistens genau das, und hat bis hierhin
              sonst nur drei Seitennamen gefunden.
            */}
            <div class="mt-2 border-t border-border pt-2">
              <a
                href={contactLinks.tel}
                class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[0.9375rem] text-ink transition-colors hover:bg-surface-subtle"
              >
                <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-ink-faint" fill="none"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z" />
                </svg>
                {contact.phoneDisplay}
              </a>

              <a
                href={contactLinks.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[0.9375rem] text-ink transition-colors hover:bg-surface-subtle"
              >
                <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-ink-faint" fill="none"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 17l1.3-3.4A7 7 0 1 1 6.6 16z" />
                </svg>
                Auf WhatsApp schreiben
              </a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>

  {/* Fuellt sich, waehrend man die Seite hinunterliest. Steht als letztes
      Kind der Kopfleiste, damit es auf der Trennlinie sitzt. */}
  <span class="kopf-fortschritt" aria-hidden="true"></span>
</header>

<style>
  /* --- Fortschritt beim Scrollen ------------------------------------------
   * Ein Strich an der Unterkante der Kopfleiste, der sich fuellt, waehrend
   * man die Seite hinunterliest.
   *
   * Auf einer Seite, die auf dem Telefon acht Bildschirme lang ist, ist
   * das keine Spielerei: man sieht, wie viel noch kommt, und scrollt eher
   * weiter, weil man weiss, dass es ein Ende hat. Ein Fortschrittsbalken
   * ist die aelteste Antwort auf die Frage „lohnt sich das noch".
   *
   * `animation-timeline: scroll()` bindet ihn an den Scrollfortschritt des
   * Dokuments -- kein Beobachter, kein Skript, kein Nachrechnen bei jedem
   * Scrollschritt. `scaleX` statt `width`, damit es im Compositor laeuft.
   *
   * KEINE KURZSCHREIBWEISE `animation:`. Der Verdichter zieht sie sonst
   * mit `animation-timeline` zusammen zu einer Zeile, die kein Browser
   * kennt -- und dann faellt der Balken ersatzlos aus. Genau das ist auf
   * dieser Seite schon einmal wochenlang unbemerkt passiert. */
  .kopf-fortschritt {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    transform-origin: left;
    background: linear-gradient(
      to right,
      var(--color-brand-start, #5c67db),
      var(--color-brand-mid, #b23a94),
      var(--color-brand-end, #f45e3d)
    );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .kopf-fortschritt {
        animation-name: fortschritt-fuellen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll();
      }
    }
  }

  /* Ohne Unterstuetzung bleibt der Strich unsichtbar, statt als voller
     Balken dauerhaft dazustehen. */
  @supports not (animation-timeline: scroll()) {
    .kopf-fortschritt {
      display: none;
    }
  }

  @keyframes fortschritt-fuellen {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }


  .kopf {
    /* Bezugsrahmen fuer den Fortschrittsbalken an der Unterkante. */
    position: sticky;
    background: var(--kopf-grund, var(--color-surface));
    border-bottom-color: var(--color-border);
  }

  /* --- Navigation als Insel mit Kerbe -----------------------------------
   *
   * Nach der Vorlage („adaptive notch navigation bar"). Uebernommen ist
   * das Aussehen, nicht der Aufbau: die Vorlage legt die ganze Seite in
   * einen `fixed`-Rahmen mit eigenem Scrollbereich und misst mit
   * framer-motion. Das wuerde hier das native Scrollen ersetzen -- und
   * damit alle Scroll-Animationen und die Daumenleiste am unteren Rand.
   *
   * Stattdessen: die Leiste bleibt, was sie ist, und die Navigation wird
   * zur Insel. Der Eintrag, auf dem man steht, sitzt in einer Kerbe --
   * einer runden Ausbuchtung an der Unterkante, aus der ein Punkt in den
   * Markenfarben herausschaut. Beim Zeigen wandert beides zum jeweils
   * anderen Eintrag.
   *
   * `--i` IST DEUTLICH MEHR ALS EINE ZAHL. Ueber `@property` ist sie als
   * `<number>` angemeldet, und erst dadurch laesst sie sich ueberblenden:
   * Pille, Kerbe und Punkt haengen alle an derselben Zahl und wandern
   * deshalb zwangslaeufig im Gleichschritt. Ohne die Anmeldung springt
   * eine Custom Property hart von einem Wert zum naechsten, und die Kerbe
   * waere im Ziel, waehrend die Pille noch unterwegs ist. */
  @property --i {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .kopf-nav {
    position: relative;
    isolation: isolate;
    --i: 0;
    /* Mitte des aktuellen Eintrags, gemessen an der Inselbreite. Drei
       gleich breite Spalten, also liegt Eintrag i bei (i + 0.5)/3. */
    --kerbe-x: calc((var(--i) + 0.5) * 100% / 3);
    transition: --i 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* DREI SCHICHTEN, KEINE NEGATIVEN STAPELNUMMERN. Die Insel traegt nur
     Flaeche und Rand, darueber liegt die Pille, darueber der Punkt,
     darueber die Schrift. Vorher lag die Pille auf `z-index: -1` hinter
     dem Text -- das funktioniert nur, solange der Elternteil keine eigene
     Zeichenebene aufmacht. Eine Maske macht genau das, und die Pille waere
     verschwunden. Derselbe Fehler steckte schon einmal in der
     Daumenleiste. */
  .kopf-insel,
  .kopf-pille {
    position: absolute;
    inset-block: 0;
    border-radius: 999px;
  }

  .kopf-insel {
    inset-inline: 0;
    z-index: 0;
    /* Deutlich getoent, nicht `--color-surface-subtle`. Der unterscheidet
       sich vom Weiss der Leiste um zwei Prozent -- die Delle liegt dann
       zwar da, aber sie zeigt nahezu dieselbe Farbe wie ihre Umgebung und
       ist schlicht nicht zu sehen. */
    background: color-mix(in oklab, var(--color-ink) 5%, var(--color-surface));
    box-shadow: inset 0 0 0 1px var(--color-border);

    /* DIE KERBE IST EIN LOCH IN DER INSEL, KEIN AUFGESETZTER BOGEN.
       Der Kreis sitzt genau auf der Unterkante, sichtbar ist also seine
       obere Haelfte -- eine Delle, durch die die Farbe der Kopfleiste
       durchscheint. Ein aufgesetzter Bogen muesste dieselbe Farbe treffen
       und waere auf jeder Seite mit einer anderen Kopftafel falsch. */
    mask-image: radial-gradient(
      circle 0.6rem at var(--kerbe-x) 100%,
      transparent 0 0.6rem,
      #000 calc(0.6rem + 0.5px)
    );
    /* ZIEHT DIE KANTE DER DELLE NACH. Der Innenschatten oben zeichnet den
       Rand der Insel -- aber die Maske schneidet ihn an der Delle weg,
       und die Delle stuende ohne Kontur da. `drop-shadow` arbeitet nach
       der Maske und folgt deren Umriss, also auch der Ausbuchtung. */
    filter: drop-shadow(0 1px 0 var(--color-border-strong));
  }

  /* Die Pille steht immer genau ueber der Kerbe, also sitzt deren Loch bei
     ihr fest in der Mitte. Ohne diese zweite Maske deckt die Pille die
     Delle an genau der Stelle zu, an der sie zu sehen sein soll. */
  .kopf-pille {
    mask-image: radial-gradient(
      circle 0.6rem at 50% 100%,
      transparent 0 0.6rem,
      #000 calc(0.6rem + 0.5px)
    );
    filter: drop-shadow(0 1px 0 var(--color-border-strong));
  }

  /* Ohne aktive Seite (Startseite) gibt es nichts zu kerben, solange
     niemand hinzeigt. */
  .kopf-nav:not([data-hier]):not(:hover) .kopf-insel {
    mask-image: none;
  }

  /* Gleich breite Spalten. Nur so kann die Pille um genau eine Spaltenbreite
     je Eintrag verschoben werden, ohne dass jemand Breiten misst. Die
     Schrift steht ueber allen drei Schichten. */
  .kopf-liste {
    position: relative;
    z-index: 3;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }

  .kopf-link {
    display: block;
    padding: 0.45rem 1.1rem;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink-muted);
  }

  .kopf-link:hover,
  .kopf-link.ist-hier {
    color: var(--color-ink);
  }

  /* Die Pille liegt IN der Insel und ist heller als sie -- der Eintrag,
     auf dem man steht, wirkt dadurch angehoben statt eingefaerbt. */
  .kopf-pille {
    inset-inline-start: 0;
    z-index: 1;
    width: calc(100% / 3);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      0 1px 2px rgb(16 18 24 / 0.06);
    opacity: 0;
    transform: translateX(calc(var(--i) * 100%));
    transition: opacity 0.2s;
  }

  /* Der Punkt sitzt MIT SEINER MITTE AUF DER UNTERKANTE: obere Haelfte in
     der Delle, untere Haelfte darunter im Freien. Genau daraus wird die
     Kerbe ueberhaupt erst sichtbar -- eine Delle allein zeigt nur weiss
     auf weiss und ist auf heller Leiste schlicht nicht zu erkennen. Der
     erste Entwurf hatte einen 0,4rem-Punkt tief im Loch: technisch
     richtig, praktisch unsichtbar.

     Der weisse Ring haelt ihn frei von der Inselflaeche, auch dort, wo die
     Rundung der Delle nicht auf den Punkt passt. */
  .kopf-kerbe {
    position: absolute;
    z-index: 2;
    bottom: -0.3rem;
    inset-inline-start: var(--kerbe-x);
    width: 0.7rem;
    height: 0.7rem;
    translate: -50% 0;
    border-radius: 999px;
    box-shadow: 0 0 0 2.5px var(--kopf-grund, var(--color-surface));
    background: linear-gradient(
      to right,
      var(--color-brand-start, #5c67db),
      var(--color-brand-end, #f45e3d)
    );
    opacity: 0;
    transition: opacity 0.2s;
  }

  .kopf-nav[data-hier] .kopf-pille,
  .kopf-nav:hover .kopf-pille,
  .kopf-nav[data-hier] .kopf-kerbe,
  .kopf-nav:hover .kopf-kerbe {
    opacity: 1;
  }

  /* Wo die Pille steht. Erst die Seite, auf der man ist, danach das
     Zeigen: die `:has()`-Regeln stehen spaeter und sind spezifischer,
     also gewinnen sie, solange der Zeiger auf einem Eintrag liegt. */
  .kopf-nav[data-hier='0'] { --i: 0; }
  .kopf-nav[data-hier='1'] { --i: 1; }
  .kopf-nav[data-hier='2'] { --i: 2; }

  .kopf-nav:has(li:nth-child(1) a:hover) { --i: 0; }
  .kopf-nav:has(li:nth-child(2) a:hover) { --i: 1; }
  .kopf-nav:has(li:nth-child(3) a:hover) { --i: 2; }

  /* Ohne `:has()` faellt nur das Wandern weg, die Pille steht dann fest auf
     der aktuellen Seite. Das ist die Aussage, auf die es ankommt. */
  @media (prefers-reduced-motion: reduce) {
    .kopf-nav,
    .kopf-pille,
    .kopf-kerbe {
      transition: none;
    }
  }

  /* Ohne Maskenunterstuetzung faellt nur die Delle weg. Insel, Pille und
     Punkt stehen weiter -- die Aussage „hier sind Sie" bleibt. */
  @supports not (mask-image: radial-gradient(circle, #000, #000)) {
    .kopf-kerbe {
      bottom: -0.2rem;
    }
  }

  .kopf-knopf {
    border-color: var(--color-border);
    color: var(--color-ink-muted);
  }

  .kopf-knopf:hover {
    color: var(--color-ink);
  }

  /* --- Auf farbiger Tafel ---------------------------------------------
     Kein Weichzeichner im Hintergrund: die Leiste steht auf einer
     deckenden Flaeche derselben Farbe, da gaebe es nichts zu zeichnen,
     und `backdrop-filter` kostet auf schwachen Geraeten spuerbar Leistung. */
  .kopf[data-ton='dunkel'] {
    border-bottom-color: rgb(255 255 255 / 0.14);
  }

  .kopf[data-ton='dunkel'] .kopf-link {
    color: rgb(255 255 255 / 0.72);
  }

  .kopf[data-ton='dunkel'] .kopf-link:hover,
  .kopf[data-ton='dunkel'] .kopf-link.ist-hier {
    color: #fff;
  }

  .kopf[data-ton='dunkel'] .kopf-insel {
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.22));
  }

  .kopf[data-ton='dunkel'] .kopf-pille {
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.28));
  }

  .kopf[data-ton='dunkel'] .kopf-pille {
    background: rgb(255 255 255 / 0.2);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.24);
  }

  /* Auf farbiger Tafel traegt der Punkt keine Markenfarben: die Tafel IST
     schon in Markenfarbe, ein Farbverlauf darauf ergaebe Matsch. */
  .kopf[data-ton='dunkel'] .kopf-kerbe {
    background: #fff;
  }

  /* Der Ring nimmt die Farbe der Kopftafel an -- er soll den Punkt
     freistellen, nicht als weisser Kringel danebenstehen. */
  .kopf[data-ton='dunkel'] .kopf-kerbe {
    box-shadow: 0 0 0 2.5px var(--kopf-grund);
  }

  .kopf[data-ton='dunkel'] .kopf-knopf {
    border-color: rgb(255 255 255 / 0.28);
    color: rgb(255 255 255 / 0.8);
  }

  .kopf[data-ton='dunkel'] .kopf-knopf:hover {
    color: #fff;
  }

  /* --- Adaptiv: die Leiste setzt sich ab, sobald man liest -------------
   *
   * KEINE KURZSCHREIBWEISE `animation:`, dieselbe Regel wie beim
   * Fortschrittsbalken zwei Bloecke weiter oben: der Verdichter zieht sie
   * sonst mit `animation-timeline` zu einer Zeile zusammen, die kein
   * Browser kennt, und der Effekt faellt still aus.
   *
   * ES WIRD NICHTS ANIMIERT, WAS EINEN UMBRUCH AUSLOEST. Die Hoehe der
   * Leiste bleibt, wie sie ist -- sie klebt im Fluss, jede Hoehenaenderung
   * waere ein Neuumbruch des ganzen Dokuments bei jedem Scrollschritt.
   * Bewegt werden nur Schatten und eine Skalierung, beides Sache des
   * Compositors. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .kopf {
        animation-name: kopf-absetzen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll();
        animation-range: 0 9rem;
      }

      .kopf-nav {
        animation-name: insel-zusammenziehen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll();
        animation-range: 0 9rem;
      }
    }
  }

  @keyframes kopf-absetzen {
    from { box-shadow: 0 0 0 0 rgb(16 18 24 / 0); }
    to { box-shadow: 0 6px 20px -12px rgb(16 18 24 / 0.5); }
  }

  @keyframes insel-zusammenziehen {
    from { transform: scale(1); }
    to { transform: scale(0.94); }
  }

  /* Die aufgeklappte Liste bleibt hell: dort steht Text auf Weiss, und ein
     zweites Farbschema fuer ein Menue mit drei Eintraegen waere Aufwand
     ohne Gewinn. */
  .kopf[data-ton='hell'] {
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(4px);
  }
</style>
