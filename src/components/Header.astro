---
import Logo from './Logo.astro';
import ShimmerCta from './ShimmerCta.astro';
import { nav, cta, contact, contactLinks } from '~/config/site';

/**
 * Kopfbereich.
 *
 * Klebt oben -- damit bleibt der Haupt-CTA auf dem Handy beim Scrollen
 * jederzeit erreichbar. Das mobile Menue laeuft ueber <details>, also ganz
 * ohne JavaScript.
 *
 * FARBE: Jede Seite beginnt mit einer farbigen Tafel. Stand die Leiste in
 * Weiss darueber, fing die Seite mit einem Streifen an statt mit einem
 * Eindruck. Sie uebernimmt deshalb die Farbe der jeweiligen Tafel und laeuft
 * nahtlos in sie hinein.
 *
 * Bewusst ohne Umschlagen auf Weiss beim Weiterscrollen: das ginge nur mit
 * einem Scroll-Beobachter, und dafuer lohnt kein Skript.
 */
interface Props {
  /** Farbe der Kopftafel dieser Seite. Ohne Angabe bleibt die Leiste weiss. */
  kopfFarbe?: string;
}

const { kopfFarbe }: Props = Astro.props;
const dunkel = Boolean(kopfFarbe);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);

/* Welcher Eintrag gerade dran ist. Die Pille steht darauf und wandert beim
   Zeigen zum jeweils anderen. Ist keiner dran, etwa auf der Startseite,
   bleibt sie unsichtbar, bis jemand hinzeigt. */
const hier = nav.findIndex((item) => isActive(item.href));
---

<header
  class="kopf sticky top-0 z-50 border-b"
  data-ton={dunkel ? 'dunkel' : 'hell'}
  style={kopfFarbe ? `--kopf-grund:${kopfFarbe}` : undefined}
>
  <div class="container-content">
    <div class="flex h-16 items-center justify-between gap-4 md:h-18">
      <a href="/" class="flex shrink-0 items-center min-h-11" aria-label="Elvora, zur Startseite">
        <Logo ton={dunkel ? 'hell' : 'dunkel'} />
      </a>

      {/*
        Die Pille zeigt, wo man ist, und wandert beim Zeigen zum jeweils
        anderen Eintrag. Ohne JavaScript: die Spalten sind gleich breit, die
        Pille ist eine Spalte breit und wird um ihre Nummer verschoben.
        Welche Nummer gilt, entscheidet `:has()` im Stylesheet.

        Deshalb steht die Nummer NICHT als Stilangabe am Element: eine
        Stilangabe am Element schlaegt jede Regel im Stylesheet, und die
        Pille kaeme beim Zeigen nicht von der Stelle.
      */}
      <nav
        aria-label="Hauptnavigation"
        class="kopf-nav hidden md:block"
        data-hier={hier >= 0 ? String(hier) : undefined}
      >
        <span class="kopf-pille" aria-hidden="true"></span>

        <ul class="kopf-liste">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'kopf-link text-[0.9375rem] transition-colors',
                    isActive(item.href) && 'ist-hier font-medium',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Der eine Haupt-CTA. Auf farbiger Leiste weiss: die Akzentfarbe
             geht auf der Magenta-Tafel sonst unter.

             NUR AB TABLET. Auf dem Telefon stand er hier oben rechts, an
             der Stelle, die der Daumen am schlechtesten erreicht -- und
             bei 320 Punkten Breite passte er nicht mehr neben Logo und
             Menue: die Kopfleiste lief waagerecht ueber und die ganze
             Seite liess sich seitlich schieben. Auf dem Telefon steht der
             Aufruf jetzt unten in der `Handyleiste`. -->
        <ShimmerCta
          href={cta.primary.href}
          ton={dunkel ? 'hell' : 'marke'}
          size="md"
          class="kopf-cta max-md:hidden"
        >
          {cta.primary.label}
        </ShimmerCta>

        <!-- Mobiles Menue ohne JavaScript -->
        <details class="group relative md:hidden">
          <summary
            class="kopf-knopf flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-button border transition-colors [&::-webkit-details-marker]:hidden"
            aria-label="Menü öffnen"
          >
            <svg
              viewBox="0 0 20 20"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
              <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
            </svg>
          </summary>

          <div
            class="absolute right-0 top-[calc(100%+0.5rem)] w-64 rounded-card border border-border bg-surface p-2 shadow-raised"
          >
            <ul class="flex flex-col">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-2.5 text-[0.9375rem] transition-colors hover:bg-surface-subtle',
                        isActive(item.href) ? 'text-ink font-medium' : 'text-ink-muted',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>

            {/*
              Anrufen und Schreiben gehoeren hierher. Wer auf dem Handy das
              Menue oeffnet, sucht meistens genau das, und hat bis hierhin
              sonst nur drei Seitennamen gefunden.
            */}
            <div class="mt-2 border-t border-border pt-2">
              <a
                href={contactLinks.tel}
                class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[0.9375rem] text-ink transition-colors hover:bg-surface-subtle"
              >
                <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-ink-faint" fill="none"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z" />
                </svg>
                {contact.phoneDisplay}
              </a>

              <a
                href={contactLinks.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-[0.9375rem] text-ink transition-colors hover:bg-surface-subtle"
              >
                <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-ink-faint" fill="none"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 17l1.3-3.4A7 7 0 1 1 6.6 16z" />
                </svg>
                Auf WhatsApp schreiben
              </a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>

  {/* Fuellt sich, waehrend man die Seite hinunterliest. Steht als letztes
      Kind der Kopfleiste, damit es auf der Trennlinie sitzt. */}
  <span class="kopf-fortschritt" aria-hidden="true"></span>
</header>

<style>
  /* --- Fortschritt beim Scrollen ------------------------------------------
   * Ein Strich an der Unterkante der Kopfleiste, der sich fuellt, waehrend
   * man die Seite hinunterliest.
   *
   * Auf einer Seite, die auf dem Telefon acht Bildschirme lang ist, ist
   * das keine Spielerei: man sieht, wie viel noch kommt, und scrollt eher
   * weiter, weil man weiss, dass es ein Ende hat. Ein Fortschrittsbalken
   * ist die aelteste Antwort auf die Frage „lohnt sich das noch".
   *
   * `animation-timeline: scroll()` bindet ihn an den Scrollfortschritt des
   * Dokuments -- kein Beobachter, kein Skript, kein Nachrechnen bei jedem
   * Scrollschritt. `scaleX` statt `width`, damit es im Compositor laeuft.
   *
   * KEINE KURZSCHREIBWEISE `animation:`. Der Verdichter zieht sie sonst
   * mit `animation-timeline` zusammen zu einer Zeile, die kein Browser
   * kennt -- und dann faellt der Balken ersatzlos aus. Genau das ist auf
   * dieser Seite schon einmal wochenlang unbemerkt passiert. */
  .kopf-fortschritt {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    transform-origin: left;
    background: linear-gradient(
      to right,
      var(--color-brand-start, #5c67db),
      var(--color-brand-mid, #b23a94),
      var(--color-brand-end, #f45e3d)
    );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .kopf-fortschritt {
        animation-name: fortschritt-fuellen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll();
      }
    }
  }

  /* Ohne Unterstuetzung bleibt der Strich unsichtbar, statt als voller
     Balken dauerhaft dazustehen. */
  @supports not (animation-timeline: scroll()) {
    .kopf-fortschritt {
      display: none;
    }
  }

  @keyframes fortschritt-fuellen {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }


  .kopf {
    /* Bezugsrahmen fuer den Fortschrittsbalken an der Unterkante. */
    position: sticky;
    background: var(--kopf-grund, var(--color-surface));
    border-bottom-color: var(--color-border);
  }

  /* --- Navigation als Pillen ------------------------------------------- */
  .kopf-nav {
    position: relative;
    --i: 0;
  }

  /* Gleich breite Spalten. Nur so kann die Pille um genau eine Spaltenbreite
     je Eintrag verschoben werden, ohne dass jemand Breiten misst. */
  .kopf-liste {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }

  .kopf-link {
    display: block;
    padding: 0.45rem 1.1rem;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink-muted);
  }

  .kopf-link:hover,
  .kopf-link.ist-hier {
    color: var(--color-ink);
  }

  .kopf-pille {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: -1;
    width: calc(100% / 3);
    border-radius: 999px;
    background: var(--color-surface-subtle);
    box-shadow: inset 0 0 0 1px var(--color-border);
    opacity: 0;
    transform: translateX(calc(var(--i) * 100%));
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s;
  }

  .kopf-nav[data-hier] .kopf-pille,
  .kopf-nav:hover .kopf-pille {
    opacity: 1;
  }

  /* Wo die Pille steht. Erst die Seite, auf der man ist, danach das
     Zeigen: die `:has()`-Regeln stehen spaeter und sind spezifischer,
     also gewinnen sie, solange der Zeiger auf einem Eintrag liegt. */
  .kopf-nav[data-hier='0'] { --i: 0; }
  .kopf-nav[data-hier='1'] { --i: 1; }
  .kopf-nav[data-hier='2'] { --i: 2; }

  .kopf-nav:has(li:nth-child(1) a:hover) { --i: 0; }
  .kopf-nav:has(li:nth-child(2) a:hover) { --i: 1; }
  .kopf-nav:has(li:nth-child(3) a:hover) { --i: 2; }

  /* Ohne `:has()` faellt nur das Wandern weg, die Pille steht dann fest auf
     der aktuellen Seite. Das ist die Aussage, auf die es ankommt. */
  @media (prefers-reduced-motion: reduce) {
    .kopf-pille {
      transition: none;
    }
  }

  .kopf-knopf {
    border-color: var(--color-border);
    color: var(--color-ink-muted);
  }

  .kopf-knopf:hover {
    color: var(--color-ink);
  }

  /* --- Auf farbiger Tafel ---------------------------------------------
     Kein Weichzeichner im Hintergrund: die Leiste steht auf einer
     deckenden Flaeche derselben Farbe, da gaebe es nichts zu zeichnen,
     und `backdrop-filter` kostet auf schwachen Geraeten spuerbar Leistung. */
  .kopf[data-ton='dunkel'] {
    border-bottom-color: rgb(255 255 255 / 0.14);
  }

  .kopf[data-ton='dunkel'] .kopf-link {
    color: rgb(255 255 255 / 0.72);
  }

  .kopf[data-ton='dunkel'] .kopf-link:hover,
  .kopf[data-ton='dunkel'] .kopf-link.ist-hier {
    color: #fff;
  }

  .kopf[data-ton='dunkel'] .kopf-pille {
    background: rgb(255 255 255 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
  }

  .kopf[data-ton='dunkel'] .kopf-knopf {
    border-color: rgb(255 255 255 / 0.28);
    color: rgb(255 255 255 / 0.8);
  }

  .kopf[data-ton='dunkel'] .kopf-knopf:hover {
    color: #fff;
  }

  /* Die aufgeklappte Liste bleibt hell: dort steht Text auf Weiss, und ein
     zweites Farbschema fuer ein Menue mit drei Eintraegen waere Aufwand
     ohne Gewinn. */
  .kopf[data-ton='hell'] {
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(4px);
  }
</style>
