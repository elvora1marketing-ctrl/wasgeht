---
/**
 * Redaktionelle Aufzählung.
 *
 * Ersetzt das Muster `rounded-card border border-border bg-surface p-7`, das
 * bisher auf vier Seiten stand und dafür sorgte, dass jede helle Fläche wie
 * ein Baukasten aussah: gleich große Kästen mit Rahmen, Rundung und Schatten,
 * nebeneinander im Raster.
 *
 * Stattdessen: Mono-Ziffer, Haarlinie, Zwischenüberschrift, Fließtext. Kein
 * Kasten. Dieselbe Bildsprache wie die Kapitelflächen, nur auf hellem Grund.
 *
 * Drei Anordnungen:
 *   `spalten`  nebeneinander, durch senkrechte Haarlinien getrennt
 *   `reihen`   untereinander, durch waagerechte Haarlinien getrennt
 *   `raster`   zweispaltig, für längere Texte
 */
interface Props {
  eintraege: Array<{ titel: string; text: string }>;
  anordnung?: 'spalten' | 'reihen' | 'raster';
  /**
   * Ziffern anzeigen.
   *
   * Ohne Angabe richtet sich das nach `geordnet`, und das ist der Punkt:
   * vorher stand hier `true` als fester Vorgabewert, und dadurch trug JEDE
   * Liste die Ziffern 01, 02, 03 -- auch die, in denen es gar keine
   * Reihenfolge gibt. Eine Nummer, die nichts nummeriert, ist Dekoration
   * und behauptet obendrein einen Ablauf, den es nicht gibt.
   *
   * Auf den Leistungsseiten steht unter „So läuft es ab" ein echter
   * Ablauf; dort sind die Ziffern eine Information und bleiben.
   */
  ziffern?: boolean;
  /** Bei `true` wird ein `<ol>` ausgegeben, sonst ein `<ul>`. */
  geordnet?: boolean;
  class?: string;
}

const {
  eintraege,
  anordnung = 'spalten',
  geordnet = false,
  ziffern = geordnet,
  class: className = '',
}: Props = Astro.props;

const Tag = geordnet ? 'ol' : 'ul';
---

{/*
  Die Huelle stellt den Abfragebereich, die Liste selbst wird abgefragt.
  Beides in einem Element geht NICHT: eine Container-Abfrage kann nur
  Nachfahren gestalten, nie das Element, dessen Breite sie misst. Genau
  daran ist die Spaltenaufteilung zuerst gescheitert.
*/}
<div class:list={['liste-huelle', className]}>
<Tag class:list={['liste', `liste-${anordnung}`]}>
  {
    eintraege.map((eintrag, i) => (
      <li class="liste-eintrag" style={`--rang:${i}`}>
        {ziffern && (
          <span class="liste-ziffer ziffern" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <h3 class="liste-titel">{eintrag.titel}</h3>
        <p class="liste-text">{eintrag.text}</p>
      </li>
    ))
  }
</Tag>
</div>

<style>
  /* Die Liste richtet sich nach IHRER Breite, nicht nach der des Fensters.
     Ohne das griffe die dreispaltige Anordnung auch dann, wenn die Liste in
     einer schmalen Seitenspalte steht -- der Text bricht dann Wort fuer Wort
     um. Genau das ist passiert. */
  .liste-huelle {
    container-type: inline-size;
  }

  .liste {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .liste-eintrag {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .liste-ziffer {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .liste-titel {
    margin: 0;
    /* Erbt die Farbe der Flaeche. Die Grundregel setzt h3 auf Anthrazit,
       was auf farbigem Grund untergeht. */
    color: inherit;
    font-size: 1.0625rem;
  }

  .liste-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.75;
  }

  /* --- Nebeneinander, mit senkrechten Haarlinien ------------------------ */
  .liste-spalten {
    gap: clamp(2rem, 4vw, 3rem);
  }

  @container (width >= 40rem) {
    .liste-spalten {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: clamp(2rem, 3.5vw, 3.5rem);
    }

    /* Die Linie steht zwischen den Spalten, nicht um sie herum. Ein Rahmen
       waere wieder ein Kasten. */
    .liste-spalten .liste-eintrag {
      padding-inline-start: clamp(1.25rem, 2vw, 2rem);
      border-inline-start: 1px solid currentColor;
      border-color: color-mix(in srgb, currentColor 18%, transparent);
    }

    .liste-spalten .liste-eintrag:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  /* Auf schmalen Geraeten waagerecht getrennt, senkrechte Linien haetten
     dort nichts zu trennen. */
  @container (width < 40rem) {
    .liste-spalten .liste-eintrag + .liste-eintrag {
      padding-block-start: clamp(1.5rem, 4vw, 2rem);
      border-block-start: 1px solid currentColor;
      border-color: color-mix(in srgb, currentColor 18%, transparent);
    }
  }

  /* --- Untereinander ---------------------------------------------------- */
  .liste-reihen .liste-eintrag {
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-block-start: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  .liste-reihen .liste-eintrag:last-child {
    border-block-end: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  @container (width >= 44rem) {
    /* Ziffer und Titel links, Text rechts: gibt der Reihe eine Achse. */
    .liste-reihen .liste-eintrag {
      display: grid;
      grid-template-columns: 3rem minmax(0, 16rem) minmax(0, 1.4fr);
      align-items: baseline;
      gap: clamp(1rem, 2.5vw, 2.5rem);
    }

    .liste-reihen .liste-ziffer {
      grid-column: 1;
    }

    .liste-reihen .liste-eintrag:has(.liste-ziffer) .liste-titel {
      grid-column: 2;
    }

    .liste-reihen .liste-eintrag:not(:has(.liste-ziffer)) .liste-titel {
      grid-column: 1 / 3;
    }

    .liste-reihen .liste-text {
      grid-column: 3;
    }
  }

  /* --- Zweispaltig ------------------------------------------------------ */
  .liste-raster {
    gap: clamp(2rem, 4vw, 3rem);
  }

  @container (width >= 40rem) {
    .liste-raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  /* --- Bewegung, gestaffelt --------------------------------------------
     Ueber `animation-range`, nicht ueber `animation-delay`: bei einer
     scrollgebundenen Zeitachse gibt es keine Uhr, auf die eine Verzoegerung
     sich beziehen koennte. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .liste-eintrag {
        animation-name: auftauchen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry calc(10% + var(--rang) * 5%) entry
          calc(60% + var(--rang) * 5%);
      }
    }
  }
</style>
