---
import mark from '~/assets/mark.svg';
import { planen, WECHSEL } from '~/lib/chat';
import type { Blickwinkel, Gespraech, Nachricht } from '~/lib/chat';

/**
 * Ein Nachrichtenverlauf, wie er auf dem Telefon aussieht.
 *
 * BLICKWINKEL: Wessen Telefon zu sehen ist, entscheidet `blickwinkel`.
 * Beim Kunden stehen seine Nachrichten rechts und die der Assistenz links.
 * Beim Betrieb ist es umgekehrt, denn dort geht die Antwort über die
 * eigene Nummer hinaus.
 *
 * MEHRERE VERLÄUFE: Über `gespraeche` laufen mehrere Verläufe nacheinander
 * auf demselben Schirm, so wie man auf einem echten Gerät von einem Chat in
 * den nächsten wechselt. Jeder Verlauf ist ein vollständiger Schirm mit
 * eigener Statusleiste, eigenem Kopf und eigenem Namen. Sie liegen
 * übereinander und werden nacheinander eingeblendet.
 *
 * ABLAUF: Es spielt sich einmal ab, sobald es zu sehen ist. Vor jeder
 * Nachricht des Gegenübers erscheint erst die Tippanzeige, dann die
 * Nachricht. Die eigenen Antworten stehen sofort da.
 *
 * Der Ablauf läuft über CSS-Verzögerungen, ausgelöst von einem Attribut.
 * Kein Zustand, keine Schleife, kein Nachrechnen zur Laufzeit.
 *
 * OHNE JAVASCRIPT steht der vollständige Verlauf da. Das Verstecken vor
 * dem Start hängt an `html[data-js]`, und das setzt nur ein Skript.
 *
 * Bei `prefers-reduced-motion` steht der erste Verlauf sofort vollständig da.
 */
interface Props {
  /** Einzelner Verlauf: Name im Kopf. */
  name?: string;
  /** Einzelner Verlauf: Zeile unter dem Namen. */
  status?: string;
  /** Einzelner Verlauf: die Nachrichten. */
  nachrichten?: Nachricht[];
  /** Einzelner Verlauf: Uhrzeit in der Statusleiste. */
  uhrzeit?: string;
  /** Mehrere Verläufe nacheinander. Ersetzt die vier Angaben darüber. */
  gespraeche?: Gespraech[];
  blickwinkel?: Blickwinkel;
  /** Streckt oder staucht den Ablauf. Kleiner ist schneller. */
  tempo?: number;
  /**
   * Worin der Verlauf steht. Auf dem Telefon gehört die Statusleiste dazu,
   * im Fenster auf dem Rechner nicht: dort sitzt sie am Bildschirmrand und
   * nicht über dem Gespräch.
   */
  geraet?: 'telefon' | 'fenster';
  class?: string;
}

const {
  name = 'Elvora',
  status = 'online',
  nachrichten,
  uhrzeit = '9:41',
  gespraeche,
  blickwinkel = 'kunde',
  tempo = 1,
  geraet = 'telefon',
  class: className = '',
}: Props = Astro.props;

/* Der einzelne Verlauf ist nur der Sonderfall mit genau einem Eintrag.
   Damit gibt es im Markup und im CSS nur einen Weg. */
const eingaben: Gespraech[] = gespraeche ?? [
  { name, status, uhrzeit, bild: mark.src, nachrichten: nachrichten ?? [] },
];

const { folge } = planen(eingaben, blickwinkel, tempo);
const mehrere = folge.length > 1;
---

<div class={`chat chat-in-${geraet} ${className}`} data-chat style={`--wechsel:${WECHSEL}s`}>
  {/*
    Die Punkte zeigen, der wievielte Verlauf gerade laeuft, wie bei einem
    Bildwechsler. Sie liegen UEBER allen Schirmen, damit sie beim Wechsel
    nicht mitrutschen. Der aktive Punkt haengt an denselben Sekunden wie
    der Schirm selbst, es kann also nichts auseinanderlaufen.
  */}
  {mehrere && (
    <div class="chat-punkte" aria-hidden="true">
      {folge.map((g, i) => (
        <span
          class:list={['chat-schrittpunkt', i === folge.length - 1 && 'chat-schrittpunkt-letzter']}
          style={`--von:${g.von.toFixed(2)}s;--bis:${g.bis.toFixed(2)}s`}
        />
      ))}
    </div>
  )}

  {
    folge.map((gespraech, stelle) => (
      <div
        class:list={[
          'chat-schirm',
          mehrere && 'chat-teil',
          stelle === folge.length - 1 && 'chat-letzte',
        ]}
        style={`--von:${gespraech.von.toFixed(2)}s;--bis:${gespraech.bis.toFixed(2)}s`}
      >
        {/* --- Statusleiste -----------------------------------------------
             Gehoert zum Telefon, nicht zum Gespraech. Im Fenster auf dem
             Rechner sitzt sie am Bildschirmrand und faellt hier weg.
             Alles andere ist auf jedem Geraet Zeichen fuer Zeichen gleich. */}
        {geraet === 'telefon' && (
        <div class="chat-status" aria-hidden="true">
          <span class="chat-uhr">{gespraech.uhrzeit}</span>
          <span class="chat-anzeigen">
            <svg viewBox="0 0 18 12" class="chat-signal" fill="currentColor">
              <rect x="0" y="8" width="3" height="4" rx="1" />
              <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
              <rect x="10" y="3" width="3" height="9" rx="1" />
              <rect x="15" y="0.5" width="3" height="11.5" rx="1" opacity="0.35" />
            </svg>
            <svg viewBox="0 0 16 12" class="chat-wlan" fill="currentColor">
              <path d="M8 11.2 5.6 8.6a3.4 3.4 0 0 1 4.8 0zM8 6.1c-1.5 0-2.9.6-3.9 1.6L2.8 6.3A7.4 7.4 0 0 1 8 4.2c2 0 3.9.8 5.2 2.1l-1.3 1.4A5.4 5.4 0 0 0 8 6.1zM8 2.2c-2.5 0-4.9 1-6.6 2.7L0 3.5A11.3 11.3 0 0 1 8 .3c3.1 0 6 1.2 8 3.2l-1.4 1.4A9.3 9.3 0 0 0 8 2.2z" />
            </svg>
            <svg viewBox="0 0 26 12" class="chat-akku" fill="none">
              <rect x="0.5" y="0.5" width="21" height="11" rx="3" stroke="currentColor" opacity="0.45" />
              <rect x="2" y="2" width="16" height="8" rx="1.6" fill="currentColor" />
              <path d="M23.5 4.2v3.6a2 2 0 0 0 0-3.6z" fill="currentColor" opacity="0.45" />
            </svg>
          </span>
        </div>
        )}

        {/* --- Kopf des Verlaufs ------------------------------------------
             Der Zurueck-Pfeil gehoert auf das Telefon, wo man aus einer
             Liste in einen Chat springt. In einem Fenster mit Seitenleiste
             gibt es kein Zurueck, dort sah er nur nach vergroessertem
             Telefon aus. Der Verlauf selbst bleibt identisch. */}
        <div class="chat-kopf">
          {geraet === 'telefon' && (
            <svg viewBox="0 0 20 20" class="chat-zurueck" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 4 6 10l6 6" />
            </svg>
          )}

          {gespraech.bild ? (
            <img class="chat-bild" src={gespraech.bild} alt="" aria-hidden="true" width="34" height="34" />
          ) : (
            <span class="chat-bild chat-kuerzel" aria-hidden="true">{gespraech.kuerzel}</span>
          )}

          <span class="chat-wer">
            <span class="chat-name">{gespraech.name}</span>
            <span class="chat-status-text">{gespraech.status}</span>
          </span>

          {geraet === 'telefon' ? (
            <svg viewBox="0 0 20 20" class="chat-kamera" fill="currentColor" aria-hidden="true">
              <path d="M2.5 5.5h9a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 1 13V7a1.5 1.5 0 0 1 1.5-1.5zM14.5 8.6l3.3-2.1a.6.6 0 0 1 .9.5v6a.6.6 0 0 1-.9.5l-3.3-2.1z" />
            </svg>
          ) : (
            <span class="chat-werkzeuge" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round">
                <circle cx="9" cy="9" r="5.5" />
                <path d="M13 13l4 4" />
              </svg>
              <svg viewBox="0 0 20 20" fill="currentColor">
                <circle cx="10" cy="4" r="1.6" />
                <circle cx="10" cy="10" r="1.6" />
                <circle cx="10" cy="16" r="1.6" />
              </svg>
            </span>
          )}
        </div>

        {/* --- Der Verlauf ----------------------------------------------- */}
        <ol class="chat-verlauf">
          <li class="chat-tag" aria-hidden="true"><span>{gespraech.stempel}</span></li>

          {gespraech.nachrichten.map((n) => (
            <>
              {n.links && (
                <li
                  class="chat-zeile chat-links chat-tippzeile"
                  style={`--ab:${n.tippenAb.toFixed(2)}s;--dauer:${n.tippenDauer.toFixed(2)}s`}
                  aria-hidden="true"
                >
                  <span class="chat-halter">
                    <span class="chat-blase chat-blase-links chat-tippen">
                      <span class="chat-punkt" />
                      <span class="chat-punkt" />
                      <span class="chat-punkt" />
                    </span>
                  </span>
                </li>
              )}

              <li
                class:list={['chat-zeile', n.links ? 'chat-links' : 'chat-rechts']}
                style={`--ab:${n.ab.toFixed(2)}s`}
              >
                <span class="chat-halter">
                  <span
                    class:list={[
                      'chat-blase',
                      n.links ? 'chat-blase-links' : 'chat-blase-rechts',
                    ]}
                  >
                    {n.text}
                    <span class="chat-meta">
                      <span class="chat-zeit">{n.zeit}</span>
                      {!n.links && (
                        <svg viewBox="0 0 16 11" class="chat-haken" fill="none" stroke="currentColor"
                          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M1 6l3 3 5.5-6.5M7 9l5.5-6.5" />
                        </svg>
                      )}
                    </span>
                  </span>
                </span>
              </li>
            </>
          ))}
        </ol>

        {/* --- Eingabezeile ---------------------------------------------- */}
        <div class="chat-eingabe" aria-hidden="true">
          <span class="chat-feld">Nachricht</span>
          <span class="chat-senden">
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.2 17.5 18.5 10 2.2 2.5 2.2 8.3l11 1.7-11 1.7z" />
            </svg>
          </span>
        </div>
      </div>
    ))
  }
</div>

<style>
  /* ======================================================================
     EINE Groesse regelt alles.

     Vorher standen alle Masse in `rem`, also fest. Derselbe Verlauf sass
     dann im 240 Punkte breiten Telefon richtig und im 1000 Punkte breiten
     Fenster wie ein aufgeblasenes Telefon: 11 Punkte Schrift, Blasen ueber
     die volle Breite, Bedienelemente aus dem Handy.

     Jetzt haengt jedes Mass an der Schriftgroesse des Verlaufs und steht in
     `em`. Ein Wert, und beide Geraete stimmen. Die Gestaltung bleibt dabei
     Zeichen fuer Zeichen dieselbe, nur der Massstab wechselt.
     ====================================================================== */
  .chat {
    position: relative;
    display: grid;
    grid-template-rows: 1fr;
    height: 100%;
    overflow: hidden;
    /* Hintergrund wie im Messenger: warmes Papier statt Weiss. */
    background: #efe7de;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
  }

  /* Auf dem Telefon bemisst sich die Schrift an der Bildschirmbreite des
     Geraets: 4.6cqi sind knapp 11 Punkte bei 15rem Geraetebreite und
     wachsen mit, wenn das Geraet groesser steht. Vorher war die Groesse
     fest, und im kleinen Hero-Telefon war alles gequetscht, im grossen
     Rahmen verloren. Den Messbereich stellt der Bildschirmausschnitt in
     `Iphone.astro`. */
  .chat-in-telefon {
    font-size: clamp(0.5625rem, 4.6cqi, 0.875rem);
  }

  .chat-in-fenster {
    font-size: 0.8125rem;
  }

  .chat-schirm {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #efe7de;
  }

  /* Ruhezustand bei mehreren Verlaeufen: nur der LETZTE steht da, also das
     Ergebnis. Ohne diese Regel laegen ohne JavaScript und ohne Bewegung
     alle drei uebereinander und ergaeben Buchstabensalat. */
  .chat-teil {
    opacity: 0;
    visibility: hidden;
  }

  .chat-teil.chat-letzte {
    opacity: 1;
    visibility: visible;
  }

  /* --- Punkte des Bildwechslers ----------------------------------------- */
  .chat-punkte {
    position: absolute;
  }

  /* Im Fenster auf dem Rechner zeigt die Seitenleiste, welcher Verlauf
     laeuft. Punkte dazu waeren dieselbe Auskunft zweimal. */
  .chat-in-fenster .chat-punkte {
    display: none;
  }

  .chat-punkte {
    inset-inline: 0;
    /* Ueber der Eingabezeile, unter den Blasen. */
    inset-block-end: 4.6em;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.5em;
    pointer-events: none;
  }

  .chat-schrittpunkt {
    width: 0.5em;
    height: 0.5em;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.18);
    transition: none;
  }

  /* Ruhezustand: der letzte Verlauf steht, also ist sein Punkt an. */
  .chat-schrittpunkt-letzter {
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Laeuft der Ablauf, uebernehmen die Animationen: an, wenn der
       eigene Schirm kommt, aus, wenn er geht. Der letzte bleibt an.
       `both` fuellt auch rueckwaerts, damit der letzte Punkt vor seiner
       Zeit NICHT an ist, obwohl der Ruhezustand ihn an zeigt. */
    .chat[data-laeuft] .chat-schrittpunkt {
      animation-name: schrittpunkt-an;
      animation-duration: 0.3s;
      animation-timing-function: ease-out;
      animation-fill-mode: both;
      animation-delay: var(--von);
    }

    .chat[data-laeuft] .chat-schrittpunkt:not(.chat-schrittpunkt-letzter) {
      animation-name: schrittpunkt-an, schrittpunkt-aus;
      animation-duration: 0.3s, 0.3s;
      animation-timing-function: ease-out, ease-out;
      animation-fill-mode: both, forwards;
      animation-delay: var(--von), var(--bis);
    }
  }

  @keyframes schrittpunkt-an {
    from { background: rgb(0 0 0 / 0.18); transform: scale(0.9); }
    to { background: var(--color-accent); transform: scale(1.15); }
  }

  @keyframes schrittpunkt-aus {
    from { background: var(--color-accent); transform: scale(1.15); }
    to { background: rgb(0 0 0 / 0.18); transform: scale(0.9); }
  }

  /* --- Statusleiste, nur auf dem Telefon -------------------------------- */
  .chat-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8em 1.7em 0.44em;
    background: #f6f2ee;
    color: #16181d;
    font-size: 1em;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .chat-anzeigen {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .chat-signal { width: 1.45em; }
  .chat-wlan { width: 1.31em; }
  .chat-akku { width: 2.11em; }

  /* --- Kopf ------------------------------------------------------------- */
  .chat-kopf {
    display: flex;
    align-items: center;
    gap: 0.8em;
    padding: 0.51em 1.02em 0.87em;
    background: #f6f2ee;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  /* Im Fenster traegt die Kopfzeile keine Statusleiste ueber sich und
     braucht deshalb oben denselben Abstand wie unten. */
  .chat-in-fenster .chat-kopf {
    padding: 0.8em 1.1em;
  }

  .chat-zurueck {
    width: 1.31em;
    flex-shrink: 0;
    color: #2f6df6;
  }

  .chat-bild {
    width: 2.98em;
    height: 2.98em;
    flex-shrink: 0;
    border-radius: 999px;
    background: #fff;
    padding: 0.4em;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }

  /* Ohne Bild stehen die Anfangsbuchstaben im Kreis, wie im Messenger bei
     einem Kontakt ohne Profilbild. Kein erfundenes Gesicht. */
  .chat-kuerzel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #cfd4da;
    color: #4a5058;
    font-size: 1em;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chat-wer {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.2;
  }

  .chat-name {
    font-size: 1.18em;
    font-weight: 600;
    color: #16181d;
  }

  .chat-status-text {
    font-size: 0.91em;
    color: #6b7079;
  }

  .chat-kamera {
    width: 1.53em;
    margin-inline-start: auto;
    flex-shrink: 0;
    color: #2f6df6;
  }

  /* Im Fenster stehen Suche und Menue statt Kamera, und zwar in den Grautoenen
     der Seite. Blaue Bedienelemente sind das Erkennungszeichen von iOS und
     haben auf einem Rechnerbildschirm nichts verloren. */
  .chat-werkzeuge {
    display: flex;
    align-items: center;
    gap: 1.1em;
    margin-inline-start: auto;
    flex-shrink: 0;
    color: #7b8089;
  }

  .chat-werkzeuge svg {
    width: 1.35em;
    height: 1.35em;
  }

  /* --- Verlauf ---------------------------------------------------------- */
  /* Nachrichten sammeln sich UNTEN und wachsen nach oben, wie in jedem
     Messenger. Oben verankert klaffte waehrend des Ablaufs eine grosse
     leere Flaeche unter den ersten Nachrichten. */
  .chat-verlauf {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0;
    margin: 0;
    padding: 1.02em 0.87em 0.73em;
    list-style: none;
    overflow: hidden;
  }

  .chat-in-fenster .chat-verlauf {
    padding: 1.2em 1.4em 1em;
  }

  .chat-tag {
    align-self: center;
    margin-bottom: 0.51em;
  }

  .chat-tag span {
    display: inline-block;
    padding: 0.22em 0.8em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    font-size: 0.82em;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7079;
  }

  /* Jede Zeile ist ein Raster mit genau einer Reihe. Deren Hoehe laesst
     sich von 0fr auf 1fr animieren, anders als `height: auto`, das sich
     nicht animieren laesst. Der Halter darin wird beschnitten.

     Das ist der Grund, warum der Verlauf von unten waechst: eine noch
     nicht erschienene Nachricht belegt keinen Platz. */
  .chat-zeile {
    display: grid;
    grid-template-rows: 1fr;
  }

  .chat-halter {
    display: flex;
    min-height: 0;
    overflow: hidden;
  }

  .chat-links .chat-halter { justify-content: flex-start; }
  .chat-rechts .chat-halter { justify-content: flex-end; }

  /* Die Breite ist nach OBEN begrenzt, nicht nur anteilig. Im breiten
     Fenster liefen die Zeilen sonst ueber 80 Zeichen, und eine Chatblase
     mit 80 Zeichen je Zeile ist keine Chatblase mehr. */
  .chat-blase {
    position: relative;
    max-width: min(80%, 26em);
    padding: 0.5em 0.73em 0.4em;
    border-radius: 0.73em;
    font-size: 1em;
    line-height: 1.42;
    color: #16181d;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.09);
    /* Die Uhrzeit sitzt in der letzten Zeile. Der Freiraum verhindert,
       dass der Text sie ueberlaeuft. */
    padding-inline-end: 4.4em;
  }

  .chat-blase-links {
    background: #fff;
    border-start-start-radius: 0.22em;
  }

  /* Die Farbe der eigenen Blase kommt aus der Marke, nicht aus dem
     Messenger: der Verlauf ist eine Darstellung, keine Nachbildung.
     Kraeftiger als vorher, sonst war die Seite, von der die Antwort kommt,
     kaum von der anderen zu unterscheiden. */
  .chat-blase-rechts {
    background: color-mix(in oklab, var(--color-accent) 16%, #fff);
    border-start-end-radius: 0.22em;
  }

  .chat-meta {
    position: absolute;
    inset-block-end: 0.4em;
    inset-inline-end: 0.73em;
    display: flex;
    align-items: center;
    gap: 0.23em;
    font-size: 0.73em;
    color: #8b9099;
  }

  .chat-haken {
    width: 1.1em;
    color: #2f6df6;
  }

  /* --- Tippanzeige ------------------------------------------------------ */
  .chat-tippen {
    display: inline-flex;
    align-items: center;
    gap: 0.23em;
    padding: 0.61em 0.87em;
    background: #fff;
    border-start-start-radius: 0.22em;
  }

  .chat-punkt {
    width: 0.38em;
    height: 0.38em;
    border-radius: 999px;
    background: #9aa0a8;
  }

  /* --- Eingabezeile ----------------------------------------------------- */
  .chat-eingabe {
    display: flex;
    align-items: center;
    gap: 0.58em;
    /* Unten mehr Luft: dort sitzt auf dem Geraet der Bedienbalken. */
    padding: 0.65em 0.87em 1.67em;
    background: #f6f2ee;
    border-top: 1px solid rgb(0 0 0 / 0.07);
  }

  /* Der EINZIGE Unterschied im Aufbau zwischen Telefon und Fenster: der
     Platz fuer den Bedienbalken am unteren Rand des Geraets. */
  .chat-in-fenster .chat-eingabe {
    padding: 0.8em 1.4em;
  }

  .chat-feld {
    flex: 1;
    padding: 0.5em 1.02em;
    border-radius: 999px;
    background: #fff;
    font-size: 1em;
    color: #9aa0a8;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }

  .chat-senden {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.96em;
    height: 1.96em;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
  }

  .chat-senden svg { width: 1.02em; }

  /* ======================================================================
     Der Ablauf

     Ausgangslage OHNE Skript: alles steht fertig da. Erst wenn ein Skript
     laeuft, traegt es `data-js` an das Dokument, und dann erst wird vor dem
     Start versteckt. So bleibt die Seite ohne JavaScript vollstaendig.

     `data-laeuft` setzt der Beobachter in Base.astro, sobald der Verlauf zu
