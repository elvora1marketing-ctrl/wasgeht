---
/**
 * Text, der sich beim Erscheinen einläuft.
 *
 * Übernimmt die Idee einer React-Vorlage, die dafür Framer Motion voraussetzt:
 * rund 130 kB für einen Effekt, der in gut zwanzig Zeilen passt.
 *
 * Diese Datei liefert NUR das Markup. Die Definition des eigenen Elements
 * steht genau einmal je Seite in `Base.astro`. Stünde sie hier, hätte sie
 * bei dreißig Kennungen dreißigmal im Dokument gestanden.
 *
 * ZWEI DINGE, DIE DIE VORLAGE NICHT LÖST:
 *
 * 1. Vorlesesoftware. Die Vorlage tauscht den sichtbaren Text vierzig Mal in
 *    der Sekunde aus, ein Screenreader liest dabei Buchstabensalat vor.
 *    Deshalb steht der echte Text hier ein zweites Mal unsichtbar daneben,
 *    und nur die sichtbare Fassung wird angefasst.
 * 2. Springendes Layout. Zufallszeichen sind unterschiedlich breit, die Zeile
 *    zappelt. Deshalb ist der Effekt an die Schreibmaschinenschrift gebunden,
 *    in der jedes Zeichen gleich breit ist.
 *
 * Ohne JavaScript steht der Text einfach da, bei `prefers-reduced-motion`
 * ebenso.
 */
interface Props {
  /** Der Text. Als Eigenschaft statt als Bereich: das Skript braucht ihn als Zeichenkette. */
  text: string;
  /** Millisekunden je Bild. Größer heißt langsamer. */
  tempo?: number;
  class?: string;
}

const { text, tempo = 32, class: className = '' }: Props = Astro.props;
---

<text-scramble class={`scramble ${className}`} data-tempo={tempo}>
  <span class="sr-only">{text}</span>
  <span class="scramble-sicht" aria-hidden="true">{text}</span>
</text-scramble>

<style>
  .scramble {
    display: inline-block;
  }

  /* Die Vorlese-Fassung liegt unsichtbar neben der sichtbaren. Beim
     Markieren nimmt der Browser aber beide mit, und in der Zwischenablage
     landete die Kennung doppelt: „Digitalagentur ...Digitalagentur ...".
     Vorlesesoftware kümmert das nicht, sie liest den Textbaum. */
  .scramble .sr-only {
    user-select: none;
  }

  /* Gleiche Zeichenbreite ist hier keine Stilfrage, sondern Voraussetzung:
     sonst springt die Zeile bei jedem Bild. */
  .scramble-sicht {
    font-variant-ligatures: none;
    white-space: pre-wrap;
  }
</style>
