---
/**
 * Handlungsaufruf.
 *
 * Hierarchie ist hier bewusst fest verdrahtet:
 *   primary   -- flaechig in der Akzentfarbe. Pro Sichtbereich nur EINMAL.
 *   secondary -- Umriss in Grau, klar untergeordnet, nie in der Akzentfarbe.
 *   quiet     -- reiner Textlink, schwaechste Stufe.
 *   aufFarbe  -- weiss auf farbiger Flaeche. Die Akzentfarbe wuerde auf den
 *                Markenfarben untergehen, auf der Magenta-Tafel fast ganz.
 *
 * Damit kann kein zweiter CTA versehentlich mit dem Haupt-CTA konkurrieren.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'quiet' | 'aufFarbe';
  size?: 'md' | 'lg';
  fullWidth?: boolean;
  /**
   * Laufender Markenverlauf als Rahmen.
   *
   * NUR FÜR DEN EINEN ABSCHLUSS-AUFRUF. Bewegung zieht das Auge, und
   * genau deshalb funktioniert sie nur, wenn sie einmal vorkommt. Säßen
   * drei laufende Rahmen auf einer Seite, hätte keiner mehr Vorrang und
   * die Seite flackerte bloß.
   *
   * Ohne JavaScript und ohne Bibliothek: ein Kegelverlauf auf einer
   * übergroßen Fläche, die sich dreht und vom Rahmen beschnitten wird.
   * Das läuft im Compositor und kostet nichts.
   */
  ring?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  ring = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-button font-medium ' +
  'transition-colors duration-150 whitespace-nowrap ' +
  'disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<string, string> = {
  primary:
    'bg-accent text-accent-contrast hover:bg-accent-hover shadow-[0_1px_2px_rgb(25_29_33/0.10)]',
  secondary:
    'border border-border-strong bg-surface text-ink hover:bg-surface-subtle hover:border-ink-faint',
  quiet: 'text-ink-muted underline underline-offset-4 decoration-border-strong hover:text-ink hover:decoration-ink-faint',
  aufFarbe: 'bg-white text-ink hover:bg-white/90 shadow-[0_1px_2px_rgb(0_0_0/0.16)]',
};

const sizes: Record<string, string> = {
  md: variant === 'quiet' ? 'text-[0.9375rem]' : 'h-11 px-5 text-[0.9375rem]',
  lg: variant === 'quiet' ? 'text-base' : 'h-13 px-7 text-base',
};

const classes = [
  base,
  variants[variant],
  sizes[size],
  fullWidth ? 'w-full' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
---

{
  ring ? (
    <span class="knopf-ring">
      <Tag class={classes} {...(href ? { href } : { type })} {...rest}>
        <slot />
      </Tag>
    </span>
  ) : (
    <Tag class={classes} {...(href ? { href } : { type })} {...rest}>
      <slot />
    </Tag>
  )
}

<style>
  /* Der laufende Rahmen.
   *
   * Aufbau: eine uebergrosse Flaeche mit Kegelverlauf dreht sich hinter
   * dem Knopf, der Rahmen beschneidet sie auf seine Form. Uebrig bleiben
   * drei Pixel Verlauf ringsum, die wandern.
   *
   * `inset: -140%` ist kein Zierwert: die Flaeche muss beim Drehen in
   * jeder Stellung die ganze Ecke abdecken, sonst blitzt beim Drehen der
   * Grund durch. Die Diagonale eines Rechtecks ist immer laenger als
   * seine Seiten, deshalb deutlich mehr als 100%.
   *
   * Der Radius rechnet die drei Pixel Rahmen auf den Knopfradius drauf.
   * Gleiche Werte saehen an den Ecken aus, als sei der Knopf zu klein
   * geraten. */
  .knopf-ring {
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: calc(var(--radius-button) + 3px);
    overflow: hidden;
  }

  .knopf-ring:has(.w-full) {
    display: flex;
  }

  /* OHNE DIE MITTLERE MARKENFARBE. Der Verlauf der Marke geht von Indigo
   * ueber Magenta nach Orange -- und Magenta ist genau die Farbe des
   * Knopfes. Mit ihr im Ring war der Ring auf halber Strecke unsichtbar:
   * er wurde gezeichnet, hob sich aber nicht ab, und von aussen sah es
   * aus, als funktioniere die Technik nicht.
   *
   * Jetzt nur die beiden Enden plus ein heller Punkt. Alle drei stehen
   * deutlich gegen Magenta, der Ring bleibt in jeder Stellung sichtbar.
   *
   * MIT AUSWEICHWERTEN. Tailwind gibt nur die Theme-Variablen aus, die im
   * Build auch vorkommen. Faellt eine davon weg, ist der ganze
   * Kegelverlauf ungueltig und der Ring verschwindet ersatzlos -- ohne
   * Fehlermeldung, ohne dass am Markup etwas zu sehen waere. Genau daran
   * habe ich beim Bauen eine Weile gesucht. */
  .knopf-ring::before {
    content: '';
    position: absolute;
    inset: -140%;
    background: conic-gradient(
      from 0deg,
      var(--color-brand-start, #5c67db),
      var(--color-brand-end, #f45e3d),
      #ffffff,
      var(--color-brand-start, #5c67db)
    );
  }

  /* Der Knopf liegt ueber dem Verlauf und deckt ihn bis auf den Rand ab.
   *
   * HIER STAND EINMAL `width: 100%`, und das hat den Ring unsichtbar
   * gemacht. Der Traeger ist inline-flex, seine Breite richtet sich also
   * nach dem Knopf darin. Bekommt der Knopf zugleich 100% Breite, ist die
   * Rechnung im Kreis: der Browser loest sie so auf, dass der Knopf ueber
   * die zwei Pixel Polsterung hinauswaechst und den Verlauf zudeckt. Von
   * aussen sah es aus, als wuerde der Ring gar nicht gezeichnet.
   *
   * Volle Breite nur dort, wo sie ausdruecklich verlangt ist. */
  .knopf-ring > :global(*) {
    position: relative;
  }

  .knopf-ring:has(:global(.w-full)) > :global(*) {
    width: 100%;
  }

  /* Langsam. Ein schnell kreisender Rahmen wirkt wie eine Warnleuchte,
     und Dringlichkeit ist nicht dasselbe wie Einladung. */
  @media (prefers-reduced-motion: no-preference) {
    .knopf-ring::before {
      animation: knopf-kreisen 6s linear infinite;
    }
  }

  @keyframes knopf-kreisen {
    to {
      transform: rotate(1turn);
    }
  }
</style>
