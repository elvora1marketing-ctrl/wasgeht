---
/**
 * Handlungsaufruf.
 *
 * Hierarchie ist hier bewusst fest verdrahtet:
 *   primary   -- flaechig in der Akzentfarbe. Pro Sichtbereich nur EINMAL.
 *   secondary -- Umriss in Grau, klar untergeordnet, nie in der Akzentfarbe.
 *   quiet     -- reiner Textlink, schwaechste Stufe.
 *   aufFarbe  -- weiss auf farbiger Flaeche. Die Akzentfarbe wuerde auf den
 *                Markenfarben untergehen, auf der Magenta-Tafel fast ganz.
 *
 * Damit kann kein zweiter CTA versehentlich mit dem Haupt-CTA konkurrieren.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'quiet' | 'aufFarbe';
  size?: 'md' | 'lg';
  fullWidth?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  class: className = '',
  ...rest
} = Astro.props;

/*
 * KOERPERLICHE RUECKMELDUNG STATT EFFEKT.
 *
 * Der Knopf hebt sich beim Ueberfahren einen Hauch an und geht beim
 * Druecken wieder herunter. Das ist keine Zierde: ein Bedienelement, das
 * sich beim Beruehren bewegt, wird als druckbar erkannt, bevor man
 * darueber nachgedacht hat. Deshalb `active:` schneller als `hover:` --
 * beim Druecken erwartet man eine sofortige Antwort, beim Ueberfahren
 * eine weiche.
 *
 * `transition-colors` reichte dafuer nicht, Bewegung und Schatten muessen
 * mitgehen, sonst springt der Knopf statt zu federn.
 */
const base =
  'inline-flex items-center justify-center gap-2 rounded-button font-medium ' +
  'whitespace-nowrap transition duration-200 ease-out ' +
  'hover:-translate-y-px active:translate-y-0 active:duration-75 ' +
  'disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<string, string> = {
  primary:
    'bg-accent text-accent-contrast hover:bg-accent-hover ' +
    'shadow-[0_1px_2px_rgb(25_29_33/0.10)] ' +
    'hover:shadow-[0_4px_12px_-2px_rgb(178_58_148/0.45)] ' +
    'active:shadow-[0_1px_2px_rgb(25_29_33/0.14)]',
  secondary:
    'border border-border-strong bg-surface text-ink hover:bg-surface-subtle hover:border-ink-faint',
  quiet: 'text-ink-muted underline underline-offset-4 decoration-border-strong hover:text-ink hover:decoration-ink-faint',
  aufFarbe:
    'bg-white text-ink hover:bg-white/90 shadow-[0_1px_2px_rgb(0_0_0/0.16)] ' +
    'hover:shadow-[0_4px_12px_-2px_rgb(0_0_0/0.28)]',
};

const sizes: Record<string, string> = {
  md: variant === 'quiet' ? 'text-[0.9375rem]' : 'h-11 px-5 text-[0.9375rem]',
  lg: variant === 'quiet' ? 'text-base' : 'h-13 px-7 text-base',
};

const classes = [
  base,
  variants[variant],
  sizes[size],
  fullWidth ? 'w-full' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag class={classes} {...(href ? { href } : { type })} {...rest}>
  <slot />
</Tag>
