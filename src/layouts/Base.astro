---
import '~/styles/global.css';
import SeoHead from '~/components/SeoHead.astro';
import Schema from '~/components/Schema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import type { FaqItem } from '~/types';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  /** Ohne Startseite, die wird im Markup automatisch vorangestellt. */
  breadcrumbs?: Array<{ label: string; href?: string }>;
  service?: { name: string; description: string };
  faq?: FaqItem[];
  /**
   * Farbe der Kopftafel dieser Seite. Die Kopfleiste übernimmt sie, damit die
   * Seite nicht mit einem weißen Streifen über der Tafel beginnt. Seiten ohne
   * farbige Tafel lassen die Angabe weg.
   */
  kopfFarbe?: string;
}

const {
  title,
  description,
  noindex,
  image,
  breadcrumbs,
  service,
  faq,
  kopfFarbe,
}: Props = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <SeoHead
      title={title}
      description={description}
      noindex={noindex}
      image={image}
      kopfFarbe={kopfFarbe}
    />
    {!noindex && <Schema breadcrumbs={breadcrumbs} service={service} faq={faq} />}

    {/*
      Merkzeichen, dass ein Skript laeuft.

      Die Nachrichtenverlaeufe verstecken sich vor ihrem Start, damit man
      sie ablaufen sieht und nicht nur das Ergebnis. Ohne JavaScript
      koennte sie aber nichts starten, und der Schirm bliebe fuer immer
      leer. Deshalb wird nur versteckt, wenn dieses Merkzeichen steht.

      Es steht bewusst im Kopf und nicht am Ende der Seite: sonst waere der
      fertige Verlauf einen Wimpernschlag lang zu sehen, bevor er sich
      zurueckstellt.
    */}
    <script is:inline>
      document.documentElement.setAttribute('data-js', '');
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:rounded-button focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Zum Inhalt springen
    </a>

    <Header kopfFarbe={kopfFarbe} />

    <main id="inhalt">
      <slot />
    </main>

    <Footer />

    {/*
      Das eigene Element für die einlaufenden Kennungen. Steht bewusst HIER
      und nicht in `Scramble.astro`: die Kennungen kommen auf manchen Seiten
      ein Dutzend Mal vor, und ein `is:inline`-Skript in der Komponente wäre
      genauso oft im Dokument gelandet.

      Bewusst eingebettet statt als eigene Datei: so bleibt der Build ohne
      eine einzige JavaScript-Datei und ohne zusätzliche Anfrage.

      HIER STANDEN BIS EBEN NOCH ZWEI WEITERE SKRIPTE: der Magnet, der den
      Aufruf zum Zeiger neigte, und die Maschine, die ihn in Streifen
      zerriss. Beides ist mit dem Schimmer-Aufruf hinfällig geworden -- der
      macht dasselbe in reinem CSS. Über vierhundert Zeilen JavaScript, die
      auf jeder Seite mitgingen, sind damit weg.
    */}
    <script is:inline>
      // Nur anmelden, wenn es die Kennung noch nicht gibt. Auf der Seite
      // selbst steht das Skript ohnehin nur einmal, in der Vorschau liegen
      // aber alle Seiten in EINEM Dokument, und ein zweiter Anlauf wuerde
      // dort einen Fehler werfen und alles danach abbrechen.
      if (!customElements.get('text-scramble'))
      customElements.define(
        'text-scramble',
        class extends HTMLElement {
          connectedCallback() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const sicht = this.querySelector('.scramble-sicht');
            if (!sicht) return;

            const ziel = sicht.textContent;
            const takt = Number(this.dataset.tempo) || 32;
            const vorrat = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&/=+*';
            // Breite der Zone, in der noch gewuerfelt wird, bevor der echte
            // Buchstabe stehen bleibt.
            const zone = 5;

            const lauf = () => {
              let schritt = 0;
              const takte = ziel.length + zone;

              const uhr = setInterval(() => {
                let aus = '';
                for (let i = 0; i < ziel.length; i++) {
                  const z = ziel[i];
                  // Leerzeichen und Trenner bleiben stehen, sonst verliert
                  // die Zeile ihre Gliederung und wird zu einem Block.
                  if (z === ' ' || z === '·' || z === '—' || z === '&') {
                    aus += z;
                  } else if (i < schritt - zone) {
                    aus += z;
                  } else {
                    aus += vorrat[(Math.random() * vorrat.length) | 0];
                  }
                }
                sicht.textContent = aus;

                if (++schritt > takte) {
                  clearInterval(uhr);
                  sicht.textContent = ziel;
                }
              }, takt);
            };

            // Erst laufen lassen, wenn das Element zu sehen ist. Sonst ist
            // der Effekt bei allem unterhalb des ersten Bildschirms schon
            // vorbei, bevor jemand hinschaut.
            if (!('IntersectionObserver' in window)) return lauf();

            const wache = new IntersectionObserver(
              (eintraege) => {
                for (const e of eintraege) {
                  if (!e.isIntersecting) continue;
                  wache.disconnect();
                  lauf();
                }
              },
              { threshold: 0.6 },
            );
            wache.observe(this);
          }
        },
      );

      /*
        Nachrichtenverlaeufe starten, sobald sie zu sehen sind.

        Ohne das liefe der Ablauf beim Laden der Seite los und waere
        vorbei, bevor jemand hinscrollt -- man saehe nur das Ergebnis und
        nie, dass die Antwort sofort kommt. Genau das ist aber die Aussage.

        Einmalig: `disconnect` nach dem ersten Mal. Ein Verlauf, der bei
        jedem Vorbeiscrollen neu anfaengt, wirkt wie eine Werbeschleife.
      */
      (function () {
        var alle = document.querySelectorAll('[data-chat]');
        if (!alle.length) return;

        /*
          Ein Verlauf kann in einer groesseren Einheit stecken, etwa im
          Vormittag: dort laeuft neben dem Telefon eine Zeitleiste mit, die
          auf dieselbe Sekunde gehoert. Beobachtet wird deshalb nur die
          aeusserste Einheit, und die startet alles darin GLEICHZEITIG.
          Zwei eigene Beobachter wuerden frueher oder spaeter auseinander
          liegen, und dann zeigt die Leiste etwas anderes als das Telefon.
        */
        var aeussere = [].filter.call(alle, function (el) {
          return !el.parentElement || !el.parentElement.closest('[data-chat]');
        });

        function setzen(el, wert) {
          el.setAttribute(wert, '');
          [].forEach.call(el.querySelectorAll('[data-chat]'), function (k) {
            k.setAttribute(wert, '');
          });
        }

        function loeschen(el, wert) {
          el.removeAttribute(wert);
          [].forEach.call(el.querySelectorAll('[data-chat]'), function (k) {
            k.removeAttribute(wert);
          });
        }

        function starten(el) { setzen(el, 'data-laeuft'); }

        /* ------------------------------------------------------------------
           Karussells steuern ihre Verlaeufe selbst.

           Vorher liefen beim Erscheinen ALLE DREI Telefone gleichzeitig los.
           Wer dann weiterklickte, fand den naechsten Verlauf bereits
           abgelaufen vor und sah nie, wie die Assistenz antwortet -- also
           genau das, was die Vorfuehrung zeigen soll.

           Jetzt laeuft nur das vordere. Die hinteren stehen als Standbild
           (`data-fertig`), damit sie nicht leer wirken. Wer weiterklickt,
           startet den Verlauf, der nach vorn kommt, von vorn -- auch beim
           zweiten Mal, deshalb das Zuruecksetzen mitsamt erzwungener
           Neuberechnung. Ohne die fasst der Browser Entfernen und Setzen
           zu nichts zusammen und die Animation laeuft einfach weiter.
           ------------------------------------------------------------------ */
        var karussells = [].slice.call(document.querySelectorAll('.karussell'));

        function vorderesIndex(k) {
          var wahl = k.querySelectorAll('.karussell-wahl');
          for (var i = 0; i < wahl.length; i++) if (wahl[i].checked) return i;
          return 0;
        }

        function karussellStellen(k) {
          var aktiv = vorderesIndex(k);
          var telefone = k.querySelectorAll('.karussell-telefon');
          [].forEach.call(telefone, function (t, i) {
            [].forEach.call(t.querySelectorAll('[data-chat]'), function (c) {
              if (i === aktiv) {
                c.removeAttribute('data-fertig');
                loeschen(c, 'data-laeuft');
                void c.offsetWidth;
                starten(c);
              } else {
                loeschen(c, 'data-laeuft');
                setzen(c, 'data-fertig');
              }
            });
          });
        }

        karussells.forEach(function (k) {
          k.addEventListener('change', function () {
            if (k.hasAttribute('data-sichtbar')) karussellStellen(k);
          });
        });

        /* Verlaeufe in einem Karussell nicht zusaetzlich einzeln beobachten. */
        var frei = aeussere.filter(function (el) { return !el.closest('.karussell'); });

        if (!('IntersectionObserver' in window)) {
          frei.forEach(starten);
          karussells.forEach(function (k) {
            k.setAttribute('data-sichtbar', '');
            karussellStellen(k);
          });
          return;
        }

        var wache = new IntersectionObserver(
          function (eintraege) {
            eintraege.forEach(function (e) {
              if (!e.isIntersecting) return;
              wache.unobserve(e.target);
              if (e.target.classList.contains('karussell')) {
                e.target.setAttribute('data-sichtbar', '');
                karussellStellen(e.target);
              } else {
                starten(e.target);
              }
            });
          },
          { threshold: 0.35 },
        );

        frei.forEach(function (v) { wache.observe(v); });
        karussells.forEach(function (k) { wache.observe(k); });
      })();
    </script>
  </body>
</html>
