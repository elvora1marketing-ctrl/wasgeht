---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import ShimmerCta from '~/components/ShimmerCta.astro';
import Portrait from '~/components/Portrait.astro';
import Scramble from '~/components/Scramble.astro';
import Sterne from '~/components/Sterne.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import Telefonkarussell from '~/components/Telefonkarussell.astro';
import Textrolle from '~/components/Textrolle.astro';
import Vormittag from '~/components/Vormittag.astro';
import { empfangGespraeche } from '~/lib/empfang';
import {
  cta,
  services,
  automationModules,
  address,
  owner,
  contactLinks,
  reviews,
} from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Betriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/**
 * Wo Aufträge im Alltag verloren gehen.
 *
 * ZWEIGETEILT: Lage und Folge stehen getrennt.
 *
 * Vorher stand beides in EINEM Absatz je Karte, und die drei Karten
 * standen nebeneinander. Man musste jede Karte einzeln lesen, um zu
 * merken, dass alle drei dasselbe erzählen. Genau das ist aber der Punkt
 * des Abschnitts.
 *
 * Jetzt liegen die drei untereinander, und in jeder Zeile steht links die
 * Lage, rechts die Folge, immer an derselben Stelle. Das Muster sieht man
 * dann, ohne es zu lesen: dreimal war die Anfrage da, dreimal kam sie
 * nicht an. Erst danach liest man nach, warum.
 */
const verluste = [
  {
    titel: 'Das Telefon klingelt',
    lage: 'Sie sind beim Kunden, im Termin, unter der Spüle. Abheben geht gerade nicht.',
    folge: 'Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
    farbe: '#a93d28',
    zeichen: 'M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z',
  },
  {
    titel: 'Abends zwölf Nachrichten',
    lage: 'Dazu vier Rückrufwünsche, alle seit dem Vormittag offen.',
    folge: 'Sie arbeiten sie nach Feierabend ab. Oder eben nicht.',
    farbe: '#2b2f7a',
    zeichen: 'M3 16l1.2-3A6.5 6.5 0 1 1 6.6 15.4zM7 8h6M7 11h4',
  },
  {
    titel: 'Bei Google nicht zu finden',
    lage: 'Gesucht wird online, angerufen wird einer der ersten drei Treffer.',
    folge: 'Stehen Sie dort nicht, kommt die Anfrage gar nicht erst bei Ihnen an.',
    farbe: '#a63082',
    zeichen: 'M9 4a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM13 13l4 4',
  },
];

/**
 * Was hereinkommt, während der Betrieb arbeitet.
 *
 * Zu jedem Ereignis gehört der Verlauf, der auf dem Telefon dazu abläuft.
 * Blickwinkel ist hier das Telefon des BETRIEBS: der Kunde steht links,
 * die Antwort der Assistenz rechts, weil sie über die eigene Nummer
 * hinausgeht.
 *
 * Die Namen sind Beispiele, keine echten Vorgänge.
 */
const vormittag = [
  {
    kanal: 'WhatsApp',
    farbe: '#a63082',
    zeichen: 'M3 16l1.2-3A6.5 6.5 0 1 1 6.6 15.4zM7 8h6M7 11h4',
    zeit: '08:14',
    text: 'Verstopfter Abfluss, dringend. Termin für 11:30 Uhr vergeben, bevor Sie überhaupt auf dem ersten Dach standen.',
    gespraech: {
      name: 'Frau Kern',
      status: 'zuletzt online 08:16',
      nachrichten: [
        { von: 'kunde' as const, zeit: '08:14', text: 'Guten Morgen, unser Küchenabfluss ist komplett dicht. Kommt heute noch jemand??' },
        { von: 'assistenz' as const, zeit: '08:14', text: 'Guten Morgen, Frau Kern! Heute 11:30 Uhr ist noch frei. Passt das?' },
        { von: 'kunde' as const, zeit: '08:15', text: 'Ja bitte! Wie lange dauert sowas ungefähr?' },
        { von: 'assistenz' as const, zeit: '08:15', text: 'Meist unter einer Stunde. Eingetragen: heute, 11:30 Uhr. Der Kollege hat Ihre Nachricht direkt auf dem Handy.' },
      ],
    },
  },
  {
    kanal: 'Verpasster Anruf',
    farbe: '#a93d28',
    zeichen: 'M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z',
    zeit: '09:02',
    text: 'Angerufen, während alle auf der Baustelle waren. Aus dem verpassten Anruf wurde ein Besichtigungstermin für eine Badsanierung.',
    gespraech: {
      name: '0201 ••• ••••',
      status: 'nicht in den Kontakten',
      kuerzel: '?',
      nachrichten: [
        { von: 'assistenz' as const, zeit: '09:02', text: 'Guten Tag, Sie haben uns gerade angerufen. Wir sind vormittags auf der Baustelle. Worum geht es? Ich leite es sofort weiter.' },
        { von: 'kunde' as const, zeit: '09:05', text: 'Guten Tag, wir möchten unser Bad sanieren lassen. Machen Sie sowas?' },
        { von: 'assistenz' as const, zeit: '09:05', text: 'Ja! Am besten schaut sich der Chef das vor Ort an. Wann sind Sie diese Woche zu Hause?' },
        { von: 'kunde' as const, zeit: '09:07', text: 'Donnerstag ab 16 Uhr ginge.' },
        { von: 'assistenz' as const, zeit: '09:07', text: 'Notiert: Donnerstag ab 16 Uhr, Besichtigung Badsanierung. Die Bestätigung mit genauer Uhrzeit kommt heute noch.' },
      ],
    },
  },
  {
    kanal: 'Kontaktformular',
    farbe: '#2b2f7a',
    zeichen: 'M4 4h12a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM3.5 5.5 10 11l6.5-5.5',
    zeit: '11:37',
    text: 'Anfrage zur Heizungswartung über die Website. Termin steht, Erinnerung kommt automatisch, ohne Ihr Zutun.',
    gespraech: {
      name: 'Familie Weber',
      status: 'zuletzt online 11:40',
      nachrichten: [
        { von: 'kunde' as const, zeit: '11:37', text: 'Guten Tag, ich habe eben das Formular ausgefüllt, wegen der Heizungswartung. Kam das an?' },
        { von: 'assistenz' as const, zeit: '11:37', text: 'Ja, Ihre Anfrage ist da! Für die Wartung wäre nächste Woche Dienstag oder Mittwoch vormittags frei. Was passt besser?' },
        { von: 'kunde' as const, zeit: '11:39', text: 'Mittwoch. Muss ich dafür zu Hause sein?' },
        { von: 'assistenz' as const, zeit: '11:39', text: 'Ja, der Zugang zur Therme reicht. Eingetragen: Mittwoch, 9:00 Uhr. Die Erinnerung kommt am Vortag automatisch.' },
      ],
    },
  },
];

/** Zeichen je Leistung, im 24er-Raster. */
const kachelZeichen: Record<string, string> = {
  webdesign: 'M3 5h18v14H3zM3 9h18M6 7h.01M9 7h.01',
  seo: 'M11 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM15.5 14.5 21 20',
  branding: 'M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 8.7l5.4-.8z',
  automatisierung: 'M4 17l1.4-3.6A7.5 7.5 0 1 1 8.2 16zM8.5 9h7M8.5 12h4.5',
};

---

<Base title={title} description={description}>
  {/* ===================== Aufschlag =====================
      Zwei Spalten: links die Aussage, rechts die Vorfuehrung.

      Die Bewertungen stehen jetzt DIREKT UNTER DER UEBERSCHRIFT. Vorher
      sassen sie am Fuss der Hero und lagen auf einem Bildschirm mit 900
      Punkten Hoehe genau an der Kante. Ein Beleg, den man erst durch
      Scrollen findet, arbeitet nicht.

      Rechts laeuft der Verlauf, den man auf WhatsApp tatsaechlich bekommt.
      Er beginnt ohne Zutun, weil er beim Laden schon zu sehen ist. Damit
      steht die Vorfuehrung im ersten Blick und nicht erst nach dem halben
      Scrollweg. */}
  <section class="hero">
    <div class="container-content hero-inner">
      <div class="hero-text">
        {/* Nennt das Publikum, nicht die eigene Kategorie. „Digitalagentur
            aus Essen" stand hier vorher und sagte, was ich BIN -- damit
            steht man in einer Reihe mit jeder anderen Agentur im
            Ruhrgebiet. „Für Handwerk und Betriebe" sagt dem Leser in vier
            Wörtern, dass diese Seite für ihn gemacht ist. */}
        <p class="hero-kennung kennung">
          <Scramble text={`Digitalagentur für Handwerk und Betriebe · ${address.city}`} />
        </p>

        {/* Die Buchstaben klappen einzeln herein. Das ist der bewegte
            Moment im ersten Sichtbereich, und er sitzt auf dem Satz, auf
            den es ankommt, statt auf einer Zierleiste. */}
        <h1
          class="hero-schlag"
          aria-label="Ihr Betrieb wird gefunden, angerufen und beauftragt."
        >
          <Textrolle
            stumm
            teile={[
              { text: 'Ihr Betrieb wird ' },
              { text: 'gefunden', betont: true },
              { text: ', angerufen und beauftragt.' },
            ]}
          />
        </h1>

        <ReviewBadge groesse="gross" class="hero-beleg" />

        {/* Beginnt beim Verlust, nicht beim Angebot. Vorher stand hier eine
            Beobachtung über „die meisten Betriebe" -- richtig, aber über
            andere geredet. Jetzt steht der Satz beim Leser selbst und
            benennt, was ihm heute schon durchgeht. */}
        <p class="hero-intro">
          Jeder verpasste Anruf ist ein Auftrag, der beim Nächsten landet. Und
          eine Website, die bei Google nicht auftaucht, bringt Ihnen keinen
          einzigen. Ich sorge dafür, dass beides aufhört.
        </p>

        {/* HANDLUNG UND ZUSATZ SIND EINE EINHEIT.
            Vorher stand der Zusatz als eigene Zeile unter dem Knopf, mit
            demselben Abstand wie alles andere im Hero -- also als vierter
            loser Absatz untereinander. So sah er aus wie noch ein Satz,
            den man liest oder eben nicht. Jetzt sitzt er eng am Knopf und
            gehoert sichtbar zu ihm: er beantwortet die Frage, die man im
            Moment vor dem Klick hat. */}
        <div class="hero-block">
          <div class="hero-handlung">
            {/* OHNE `max-sm:w-full`. Tailwinds `sm` liegt bei 40rem, die
                Umbruchstelle dieser Zeile lag bei 30rem -- dazwischen war
                der eine Knopf ueber die volle Breite gezogen und der
                andere daneben nur so breit wie sein Text. Beide Breiten
                kommen jetzt aus derselben Abfrage weiter unten. */}
            <ShimmerCta href={cta.primary.href} size="lg" class="hero-cta">
              {cta.primary.label}
            </ShimmerCta>

            {/* DER ZWEITE WEG IST JETZT EIN KNOPF, KEIN TEXTLINK MEHR.
                Als unterstrichene graue Zeile sah er aus wie eine
                Fussnote, und fuer viele Betriebsinhaber ist WhatsApp der
                Weg mit der geringsten Hemmschwelle ueberhaupt -- der darf
                nicht der unscheinbarste auf der Seite sein.

                Farbe traegt nur das Zeichen. Ein zweiter flaechig
                gefaerbter Knopf wuerde mit dem ersten um denselben Blick
                streiten; das gruene Zeichen auf ruhigem Grund wird sofort
                als WhatsApp erkannt und bleibt trotzdem untergeordnet. */}
            <ShimmerCta
              href={contactLinks.whatsapp}
              ton="whatsapp"
              size="lg"
              class="hero-whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 2a8 8 0 0 0-6.9 12l-1 3.7 3.8-1A8 8 0 1 0 10 2zm0 1.6a6.4 6.4 0 1 1-3.3 11.9l-.3-.2-2.2.6.6-2.1-.2-.3A6.4 6.4 0 0 1 10 3.6zM7.4 6.3c-.1 0-.3 0-.5.2-.2.2-.6.6-.6 1.4s.6 1.6.7 1.8c.1.1 1.2 2 3 2.7 1.5.6 1.8.5 2.1.5.4 0 1.1-.4 1.3-.9.2-.5.2-.9.1-1l-.4-.2-1.2-.6c-.2 0-.3-.1-.4.1l-.6.7c-.1.2-.2.2-.4.1-.2-.1-.9-.3-1.6-1a6 6 0 0 1-1.1-1.4c-.1-.2 0-.3.1-.4l.3-.4.2-.3v-.4l-.6-1.4c-.1-.4-.3-.3-.4-.3z" />
          </svg>
              Auf WhatsApp schreiben
            </ShimmerCta>
          </div>

          <p class="hero-notiz">{cta.primary.note}</p>
        </div>

      </div>

      <div class="hero-geraet">
        {/* Das Karussell nach der Vorlage: drei Telefone, das aktive vorn,
            die anderen seitlich zurueckgedreht, Pfeile schalten durch.
            In jedem laeuft ein anderer Verlauf der Assistenz.

            OHNE BILDUNTERSCHRIFT. Dort stand „Schematische Darstellung" --
            eine Vokabel aus einem technischen Datenblatt, direkt unter der
            Stelle, an der die Seite ihre Sache vorfuehrt. */}
        <Telefonkarussell
          kennung="hero-karussell"
          gespraeche={empfangGespraeche}
        />

        {/* HIER STAND EIN ERKLAERSATZ ÜBER ZWEI ZEILEN, der den Leser auf
            die Uhrzeiten hinwies. Wer erst erklaeren muss, worauf man
            achten soll, hat die Vorfuehrung nicht gebaut, sondern
            beschrieben.

            Jetzt ein Statusabzeichen, wie man es aus Messengern kennt:
            gruener Punkt, kurze Zeile. Es sagt dasselbe in vier Woertern
            und sieht dabei aus wie das, was es behauptet. Die Uhrzeiten in
            den Verlaeufen belegen es von selbst. */}
        <p class="hero-status">
          <span class="hero-puls" aria-hidden="true"></span>
          Assistenz aktiv · antwortet zu jeder Uhrzeit
        </p>

        {/* Bleibt trotzdem stehen: die Verlaeufe sind nachgestellt, und das
            muss dranstehen. Nur so klein, wie ein Hinweis sein darf. */}
        <p class="hero-fein">Beispielverläufe aus einem Betriebsalltag</p>
      </div>
    </div>
  </section>

  {/* ===================== Wo es klemmt ===================== */}
  <Band
    ton="gedaempft"
    kennung="Wo es klemmt"
    heading="Der Auftrag geht an den, der zuerst erreichbar war"
    intro="Nicht an den Besseren. Für einen Betrieb, in dem der Inhaber mitarbeitet, ist das eine unfaire Ausgangslage. Genau die lässt sich abstellen."
  >
    {/* Kopfzeile ueber den drei Zeilen. Sie benennt einmal, was links und
        was rechts steht -- danach muss man in keiner Zeile mehr suchen.
        Nur am Rechner: auf dem Handy stehen die beiden Teile ohnehin
        untereinander und tragen ihre eigene Beschriftung. */}
    <div class="klemmt-kopf" aria-hidden="true">
      <span>Das passiert</span>
      <span>Das kommt dabei heraus</span>
    </div>

    <ol class="klemmt">
      {
        verluste.map((v, i) => (
          <li class="klemme einblenden" style={`--verzug:${i};--farbe:${v.farbe}`}>
            <span class="klemme-zeichen" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <path d={v.zeichen} />
              </svg>
            </span>

            <div class="klemme-lage">
              <p class="klemme-titel">{v.titel}</p>
              <p class="klemme-text">{v.lage}</p>
            </div>

            {/* Der Pfeil ist das ganze Argument des Abschnitts in einem
                Zeichen: aus dem einen folgt das andere. Auf dem Handy
                zeigt er nach unten, weil dort die Leserichtung dorthin
                geht -- gedreht wird er per CSS, nicht per zweitem SVG. */}
            <span class="klemme-pfeil" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12h14M14 7l5 5-5 5" />
              </svg>
            </span>

            <p class="klemme-folge">{v.folge}</p>
          </li>
        ))
      }
    </ol>

    {/* Der Satz, auf den die drei Zeilen hinauslaufen. Ohne ihn bleibt es
        eine Aufzaehlung von Aergernissen; mit ihm ist es eine Diagnose. */}
    <p class="klemmt-fazit">
      Dreimal war die Anfrage da. Dreimal kam sie nicht bei Ihnen an.
    </p>
  </Band>

  {/* ===================== Die vier Leistungen ===================== */}
  <Band
    ton="hell"
    kennung="Leistungen"
    heading="Vier Bausteine, einzeln oder zusammen"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo im Alltag gerade am meisten liegen bleibt."
  >
    <ul class="leistungen">
      {
        services.map((service) => (
          <li
            class:list={['kachel', `kachel-${service.slug}`, 'einblenden']}
            style={`--farbe:${service.color}`}
          >
            <a class="kachel-link" href={service.href}>
              <span class="kachel-zeichen" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d={kachelZeichen[service.slug]} />
                </svg>
              </span>

              <span class="kachel-inhalt">
                <span class="kachel-label kennung">{service.label}</span>
                <span class="kachel-nutzen">{service.benefit}</span>
                <span class="kachel-teaser">{service.teaser}</span>
                {service.slug === 'automatisierung' && (
                  <span class="kachel-chip">{automationModules.length} einsatzbereite Module</span>
                )}
              </span>

              <span class="kachel-pfeil" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h11M11 6l4 4-4 4" />
                </svg>
              </span>

            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Was hereinkommt ===================== */}
  <Band
    ton="hell"
    kennung="Ein Vormittag"
    heading="So sieht ein Vormittag mit Assistenz aus"
    intro="Drei Anfragen, alle beantwortet, keine liegen geblieben. Sie waren in der Zeit bei Ihren Kunden."
  >
    <Vormittag
      ereignisse={vormittag}
      bilanz="3 von 3 beantwortet · 3 Termine im Kalender · 0 verloren"
    />

    {/* Ein Aufruf an der Stelle, an der der Beweis gerade gelaufen ist.
        Vorher standen die Aufrufe nur ganz oben und ganz unten, dazwischen
        lagen 500 Woerter ohne einen einzigen Weg zur Handlung. Wer hier
        ueberzeugt ist, soll nicht erst bis zum Fuss scrollen muessen. */}
    <div class="zwischenruf">
      <p class="zwischenruf-satz">
        So sähe ein Vormittag in Ihrem Betrieb aus. In 15 Minuten schauen wir,
        welcher der drei Wege bei Ihnen gerade die meisten Anfragen liegen lässt.
      </p>
      <ShimmerCta href={cta.primary.href} size="lg">{cta.primary.label}</ShimmerCta>
    </div>
  </Band>

  {/* ===================== Der Mensch dahinter =====================
      NEU GEBAUT. Vorher stand hier eine Überschrift („Erst Baustelle,
      dann Bildschirm"), darunter ein Absatz, dann das Zitat, dann noch
      ein Absatz, dann eine nummerierte Liste 01/02/03 und zuletzt ein
      Link. Sechs Dinge untereinander, von denen jedes um dieselbe
      Aufmerksamkeit bat -- und die eine Aussage, die diesen Abschnitt
      trägt, saß in der Mitte davon eingeklemmt.

      Jetzt gibt es genau EINEN großen Satz, und der ist zugleich die
      Überschrift des Abschnitts. Er steht in der Serif der Marke, weil
      genau diese Form hier funktioniert. Darunter zwei kurze Absätze,
      die ihn belegen, und ein Weg zur langen Fassung.

      Die Ziffernliste ist ersatzlos weg. Nummeriert wird, was eine
      Reihenfolge hat; drei Eigenschaften haben keine. */}
  <Band ton="gedaempft" textur="punkte" kennung="Der Mensch dahinter">
    <div class="mensch">
      <div class="mensch-buehne hereinziehen">
        <div class="mensch-ring" aria-hidden="true"></div>
        <Portrait
          rund
          class="mensch-foto"
          alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`}
        />
        <p class="mensch-schild">
          <span class="mensch-schild-name">{owner.fullName}</span>
          <span class="mensch-schild-rolle">Inhaber, Elvora</span>
        </p>
      </div>

      <div class="mensch-text">
        {/* Zugleich Überschrift und Kernaussage. Als eigenes Zitat UNTER
            einer Überschrift standen hier zwei große Sätze übereinander,
            die sich gegenseitig die Wirkung nahmen. */}
        <h2 class="mensch-satz">
          Wer das Angebot macht, macht auch die Arbeit{' '}
          <em>und geht ans Telefon.</em>
        </h2>

        <p>
          Bei Elvora gibt es keine Projektnummer und keine Weiterleitung.
          Ich baue Ihre Website, ich richte die Assistenz ein, und wenn in
          einem halben Jahr etwas anders soll, schreiben Sie wieder mir.
        </p>

        <p>
          Ich weiß, wie ein Arbeitstag aussieht, an dem das Telefon immer
          im falschen Moment klingelt. Deshalb baue ich nichts, was Sie
          abends noch bedienen müssen.
        </p>

        <a class="mensch-weiter" href="/ueber-mich/">
          Mehr über mich
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 6l4 4-4 4" />
          </svg>
        </a>
      </div>
    </div>
  </Band>

  {/* ===================== Bewertungen ===================== */}
  {
    reviews.enabled && reviews.items.length > 0 && (
      <Band
        ton="gedaempft"
        kennung="Bewertungen"
        heading="Was Betriebe hinterher sagen"
      >
        {/* Der Abschnitt trug bisher keinen Hinweis: die Marke sass nur am
            Bewertungsbeleg. Solange die Stimmen erfunden sind, muss sie
            auch hier stehen -- und zwar unabhaengig davon, ob die Texte
            zufaellig noch mit „Platzhalter:" anfangen. */}
        {reviews.platzhalter && (
          <p class="stimmen-warnung">
            <span class="platzhalter-marke">Beispieldaten</span>
            <span>
              Erfundene Stimmen zur Beurteilung der Gestaltung. Vor dem
              Livegang durch echte Rückmeldungen ersetzen.
            </span>
          </p>
        )}

        <ul class="stimmen">
          {reviews.items.map((stimme, i) => (
            <li class="stimme einblenden" style={`--verzug:${i}`}>
              <Sterne wert={stimme.rating} groesse={1} />
              <p class="stimme-text">{stimme.text}</p>
              <p class="stimme-quelle">
                <span class="stimme-name">{stimme.author}</span>
                {stimme.business && <span class="stimme-betrieb">{stimme.business}</span>}
              </p>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {/* ===================== Abschluss =====================
      WARUM NICHT MEHR DUNKEL UND NICHT MEHR ZWEISPALTIG

      Die Flaeche war die einzige dunkle der Seite und sollte genau deshalb
      auffallen. Sie fiel auch auf, nur half das nichts: der Knopf steht in
      der Akzentfarbe, und Magenta auf Anthrazit hat weniger Zug als
      Magenta auf hellem Grund. Die auffaelligste Flaeche der Seite machte
      damit ausgerechnet das Wichtigste darauf leiser.

      Dazu standen hier fuenf Angebote nebeneinander: der Knopf rechts,
      vier gleichrangige Kontaktwege links. Wer die Wahl zwischen fuenf
      Dingen hat, trifft keine.

      Jetzt eine Spalte, mittig, mit genau EINEM grossen Knopf. Die
      Zusagen stehen als ruhige Zeile darunter, die anderen Kontaktwege
      als eine einzige Zeile Text ganz zuletzt -- erreichbar fuer den, der
      sie sucht, aber ohne mit dem Termin zu konkurrieren.

      Der Verlauf hinter dem Knopf ist Zierde und traegt keinen Text. Auf
      Verlaeufen steht auf dieser Seite nie welcher, sie erfuellen keine
      Kontrastanforderung. */}
  <Band
    ton="gedaempft"
    kennung="Loslegen"
    heading="Klingt das nach Ihrem Betrieb?"
    mitte
  >
    <div class="schluss">
      {/* Kurz gehalten. An der Stelle, an der jemand klickt oder weggeht,
          liest niemand mehr drei Sätze -- jeder weitere Satz ist eine
          weitere Gelegenheit, es sich anders zu überlegen. Der Satz über
          das ehrliche Nein bleibt trotzdem: er nimmt die Angst vor dem
          Verkaufsgespräch, und genau die hält Leute vom Klicken ab. */}
      <p class="schluss-satz">
        Erzählen Sie mir, wie Ihr Betrieb gerade arbeitet. Ich sage Ihnen,
        was sich davon automatisieren lässt — und was nicht.
      </p>

      {/* OHNE DEN LAUFENDEN RING. Der Ring war bisher das Zeichen, dass
          DIESER Aufruf der wichtigste der Seite ist. Das uebernimmt jetzt
          der Knopf selbst: er ist der einzige, der sich zerreisst, und
          zwei Aufmerksamkeitsmittel auf einem Element heben sich
          gegenseitig auf. */}
      <div class="schluss-knopf">
        <ShimmerCta href={cta.primary.href} size="lg" class="schluss-cta">
          {cta.primary.label}
        </ShimmerCta>
      </div>

      {/* HIER STANDEN „15 MINUTEN · UNVERBINDLICH · OHNE VERKAUFSGESPRÄCH".
          Drei Wörter in Versalien, die auf jeder zweiten Seite im Netz
          genauso unter dem Knopf stehen. Sie beruhigen niemanden mehr,
          weil sie niemand mehr liest.

          An derselben Stelle steht jetzt derselbe Zusatz wie im Aufschlag:
          was NACH dem Gespräch anders ist. Bewusst dieselbe Zeile an
          beiden Enden der Seite -- wer oben nicht geklickt hat, findet
          unten kein neues Versprechen vor, sondern dasselbe. */}
      <p class="schluss-notiz">{cta.primary.note}</p>

      <p class="schluss-direkt">
        Lieber sofort schreiben oder anrufen?
        <a href={contactLinks.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <span aria-hidden="true">·</span>
        <a href={contactLinks.tel}>Telefon</a>
        <span aria-hidden="true">·</span>
        <a href={contactLinks.mail}>E-Mail</a>
      </p>
    </div>
  </Band>
</Base>

<style>
  /* ===================== Aufschlag ===================== */
  .hero {
    background: var(--color-surface);
    /* Die hinteren Telefone des Karussells stehen seitlich ueber. `clip`
       statt `hidden`: hidden macht aus dem Hero einen Scrollbereich. */
    overflow-x: clip;
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }

  /* Zwei Spalten erst, wenn beides nebeneinander wirklich Platz hat. Frueher
     waere das Geraet ein Streifen und die Zeile im Text vier Woerter breit. */
  @media (width >= 64rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.125rem, 2vw, 1.5rem);
  }

  .hero-kennung {
    margin: 0;
    color: var(--color-ink-faint);
  }

  /* Die Groesse traegt hier alles. Instrument Serif hat keinen Fettschnitt,
     die Wirkung kommt aus Mass und Satz.

     Kleiner als in der einspaltigen Fassung: neben dem Geraet steht weniger
     Breite zur Verfuegung, und der Aufruf muss ohne Scrollen zu sehen sein. */
  .hero-schlag {
    margin: 0;
    font-size: clamp(2.375rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    /* Etwas mehr als vorher: die Buchstaben der Textrolle sind eigene
       Kaestchen, dadurch bauen die Woerter minimal breiter und der Satz
       brach eine Zeile zu frueh um. */
    max-width: 18ch;
  }

  /* Ein einziges Wort kursiv und in der Markenfarbe. Instrument Serif hat
     einen sehr schoenen Kursivschnitt, und ein Akzent wirkt nur, wenn er
     allein steht. Ausgezeichnet wird es in der Textrolle ueber `betont`. */

  .hero-intro {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Der Handlungsblock hat einen eigenen, GROESSEREN Abstand nach oben als
     die Zeilen darueber und einen sehr kleinen nach innen. Damit steht er
     als eigene Einheit da, statt als vierter Absatz in einer Reihe von
     Absaetzen. Gleiche Abstaende ueberall heissen: nichts gehoert
     zusammen. */
  .hero-block {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .hero-handlung {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* HIER STAND EIN SCHEIN IN DER MARKENFARBE UNTER DEM KNOPF.
     Der Aufruf bringt seinen Schatten jetzt selbst mit, und er zieht den
     Blick ueber Bewegung statt ueber ein Leuchten. Zwei
     Aufmerksamkeitsmittel auf einem Element heben sich gegenseitig auf:
     man sieht dann beides und keines richtig. */

  /* HIER STANDEN 40 ZEILEN FUER EINEN EIGENEN WHATSAPP-KNOPF:
     Umriss, gruenes Zeichen, eigene Hoehe, eigene Rueckmeldung. Er ist
     demselben Aufruf gewichen wie jeder andere Knopf der Seite. */

  /* Untereinander, sobald die beiden Knoepfe nebeneinander nicht mehr in
     eine Zeile passen. Beide dann ueber die volle Breite -- ein voller
     und ein textbreiter Knopf untereinander sieht nach Versehen aus. */
  @media (width < 40rem) {
    .hero-handlung {
      flex-direction: column;
      align-items: stretch;
    }
    /* Der Aufruf zieht sich unter 40rem von selbst auf volle Breite, das
       steht in `GlitchCta.astro`. Hier fehlt er deshalb. */
    .hero-whatsapp {
      width: 100%;
    }
  }

  /* Klein, aber nicht blass: der Zusatz ist die letzte Zeile vor dem Klick
     und darf nicht unter der Wahrnehmungsschwelle liegen. */
  .hero-notiz {
    margin: 0;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid var(--color-border-strong);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* --- Die Vorfuehrung im ersten Sichtbereich --------------------------- */
  .hero-geraet {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }

  /* Statusabzeichen statt Erklaersatz. Die Form ist bewusst die eines
     Online-Hinweises aus einem Messenger -- sie wird gelesen, bevor sie
     entziffert wird. */
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid color-mix(in oklab, #25d366 30%, var(--color-border));
    border-radius: 999px;
    background: color-mix(in oklab, #25d366 8%, var(--color-surface));
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .hero-puls {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: #1eb257;
  }

  /* Der Ring geht nach aussen und verblasst -- derselbe Ausdruck wie ein
     Aufnahme- oder Online-Punkt. Nur einmal auf der Seite, und nur so
     gross, dass er die Zeile nicht auseinanderdrueckt. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-puls::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: #1eb257;
      animation: hero-pulsen 2.4s ease-out infinite;
    }
  }

  @keyframes hero-pulsen {
    0% { transform: scale(1); opacity: 0.55; }
    70% { transform: scale(2.6); opacity: 0; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .hero-fein {
    margin: 0;
    font-size: 0.75rem;
    text-align: center;
    color: var(--color-ink-faint);
  }

  /* FRUEHER STAND HIER `align-items: flex-end` UND `text-align: end`.
   *
   * Rechtsbuendiger Fliesstext hat links einen ausgefransten Rand; das
   * Auge findet den Zeilenanfang nicht und ueberspringt den Absatz. Fuer
   * drei Zeilen unter einer Vorfuehrung ist das der sichere Weg, dass sie
   * niemand liest.
   *
   * Die Spalte bleibt jetzt auch am Rechner mittig unter dem Geraet. */

  @media (prefers-reduced-motion: no-preference) {
    .hero-kennung,
    .hero-beleg,
    .hero-intro,
    .hero-block,
    .hero-geraet {
      animation: aufsteigen 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero-kennung { animation-delay: 0.05s; }
    /* Der Beleg kommt frueh, nicht zuletzt: er soll beim ersten Blick da
       sein und nicht nachtroepfeln. */
    .hero-beleg { animation-delay: 0.26s; }
    .hero-intro { animation-delay: 0.34s; }
    /* Knopf und Zusatz steigen GEMEINSAM auf. Getrennt animiert kamen sie
       nacheinander an und wirkten wieder wie zwei Dinge. */
    .hero-block { animation-delay: 0.42s; }
    .hero-geraet { animation-delay: 0.3s; }
  }

  @keyframes aufsteigen {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }

  /* ===================== Wo es klemmt =====================
     DREI ZEILEN STATT DREI KARTEN.

     Nebeneinander waren es drei gleich aussehende Kaesten, und in jedem
     stand ein Absatz. Man las den ersten und ueberflog den Rest.

     Untereinander mit fester Spaltenteilung wird die Wiederholung selbst
     zum Argument: Lage steht immer links, Folge immer rechts, dazwischen
     immer derselbe Pfeil. Nach der ersten Zeile weiss man, wie die
     naechste zu lesen ist, und braucht dafuer keine Sekunde mehr. */
  .klemmt-kopf {
    display: none;
  }

  .klemmt {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Die Zeile. Auf dem Handy gestapelt, am Rechner vierspaltig.
     `align-items: center` ueber alle vier Spalten: der Pfeil sitzt damit
     auf der Mitte der Zeile und nicht an ihrem Kopf. */
  .klemme {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--farbe) 20%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in oklab, var(--farbe) 6%, var(--color-surface));
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .klemme:hover {
    border-color: color-mix(in oklab, var(--farbe) 40%, transparent);
    box-shadow: 0 16px 34px -24px color-mix(in oklab, var(--farbe) 60%, transparent);
  }

  .klemme-zeichen {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.85rem;
    background: var(--farbe);
    color: #fff;
    box-shadow: 0 6px 16px -8px var(--farbe);
  }

  .klemme-zeichen svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .klemme-titel {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .klemme-text {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* Der Pfeil steht in der Farbe der Zeile, aber gedaempft: er fuehrt den
     Blick, er soll ihn nicht halten. */
  .klemme-pfeil {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in oklab, var(--farbe) 55%, transparent);
  }

  .klemme-pfeil svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* Die Folge steht in der Textfarbe der Seite, nicht gedaempft: sie ist
     der Satz, der wehtut, und der soll schwerer wiegen als die Lage
     davor. Die farbige Linie bindet sie an die Zeile. */
  .klemme-folge {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid color-mix(in oklab, var(--farbe) 45%, transparent);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* Auf dem Handy: Zeichen links, alles andere rechts darunter, der Pfeil
     zeigt nach unten. */
  @media (width < 52rem) {
    .klemme-lage,
    .klemme-pfeil,
    .klemme-folge {
      grid-column: 2;
    }

    .klemme-pfeil {
      justify-content: flex-start;
      rotate: 90deg;
      width: 1.75rem;
      margin-block: -0.25rem;
    }
  }

  @media (width >= 52rem) {
    .klemmt-kopf {
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.75rem minmax(0, 0.95fr);
      gap: 1.25rem;
      /* Deckungsgleich mit der Polsterung der Zeilen darunter, damit die
         Beschriftung wirklich ueber ihrer Spalte steht. */
      padding-inline: 1.5rem;
      margin-block-end: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-ink-faint);
    }

    .klemmt-kopf span:first-child {
      grid-column: 2;
    }

    .klemmt-kopf span:last-child {
      grid-column: 4;
    }

    .klemme {
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.75rem minmax(0, 0.95fr);
      align-items: center;
      gap: 1.25rem;
      padding-block: 1.375rem;
    }
  }

  .klemmt-fazit {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* Die grosse Ziffer laeuft unten aus der Karte heraus. Zier, kein
     Inhalt: die Zaehlung steckt schon in der Reihenfolge. */
  /* ===================== Leistungen =====================
     Bento-Raster: die KI-Automatisierung als grosse Kachel, Webdesign und
     SEO gestapelt daneben, Branding als breite Kachel darunter. Jede
     Kachel ist eine satte Farbflaeche in ihrer Leistungsfarbe, mit
     Zeichen, Wasserzeichen-Ziffer und Pfeil. Vorher: vier fast gleiche
     Zeilen untereinander, die als Wand gelesen und uebersprungen wurden. */
  .leistungen {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 60rem) {
    .leistungen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'gross klein1'
        'gross klein2'
        'breit breit';
    }

    .kachel-automatisierung { grid-area: gross; }
    .kachel-webdesign { grid-area: klein1; }
    .kachel-seo { grid-area: klein2; }
    .kachel-branding { grid-area: breit; }
  }

  .kachel {
    display: grid;
  }

  /* Auf dem Handy liegen die Kacheln in Quelltextreihenfolge, die
     Automatisierung stuende damit ganz unten. Im Raster daneben ist sie
     die grosse Flaeche oben links und wird als Erstes gelesen. Also
     bekommt sie auch schmal den ersten Platz. */
  @media (width < 60rem) {
    .kachel-automatisierung {
      order: -1;
    }
  }

  .kachel-link {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 15rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: 1.5rem;
    /* Die Farbflaeche: satter Verlauf aus der Leistungsfarbe, nach unten
       rechts leicht abgedunkelt, damit die Flaeche nicht wie Plastik
       wirkt. Text durchgehend Weiss; alle vier Farben halten mit Weiss
       die 4,5:1, sie wurden dafuer ausgesucht. */
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--farbe) 92%, #fff),
      var(--farbe) 55%,
      color-mix(in oklab, var(--farbe) 82%, #000)
    );
    color: #fff;
    text-decoration: none;
    box-shadow: 0 14px 34px -20px var(--farbe);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s;
  }

  .kachel-link:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 48px -22px var(--farbe);
  }

  /* Die grosse Kachel bekommt mehr Hoehe und die groesste Schrift: sie
     ist das Zugpferd. */
  .kachel-automatisierung .kachel-link {
    min-height: clamp(24rem, 44vw, 32rem);
  }

  .kachel-zeichen {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .kachel-zeichen svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .kachel-inhalt {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-block-start: auto;
    padding-block-start: 1.5rem;
    max-width: 34rem;
  }

  .kachel-label {
    color: rgb(255 255 255 / 0.75);
  }

  .kachel-nutzen {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.3vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .kachel-automatisierung .kachel-nutzen {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .kachel-teaser {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.82);
  }

  /* Auf den kleinen Kacheln bleibt die Erklaerung weg, dort tragen Farbe
     und Nutzenversprechen. Sie steht eine Ebene tiefer ohnehin. */
  .kachel-webdesign .kachel-teaser,
  .kachel-seo .kachel-teaser {
    display: none;
  }

  @media (width < 60rem) {
    .kachel-webdesign .kachel-teaser,
    .kachel-seo .kachel-teaser {
      display: block;
    }
  }

  .kachel-chip {
    width: fit-content;
    margin-block-start: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .kachel-pfeil {
    position: absolute;
    inset-block-start: clamp(1.5rem, 3vw, 2rem);
    inset-inline-end: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    color: #fff;
    transition: background 0.2s, transform 0.3s;
  }

  .kachel-pfeil svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .kachel-link:hover .kachel-pfeil {
    background: rgb(255 255 255 / 0.18);
    transform: rotate(-45deg);
  }

  /* Die Wasserzeichen-Ziffer, wie auf den Verlust-Karten: Zier, die die
     Flaeche fuellt, ohne Inhalt zu sein. */
  /* HIER STANDEN EINMAL RIESENZIFFERN.
   *
   * Halbdurchsichtig, unten rechts, mit `inset-block-end: -1.5rem`
   * absichtlich ueber die Kartenkante hinausgeschoben und dort
   * abgeschnitten. Gedacht als Zierde, gelesen als Fehler.
   *
   * Vor allem aber nummerierten sie nichts. Ueber diesem Raster steht
   * woertlich „Einzeln oder zusammen, in Ihrer Reihenfolge" -- und darauf
   * klebten Nummern, die eine feste Reihenfolge behaupten. Die Ziffer
   * widersprach dem Satz direkt darueber.
   *
   * Ziffern gibt es auf dieser Seite weiterhin, aber nur dort, wo sie
   * etwas nummerieren: unter „So laeuft es ab" und in der empfohlenen
