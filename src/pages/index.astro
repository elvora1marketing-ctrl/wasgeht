  .verlust-nummer {
    position: absolute;
    inset-inline-end: 0.5rem;
    inset-block-end: -1.4rem;
    font-size: 5.5rem;
    line-height: 1;
    color: color-mix(in oklab, var(--farbe) 16%, transparent);
    pointer-events: none;
  }

  /* ===================== Leistungen =====================
     Bento-Raster: die KI-Automatisierung als grosse Kachel, Webdesign und
     SEO gestapelt daneben, Branding als breite Kachel darunter. Jede
     Kachel ist eine satte Farbflaeche in ihrer Leistungsfarbe, mit
     Zeichen, Wasserzeichen-Ziffer und Pfeil. Vorher: vier fast gleiche
     Zeilen untereinander, die als Wand gelesen und uebersprungen wurden. */
  .leistungen {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
