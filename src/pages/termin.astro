---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import PanelHero from '~/components/PanelHero.astro';
import BookingEmbed from '~/components/BookingEmbed.astro';
import WhatsappCta from '~/components/WhatsappCta.astro';
import { booking, contact, contactLinks } from '~/config/site';

/** Was im Gespräch passiert, nimmt die Sorge vor dem Verkaufsanruf. */
const agenda = [
  'Sie schildern kurz, was in Ihrem Betrieb gerade Zeit frisst oder liegen bleibt.',
  'Ich sage Ihnen, ob und wie sich das lösen lässt, auch wenn die Antwort „nicht durch mich" lautet.',
  'Wenn es passt, skizziere ich einen ersten Weg. Wenn nicht, haben Sie trotzdem eine Einschätzung.',
];
---

<Base
 
  title="Erstgespräch vereinbaren"
  description="Termin bei Elvora aus Essen direkt online buchen: kurzes Gespräch darüber, was sich in Ihrem Betrieb automatisieren lässt."
  breadcrumbs={[{ label: 'Termin' }]}
>
  <PanelHero
    eyebrow="Erstgespräch"
    heading={`${booking.durationLabel}, die Ihnen Klarheit bringen`}
    intro="Kein Verkaufsgespräch, keine Vorbereitung nötig. Sie erzählen, wo es klemmt, und bekommen eine ehrliche Einschätzung. Auch dann, wenn ich Ihnen nicht helfen kann."
    color="#5c3491"
    breadcrumbs={[{ label: 'Termin' }]}
  />

  <Band ton="hell">
    <div class="termin-raster">
      <div class="termin-kalender">
        <BookingEmbed />
      </div>

      <div class="termin-ablauf">
        <h2 class="termin-titel">Was in den {booking.durationLabel} passiert</h2>
        <ol class="mt-6 flex flex-col gap-5">
          {
            agenda.map((item, index) => (
              <li class="flex gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft ziffern text-xs font-medium text-accent">
                  {index + 1}
                </span>
                <span class="text-[0.9375rem] text-ink-muted">{item}</span>
              </li>
            ))
          }
        </ol>

        <div class="termin-notfall">
          <h2 class="kennung termin-notfall-titel">Kein passender Termin dabei?</h2>
          <div class="mt-4 flex flex-col gap-3 text-[0.9375rem] text-ink-muted">
            <WhatsappCta variant="inline" class="text-ink-muted" />
            <p>
              Oder rufen Sie an:{' '}
              <a href={contactLinks.tel} class="text-ink underline underline-offset-4">
                {contact.phoneDisplay}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </Band>
</Base>

<style>
  .termin-raster {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  @media (width >= 64rem) {
    .termin-raster {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  .termin-titel {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .termin-notfall {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--color-border);
  }

  .termin-notfall-titel {
    margin: 0 0 1rem;
    color: var(--color-ink-faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .termin-kalender,
      .termin-ablauf {
        animation-name: auftauchen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 6% entry 45%;
      }
    }
  }
</style>
