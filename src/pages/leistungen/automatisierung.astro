---
import { Image } from 'astro:assets';
import Service from '~/layouts/Service.astro';
import Button from '~/components/Button.astro';
import ModuleVisual from '~/components/ModuleVisual.astro';
import Band from '~/components/Band.astro';
import Liste from '~/components/Liste.astro';
import Telefonkarussell from '~/components/Telefonkarussell.astro';
import { modulGespraechFolge } from '~/lib/modulchats';
import Geraet from '~/components/Geraet.astro';
import Iphone from '~/components/Iphone.astro';
import { automationModules, cta, serviceArea, versprechen } from '~/config/site';
import type { FaqItem } from '~/types';

/**
 * Beleg-Screenshots werden über die Ordnerstruktur zugeordnet:
 * eine Datei `src/assets/module/<slug>.png` erscheint automatisch beim
 * passenden Modul. Fehlt sie, bleibt das Modul schlicht ohne Bild.
 */
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/module/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const shotFor = (slug: string) => {
  const key = Object.keys(shots).find((path) =>
    path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug,
  );
  return key ? shots[key]!.default : null;
};

/**
 * Welcher Geräterahmen zu einem Modul passt. Die Übersichtsseite läuft am
 * Rechner, alles andere spielt sich auf dem Telefon ab.
 */
const rahmenArt = (slug: string): 'handy' | 'rechner' =>
  slug === 'dashboard' ? 'rechner' : 'handy';

const faq: FaqItem[] = [
  /* Steht bewusst AN ERSTER STELLE. Auf einer Seite ohne Preise ist das die
     Frage, die jeder zuerst stellt. Bleibt sie unbeantwortet, klickt ein
     Teil der Leute weg, statt zu fragen. Der Text kommt aus einer einzigen
     Stelle in `site.ts`, damit er auf allen vier Seiten gleich lautet. */
  {
    question: 'Was muss ich selbst dafür tun?',
    answer: versprechen.aufwand,
  },
  {
    question: 'Merken meine Kunden, dass da eine KI antwortet?',
    answer:
      'Es wird nicht verschleiert. Die Assistenz meldet sich sachlich, beantwortet was sie sicher beantworten kann, und reicht alles Weitere an Sie weiter. Erfahrungsgemäß ist Kunden eine sofortige Antwort deutlich lieber als ein Rückruf am nächsten Tag.',
  },
  {
    question: 'Was passiert, wenn die Assistenz etwas nicht weiß?',
    answer:
      'Dann rät sie nicht, sondern übergibt an Sie. Sie bekommen den Verlauf mitsamt allem, was bis dahin erfasst wurde, und steigen ohne Informationsverlust ein.',
  },
  {
    question: 'Muss ich meine Telefonnummer wechseln?',
    answer:
      'Nein. Die Module setzen auf Ihrer bestehenden Geschäftsnummer auf. Ihre Kunden merken keinen Unterschied, außer dass jetzt jemand erreichbar ist.',
  },
  {
    question: 'Wie lange dauert die Einrichtung?',
    answer:
      'Ein einzelnes Modul ist meist innerhalb weniger Tage aktiv. Wir starten in der Regel mit einem Modul, das sofort Wirkung zeigt, und bauen von dort aus weiter.',
  },
  {
    question: 'Muss ich alle Module nehmen?',
    answer:
      'Nein, das wäre auch selten sinnvoll. Wir schauen im Erstgespräch, wo bei Ihnen am meisten liegen bleibt, und fangen genau dort an.',
  },
  {
    question: 'Lässt sich das mit meiner vorhandenen Software verbinden?',
    answer:
      'In vielen Fällen ja: Kalender, Branchensoftware und Buchhaltung lassen sich häufig anbinden. Ob es in Ihrem Fall geht, klären wir konkret anhand der Programme, die Sie einsetzen.',
  },
];

/** Der wiederkehrende Ablauf, den ein Betrieb heute noch von Hand macht. */
const painPoints = [
  {
    problem: 'Das Telefon klingelt, während Sie mitten in der Arbeit sind.',
    result: 'Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
  },
  {
    problem: 'Abends liegen zwölf WhatsApp-Nachrichten und vier Rückrufwünsche vor.',
    result: 'Sie arbeiten sie nach Feierabend ab, oder eben nicht.',
  },
  {
    problem: 'Ein zufriedener Kunde würde Sie gern bewerten.',
    result: 'Sie vergessen zu fragen. Die Bewertung kommt nie.',
  },
];
---

<Service
  slug="automatisierung"
  label="KI-Prozessautomatisierung"
  benefit="Kein verpasster Anruf, kein Angebot, das liegen bleibt"
  intro="Sieben einsatzbereite Module, die Anfragen annehmen, beantworten und nachfassen, während Sie bei Ihren Kunden sind. Aufgebaut für kleine Betriebe, nicht für Konzerne."
  title="KI-Automatisierung für Betriebe in Essen"
  description="Verpasste Anrufe auffangen, Anfragen automatisch beantworten, Termine buchen lassen und Bewertungen einsammeln. Einsatzbereite Module für Betriebe und Selbstständige in Essen und im Ruhrgebiet."
  faq={faq}
>
  {/* ===================== Das Problem ===================== */}
  <Band
    ton="hell"
    kennung="Wo es klemmt"
    heading="Der Auftrag geht selten an den Besseren"
    intro="Er geht an den, der zuerst erreichbar war. Für einen Betrieb, in dem der Inhaber mitarbeitet, ist das eine unfaire Ausgangslage, und genau die lässt sich abstellen."
  >
    <div class="problem">
      <Liste
        eintraege={painPoints.map((p) => ({ titel: p.problem, text: p.result }))}
        anordnung="reihen"
        class="problem-liste"
      />

      {/* Was stattdessen passiert: die drei Chat-Module bei der Arbeit,
          im selben Karussell wie auf Startseite und Kontaktseite. Die
          Verlaeufe sind dieselben wie in den Modulzeilen weiter unten,
          aus EINER Quelle in lib/modulchats. */}
      <Telefonkarussell
        kennung="module-karussell"
        gespraeche={modulGespraechFolge}
        bildunterschrift="Schematische Darstellung"
        breite="14.5rem"
        class="problem-stapel"
      />
    </div>
  </Band>

  {/* ===================== Die Module ===================== */}
  <Band
    ton="gedaempft"
    kennung="Die Module"
    heading="Sieben Module, die bereits laufen"
    intro="Nichts davon ist ein Konzept oder eine Absichtserklärung. Alles hier ist im Einsatz und lässt sich für Ihren Betrieb einrichten."
  >
    <ol class="module-liste">
      {
        automationModules.map((module, index) => {
          const shot = shotFor(module.slug);
          /* Bild und Text wechseln die Seite, damit die Liste nicht
             monoton wird. */
          const flip = index % 2 === 1;

          return (
            <li id={module.slug} class="modul" style={`--rang:${index}`}>
              <div class:list={['modul-text', flip && 'modul-text-rechts']}>
                <p class="modul-kennung kennung">
                  <span class="modul-ziffer ziffern">{String(index + 1).padStart(2, '0')}</span>
                  {module.name}
                </p>
                <h3 class="modul-schlag">{module.benefit}</h3>
                <p class="modul-satz">{module.text}</p>
              </div>

              {/* Der Rahmen sagt: das laeuft auf einem Geraet. Was DARIN
                  steht, sagt die Beschriftung darunter. Eine echte Aufnahme
                  traegt "Aus dem laufenden Betrieb", eine Zeichnung traegt
                  "Schematische Darstellung" -- damit wird aus der Zeichnung
                  kein erfundener Beleg. */}
              <div class:list={['modul-bild', flip && 'modul-bild-links']}>
                {rahmenArt(module.slug) === 'handy' ? (
                  <Iphone bildunterschrift={shot ? 'Aus dem laufenden Betrieb' : 'Schematische Darstellung'} breite="16rem">
                    {shot ? (
                      <Image src={shot} alt={module.screenshotAlt} widths={[400, 800]} loading="lazy" class="w-full" />
                    ) : (
                      <ModuleVisual slug={module.slug} />
                    )}
                  </Iphone>
                ) : (
                  <Geraet art="rechner" bildunterschrift={shot ? 'Aus dem laufenden Betrieb' : 'Schematische Darstellung'}>
                    {shot ? (
                      <Image src={shot} alt={module.screenshotAlt} widths={[400, 800]} loading="lazy" class="w-full" />
                    ) : (
                      <ModuleVisual slug={module.slug} />
                    )}
                  </Geraet>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </Band>

  {/* ===================== Individuelle Automatisierung ===================== */}
  <Band
    ton="gedaempft"
    kennung="Alles andere"
    heading="Und wenn Ihr Zeitfresser nicht dabei ist?"
  >
    <div class="individuell">
      <div class="individuell-text">
        <p>
          Die sieben Module sind die, die fertig stehen. Vieles andere lässt sich
          genauso automatisieren: Angebote und Rechnungen, Materialbestellungen,
          Erinnerungen an Kunden, die Anbindung an Ihre vorhandene Software.
        </p>
        <p>
          Beschreiben Sie einfach, was in Ihrem Betrieb gerade die meiste Zeit
          frisst. Wir prüfen gemeinsam, ob es sich lösen lässt. Wenn nicht, sage
          ich Ihnen das auch.
        </p>
      </div>

      <div class="individuell-handlung">
        <Button href={cta.primary.href} size="lg" magnet class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="individuell-notiz">{cta.primary.note}</p>
        <p class="individuell-notiz">
          Eingerichtet für Betriebe in {serviceArea.display}.
        </p>
      </div>
    </div>
  </Band>

</Service>

<style>
  /* --- Problemabschnitt -------------------------------------------------- */
  .problem {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (width >= 64rem) {
    .problem {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    }
  }

  /* --- Die Modulliste ---------------------------------------------------- */
  .module-liste {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 9vw, 7rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .modul {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  @media (width >= 48rem) {
    .modul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    /* Bild und Text wechseln die Seite, damit die Liste nicht monoton wird. */
    .modul-text-rechts {
      order: 2;
    }

    .modul-bild-links {
      order: 1;
    }
  }

  .modul-kennung {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-accent);
  }

  .modul-ziffer {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  .modul-schlag {
    margin: 0.875rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .modul-satz {
    margin: 0.875rem 0 0;
    max-width: 40ch;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .modul-bild {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .modul-text {
        animation-name: auftauchen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% entry 55%;
      }

      .modul-bild {
        animation-name: heranruecken;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 12% entry 62%;
      }
    }
  }

  /* --- Individuelle Automatisierung -------------------------------------- */
  .individuell {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  @media (width >= 64rem) {
    .individuell {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .individuell-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 54ch;
  }

  .individuell-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .individuell-handlung {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .individuell-notiz {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }
</style>
