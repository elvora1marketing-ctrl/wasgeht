---
import Service from '~/layouts/Service.astro';
import Band from '~/components/Band.astro';
import Liste from '~/components/Liste.astro';
import CheckList from '~/components/CheckList.astro';
import { serviceArea, versprechen } from '~/config/site';
import type { FaqItem } from '~/types';

/** Die Punkte neben dem Fliesstext im ersten Abschnitt. */
const lagepunkte = [
  { titel: "Auf der Straße", text: "Ihr Transporter steht stundenlang vor dem Haus. Werbung, für die Sie nichts extra zahlen, sofern man lesen kann, was Sie machen." },
  { titel: "Auf dem Küchentisch", text: "Ihr Angebot wird mit zwei anderen verglichen, oft von jemandem, der nur den Preis beurteilen kann." },
  { titel: "In der Hand", text: "Die Visitenkarte, die im Sicherungskasten hängen bleibt, wird in zwei Jahren wieder hervorgeholt. Oder eben nicht." },
];

const faq: FaqItem[] = [
  /* Steht bewusst AN ERSTER STELLE. Auf einer Seite ohne Preise ist das die
     Frage, die jeder zuerst stellt. Bleibt sie unbeantwortet, klickt ein
     Teil der Leute weg, statt zu fragen. Der Text kommt aus einer einzigen
     Stelle in `site.ts`, damit er auf allen vier Seiten gleich lautet. */
  {
    question: 'Was muss ich selbst dafür tun?',
    answer: versprechen.aufwand,
  },
  {
    question: 'Ich habe schon ein Logo. Muss das weg?',
    answer:
      'Meistens nicht. Oft fehlt nicht das Logo, sondern alles drumherum: feste Farben, eine Schrift, saubere Dateien in den Formaten, die Druckerei und Beschrifter brauchen. Wenn das Logo trägt, bauen wir darauf auf.',
  },
  {
    question: 'Bekomme ich die Dateien, oder hängen die bei Ihnen fest?',
    answer:
      'Sie bekommen alles: das Logo in allen gängigen Formaten, die Farbwerte für Bildschirm und Druck, die Schriften und die offenen Druckdaten. Damit kann jede Druckerei und jeder Beschrifter arbeiten, auch ohne mich.',
  },
  {
    question: 'Übernehmen Sie auch den Druck?',
    answer:
      'Ich erstelle die Druckdaten und arbeite auf Wunsch direkt mit Ihrer Druckerei oder Ihrem Fahrzeugbeschrifter zusammen. Der Auftrag läuft dabei über Sie, so bleiben Sie unabhängig und zahlen keinen Aufschlag.',
  },
  {
    question: 'Lohnt sich das für einen kleinen Betrieb?',
    answer:
      'Der Auftritt entscheidet mit darüber, welche Preise Sie durchsetzen können. Zwei Betriebe mit gleicher Arbeit, aber einer wirkt sortiert und der andere zusammengewürfelt: geglaubt wird dem, der sortiert wirkt. Das ist der ganze Punkt.',
  },
];

const included = [
  'Logo, entweder neu entwickelt oder Ihr vorhandenes sauber aufgearbeitet',
  'Feste Farben und Schriften, damit alles zusammenpasst',
  'Alle Dateiformate für Bildschirm, Druck und Beschriftung',
  'Geschäftsausstattung: Visitenkarte, Briefbogen, Stempelvorlage',
  'Beschriftung für Fahrzeug, Schaufenster oder Praxisschild',
  'Angebots- und Rechnungsvorlage im gleichen Erscheinungsbild',
  'Schilder und Aufkleber, wenn Sie vor Ort sichtbar sind',
  'Kurze Anleitung, damit auch andere die Vorlagen richtig verwenden',
];

const steps = [
  {
    title: 'Standortbestimmung',
    text: 'Was gibt es schon, was funktioniert davon, und wofür soll Ihr Betrieb stehen.',
  },
  {
    title: 'Entwurf',
    text: 'Sie sehen Entwürfe im echten Umfeld: auf dem Transporter, auf dem Angebot, nicht auf weißem Grund.',
  },
  {
    title: 'Ausarbeitung',
    text: 'Der gewählte Weg wird durchgezogen: alle Formate, alle Vorlagen, alle Anwendungen.',
  },
  {
    title: 'Übergabe',
    text: 'Sie bekommen sämtliche Dateien und eine Anleitung. Auf Wunsch begleite ich den ersten Druck.',
  },
];
---

<Service
  slug="branding"
  label="Branding & Print"
  benefit="Ein Auftritt, der nach Fachbetrieb aussieht, nicht nach Nebenerwerb"
  intro="Ihr Auftritt begegnet Kunden den ganzen Tag, Ihr Angebot landet neben zwei anderen auf dem Tisch. Beides entscheidet mit, wen man nimmt."
  title="Branding und Printdesign für Betriebe in Essen"
  description="Logo, Geschäftsausstattung, Drucksachen und Angebotsvorlagen für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Alle Dateien gehören Ihnen."
  faq={faq}
>
  {/* ===================== Warum es zählt ===================== */}
  <Band ton="hell" kennung="Wo es klemmt" heading="Ihr Angebot liegt neben zwei anderen">
    <div class="lage">
      <div class="lage-text">
        <p>Der Kunde kann Ihre Arbeit nicht beurteilen, noch nicht. Er hat drei Angebote vor sich und sucht nach Anhaltspunkten, wem er trauen kann. Also achtet er auf das, was er beurteilen kann: Wirkt das sortiert? Passt das zusammen? Macht das den Eindruck eines Betriebs, der seine Sachen im Griff hat?</p>
        <p>Ein Angebot aus einer Textverarbeitung, ein Fahrzeug mit aufgeklebter Handynummer und eine Visitenkarte in einer anderen Schrift senden dieselbe Botschaft, auch wenn Ihre Arbeit die beste von den dreien ist.</p>
      </div>

      <div class="lage-liste">
        <h3 class="lage-titel">Wo Ihr Betrieb täglich gesehen wird</h3>
        <Liste eintraege={lagepunkte} anordnung="reihen" ziffern={false} />
      </div>
    </div>
  </Band>

  {/* ===================== Leistungsumfang ===================== */}
  <Band ton="gedaempft" kennung="Leistungsumfang" heading="Was drin ist"
    intro="Nicht nur ein Logo, sondern alles, was Sie im Alltag tatsächlich in die Hand nehmen.">
    <CheckList items={included} />
  </Band>

  {/* ===================== Ablauf ===================== */}
  <Band ton="gedaempft" kennung="Ablauf" heading="So läuft es ab"
    intro="Sie sehen früh etwas Greifbares und entscheiden anhand von echten Anwendungen, nicht anhand von Entwürfen auf weißem Grund.">
    <Liste
      eintraege={steps.map((s) => ({ titel: s.title, text: s.text }))}
      anordnung="spalten"
      geordnet
    />

    <p class="gebiet">Umgesetzt für Betriebe in {serviceArea.display}.</p>
  </Band>
</Service>

<style>
  .lage {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (width >= 64rem) {
    .lage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    }
  }

  .lage-text {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 52ch;
  }

  .lage-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .lage-titel {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .gebiet {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }
</style>
