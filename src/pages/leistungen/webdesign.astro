---
import Service from '~/layouts/Service.astro';
import Band from '~/components/Band.astro';
import Liste from '~/components/Liste.astro';
import CheckList from '~/components/CheckList.astro';
import { serviceArea, versprechen } from '~/config/site';
import type { FaqItem } from '~/types';

/** Die Punkte neben dem Fliesstext im ersten Abschnitt. */
const lagepunkte = [
  { titel: "Nummer nicht anklickbar", text: "Wer sie abtippen muss, ruft oft gar nicht erst an." },
  { titel: "Auf dem Handy zu langsam", text: "Jede zusätzliche Sekunde kostet spürbar Anfragen." },
  { titel: "Einzugsgebiet fehlt", text: "Steht nicht dabei, wo Sie arbeiten, ruft man lieber jemand anderen an." },
  { titel: "Formular ins Leere", text: "Nachrichten gehen an eine Adresse, in die seit Jahren niemand schaut." },
];

const faq: FaqItem[] = [
  /* Steht bewusst AN ERSTER STELLE. Auf einer Seite ohne Preise ist das die
     Frage, die jeder zuerst stellt. Bleibt sie unbeantwortet, klickt ein
     Teil der Leute weg, statt zu fragen. Der Text kommt aus einer einzigen
     Stelle in `site.ts`, damit er auf allen vier Seiten gleich lautet. */
  {
    question: 'Was muss ich selbst dafür tun?',
    answer: versprechen.aufwand,
  },
  {
    question: 'Ich habe schon eine Website. Muss die komplett neu?',
    answer:
      'Nicht zwingend. Oft liegt es an wenigen Stellen: die Telefonnummer ist nicht anklickbar, auf dem Handy muss man zoomen, und was Sie eigentlich anbieten, steht erst ganz unten. Ich schaue mir Ihre Seite an und sage Ihnen ehrlich, ob eine Überarbeitung reicht.',
  },
  {
    question: 'Muss ich Texte und Bilder liefern?',
    answer:
      'Die Texte schreibe ich. Von Ihnen brauche ich das Fachwissen: was Sie machen, für wen, und was Ihre Kundschaft immer wieder fragt. Das klären wir in einem Gespräch, Sie müssen nichts vorformulieren. Fotos aus Ihrem Betrieb sind Gold wert; falls keine da sind, finden wir eine Lösung.',
  },
  {
    question: 'Wie lange dauert das?',
    answer:
      'Für eine Website mit den üblichen Seiten rechnen Sie mit etwa drei bis fünf Wochen. Der größte Teil davon ist Abstimmung, nicht Technik. Je schneller Sie Rückmeldung geben, desto schneller geht es.',
  },
  {
    question: 'Kann ich später selbst etwas ändern?',
    answer:
      'Ja. Sie bekommen einen Zugang, über den sich Texte, Bilder und Referenzen ohne technische Kenntnisse pflegen lassen. Wenn Sie das lieber abgeben, übernehme ich es.',
  },
  {
    question: 'Was passiert nach der Fertigstellung?',
    answer:
      'Die Seite läuft, wird technisch aktuell gehalten und gesichert. Wenn sich etwas an Ihrem Angebot ändert, wird die Seite mitgezogen. Eine Website, die zwei Jahre unangetastet bleibt, verliert ihre Wirkung.',
  },
];

const included = [
  'Aufbau, der auf Anfragen ausgelegt ist, nicht auf Selbstdarstellung',
  'Texte, die Ihre Kundschaft versteht, ohne Werbefloskeln',
  'Auf dem Handy zuerst gedacht, dort kommt der Großteil Ihrer Besucher an',
  'Telefonnummer und WhatsApp mit einem Fingertipp erreichbar',
  'Kontaktformular, das auch bei den Anfragen ankommt',
  'Ladezeiten unter einer Sekunde, auch im Mobilfunknetz',
  'Rechtssicher mit Impressum und Datenschutzerklärung',
  'Technische Grundlage, auf der Suchmaschinenoptimierung überhaupt greift',
];

const steps = [
  {
    title: 'Gespräch',
    text: 'Wir klären, welche Aufträge Sie eigentlich wollen, und welche nicht. Das entscheidet alles Weitere.',
  },
  {
    title: 'Entwurf',
    text: 'Sie sehen die Startseite als Entwurf, bevor eine einzige Zeile Code entsteht. Änderungen sind hier noch billig.',
  },
  {
    title: 'Umsetzung',
    text: 'Ich baue die Seite, schreibe die Texte und richte Formular und Rechtstexte ein.',
  },
  {
    title: 'Start',
    text: 'Die Seite geht live, wird bei Google angemeldet, und Sie bekommen eine Einweisung.',
  },
];
---

<Service
  slug="webdesign"
  label="Webdesign"
  benefit="Eine Website, die Anfragen bringt statt nur gut auszusehen"
  intro="Die meisten Firmen-Websites sind digitale Visitenkarten: hübsch, aber wirkungslos. Ihre wird darauf gebaut, dass am Ende das Telefon klingelt."
  title="Webdesign für Betriebe in Essen"
  description="Websites für Betriebe und Selbstständige in Essen und im Ruhrgebiet: auf dem Handy schnell, für Anfragen gebaut, mit Texten, die Ihre Kundschaft versteht."
  faq={faq}
>
  {/* ===================== Das Problem ===================== */}
  <Band ton="hell" kennung="Wo es klemmt" heading="Acht Sekunden, dann ist die Entscheidung gefallen">
    <div class="lage">
      <div class="lage-text">
        <p>So lange schaut sich jemand Ihre Seite an, bevor er entweder anruft oder zum nächsten Treffer zurückgeht. In diesen acht Sekunden muss klar sein: Was machen Sie, sind Sie in der Nähe, und wie erreicht man Sie jetzt sofort.</p>
        <p>Die meisten Seiten verspielen das an derselben Stelle. Oben steht „Herzlich willkommen", die Telefonnummer versteckt sich im Impressum, und auf dem Handy muss man zoomen, um überhaupt etwas zu lesen.</p>
      </div>

      <div class="lage-liste">
        <h3 class="lage-titel">Woran es meistens scheitert</h3>
        <Liste eintraege={lagepunkte} anordnung="reihen" ziffern={false} />
      </div>
    </div>
  </Band>

  {/* ===================== Leistungsumfang ===================== */}
  <Band ton="gedaempft" kennung="Leistungsumfang" heading="Was drin ist"
    intro="Kein Baukasten und keine Vorlage, in die Ihr Logo hineingeschoben wird. Aufgebaut auf das, was Ihr Betrieb tatsächlich anbietet.">
    <CheckList items={included} />
  </Band>

  {/* ===================== Ablauf ===================== */}
  <Band ton="gedaempft" kennung="Ablauf" heading="So läuft es ab"
    intro="Vier Schritte, und Sie wissen an jedem Punkt, woran Sie sind.">
    <Liste
      eintraege={steps.map((s) => ({ titel: s.title, text: s.text }))}
      anordnung="spalten"
      geordnet
    />

    <p class="gebiet">Umgesetzt für Betriebe in {serviceArea.display}.</p>
  </Band>
</Service>

<style>
  .lage {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (width >= 64rem) {
    .lage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    }
  }

  .lage-text {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 52ch;
  }

  .lage-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .lage-titel {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .gebiet {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }
</style>
