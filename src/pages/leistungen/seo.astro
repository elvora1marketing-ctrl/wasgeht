---
import Service from '~/layouts/Service.astro';
import Band from '~/components/Band.astro';
import Liste from '~/components/Liste.astro';
import Sterne from '~/components/Sterne.astro';
import CheckList from '~/components/CheckList.astro';
import { serviceArea, versprechen } from '~/config/site';
import type { FaqItem } from '~/types';

/** Die Punkte neben dem Fliesstext im ersten Abschnitt. */
const lagepunkte = [
  { titel: "Nähe", text: "Wie weit Ihr Betrieb vom Suchenden entfernt ist. Nicht steuerbar, erklärt aber, warum Platzierungen je nach Standort schwanken." },
  { titel: "Vollständigkeit", text: "Sind Leistungen, Zeiten, Bilder und Einzugsgebiet hinterlegt, und stimmen sie mit Ihrer Website überein." },
  { titel: "Bewertungen", text: "Anzahl, Durchschnitt und wie frisch sie sind. Der Hebel, den fast jeder Betrieb liegen lässt." },
];

const faq: FaqItem[] = [
  /* Steht bewusst AN ERSTER STELLE. Auf einer Seite ohne Preise ist das die
     Frage, die jeder zuerst stellt. Bleibt sie unbeantwortet, klickt ein
     Teil der Leute weg, statt zu fragen. Der Text kommt aus einer einzigen
     Stelle in `site.ts`, damit er auf allen vier Seiten gleich lautet. */
  {
    question: 'Was muss ich selbst dafür tun?',
    answer: versprechen.aufwand,
  },
  {
    question: 'Wie lange dauert es, bis ich weiter oben stehe?',
    answer:
      'Beim Google-Unternehmensprofil und in der Kartenansicht zeigt sich oft schon nach wenigen Wochen etwas. Bei den normalen Suchergebnissen sollten Sie mit drei bis sechs Monaten rechnen. Wer Ihnen Platz eins in vier Wochen verspricht, verkauft Ihnen etwas, das er nicht halten kann.',
  },
  {
    question: 'Bringt das etwas, wenn ich nur im Umkreis arbeite?',
    answer:
      'Gerade dann. Lokale Suche ist der einzige Bereich, in dem ein Betrieb mit fünf Leuten eine große Kette schlagen kann, weil Google bei ortsbezogenen Suchen die Nähe höher gewichtet als die Unternehmensgröße.',
  },
  {
    question: 'Muss ich dafür ständig etwas schreiben?',
    answer:
      'Nein. Der größte Hebel im lokalen Bereich sind saubere Grundlagen: ein gepflegtes Unternehmensprofil, eindeutige Angaben zu Ihren Leistungen und Ihrem Gebiet, echte Bewertungen. Regelmäßige Beiträge sind ein Zusatz, keine Voraussetzung.',
  },
  {
    question: 'Was ist mit bezahlten Anzeigen?',
    answer:
      'Anzeigen wirken sofort und hören sofort auf zu wirken, wenn Sie nicht mehr zahlen. Sinnvoll, um eine Anlaufphase zu überbrücken oder eine Auslastungslücke zu schließen. Als dauerhafte Grundlage ist die eigene Sichtbarkeit die günstigere Rechnung.',
  },
  {
    question: 'Wie sehe ich, ob es wirkt?',
    answer:
      'An den Zahlen, die zählen: Aufrufe Ihres Profils, Klicks auf die Telefonnummer, Wegbeschreibungen, Anfragen über das Formular. Nicht an Platzierungen, die je nach Standort des Suchenden ohnehin unterschiedlich ausfallen.',
  },
];

const included = [
  'Google-Unternehmensprofil vollständig eingerichtet und gepflegt',
  'Leistungen und Einzugsgebiet so hinterlegt, dass Google sie zuordnen kann',
  'Eigene Seite je Leistung statt einer Seite für alles',
  'Technische Grundlagen: Ladezeit, Handytauglichkeit, saubere Struktur',
  'Auszeichnung für Suchmaschinen, damit Adresse und Zeiten korrekt erscheinen',
  'Einträge in den Verzeichnissen, die in Ihrer Branche tatsächlich zählen',
  'Bewertungen systematisch einsammeln statt hoffen',
  'Auswertung nach Anrufen und Anfragen, nicht nach Platzierungen',
];

const steps = [
  {
    title: 'Bestandsaufnahme',
    text: 'Wo stehen Sie heute, wonach sucht Ihre Kundschaft wirklich, und wer steht dort gerade vor Ihnen.',
  },
  {
    title: 'Grundlagen',
    text: 'Unternehmensprofil, Angaben und Technik in Ordnung bringen. Hier liegt der schnellste Gewinn.',
  },
  {
    title: 'Inhalte',
    text: 'Für jede Leistung eine eigene Seite, die die Frage beantwortet, mit der gesucht wurde.',
  },
  {
    title: 'Nachhalten',
    text: 'Monatlich prüfen, was Anrufe bringt, und dort nachlegen, wo sich Bewegung zeigt.',
  },
];
---

<Service
  slug="seo"
  label="SEO"
  benefit="Gefunden werden, wenn im Umkreis nach Ihnen gesucht wird"
  intro="Wer heute jemanden sucht, tippt nicht in die Gelben Seiten, sondern ins Handy, und ruft einen der ersten drei Treffer an. Um diese drei Plätze geht es."
  title="Lokale Suchmaschinenoptimierung für Betriebe in Essen"
  description="Lokale SEO für Betriebe und Selbstständige in Essen und im Ruhrgebiet: Google-Unternehmensprofil, eigene Leistungsseiten und Bewertungen, gemessen an Anrufen statt an Platzierungen."
  faq={faq}
>
  {/* ===================== Wie lokale Suche funktioniert ===================== */}
  <Band ton="hell" kennung="Wo es klemmt" heading="Die Entscheidung fällt auf dem ersten Bildschirm">
    <div class="lage">
      <div class="lage-text">
        <p>Bei einer Suche mit Ortsbezug zeigt Google zuerst eine Karte mit drei Betrieben. Wer dort steht, bekommt den Großteil der Anrufe. Wer darunter steht, bekommt den Rest, und wer auf Seite zwei steht, bekommt nichts.</p>
        <p>Diese drei Plätze vergibt Google nicht nach Größe oder Werbebudget, sondern nach Nähe, Vollständigkeit der Angaben und Bewertungen. Alles drei ist beeinflussbar, und genau darum geht es hier.</p>
      </div>

      <div class="lage-liste">
        {/* Der Hebel, den fast jeder Betrieb liegen laesst. Die Sterne
            fuellen sich beim Erscheinen nacheinander auf. */}
        <div class="lage-sterne">
          <Sterne wert={4.8} groesse={1.75} />
          <p class="lage-sterne-text">
            <strong>4,8</strong> ist der Schnitt, ab dem angerufen wird. Darunter
            wird verglichen.
          </p>
        </div>

        <h3 class="lage-titel">Worauf Google im lokalen Umfeld schaut</h3>
        <Liste eintraege={lagepunkte} anordnung="reihen" ziffern={false} />
      </div>
    </div>
  </Band>

  {/* ===================== Leistungsumfang ===================== */}
  <Band ton="gedaempft" kennung="Leistungsumfang" heading="Was drin ist"
    intro="Handfeste Arbeit an den Stellen, die im lokalen Umfeld tatsächlich Anrufe bewegen. Keine Berichte voller Kennzahlen, die niemand liest.">
    <CheckList items={included} />
  </Band>

  {/* ===================== Ablauf ===================== */}
  <Band ton="gedaempft" kennung="Ablauf" heading="So läuft es ab"
    intro="Erst die Grundlagen, weil sie am schnellsten wirken. Danach wird ausgebaut.">
    <Liste
      eintraege={steps.map((s) => ({ titel: s.title, text: s.text }))}
      anordnung="spalten"
      geordnet
    />

    <p class="gebiet">Betreut werden Betriebe in {serviceArea.display}.</p>
  </Band>
</Service>

<style>
  .lage {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (width >= 64rem) {
    .lage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    }
  }

  .lage-text {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 52ch;
  }

  .lage-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .lage-sterne {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-border);
  }

  .lage-sterne-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  /* Bewusst NICHT in Schreibmaschinenschrift: dort bekommt das Komma eine
     eigene Zelle und aus "4,8" wird "4 , 8". */
  .lage-sterne-text strong {
    font-weight: 600;
  }

  .lage-titel {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .gebiet {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }
</style>
