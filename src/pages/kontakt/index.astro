---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import Kanalkreise from '~/components/Kanalkreise.astro';
import PanelHero from '~/components/PanelHero.astro';
import ContactForm from '~/components/ContactForm.astro';
import WhatsappCta from '~/components/WhatsappCta.astro';
import {
  address,
  contact,
  contactLinks,
  openingHours,
  cta,
} from '~/config/site';

/** Die vier Wege, auf denen man hier ankommt. */
const kanaele = [
  { label: 'WhatsApp', href: contactLinks.whatsapp, symbol: 'chat' as const, extern: true },
  { label: 'Telefon', href: contactLinks.tel, symbol: 'telefon' as const },
  { label: 'E-Mail', href: contactLinks.mail, symbol: 'brief' as const },
  { label: 'Termin', href: cta.primary.href, symbol: 'kalender' as const },
];
---

<Base
  ohneHandyleiste
 
  title="Kontakt"
  description="Elvora aus Essen erreichen: über WhatsApp mit KI-Assistenz, telefonisch, per E-Mail oder über das Kontaktformular. Sofortige Antwort über die Assistenz."
  breadcrumbs={[{ label: 'Kontakt' }]}
>
  <PanelHero
    eyebrow="Kontakt"
    heading="So erreichen Sie mich"
    intro="Am schnellsten geht es über WhatsApp. Wer es lieber schriftlich und förmlich mag, findet darunter das Formular."
    color="#a63082"
    breadcrumbs={[{ label: 'Kontakt' }]}
  />

  <Band ton="hell" breite="inhalt">
    <div class="kontakt-raster">
      {/* --- Bevorzugter Weg: WhatsApp, zugleich Vorführung --- */}
      <div class="kontakt-wege">
        <WhatsappCta />

        {/* Alle Wege auf einen Blick. Jeder Kreis ist ein Link. */}
        <div class="kontakt-kreise">
          <p class="kontakt-kreise-titel kennung">Alle Wege zu mir</p>
          <Kanalkreise kanaele={kanaele} />
        </div>

        {/* Die übrigen Wege bewusst ruhig und ohne Buttons, damit sie dem
            Haupt-CTA keine Aufmerksamkeit wegnehmen. */}
        <div class="kontakt-daten">
          <h2 class="kennung kontakt-daten-titel">Oder ganz klassisch</h2>

          <dl class="mt-5 flex flex-col gap-4 text-[0.9375rem]">
            <div class="flex gap-4 border-b border-border pb-4">
              <dt class="w-24 shrink-0 text-ink-faint">Telefon</dt>
              <dd>
                <a href={contactLinks.tel} class="text-ink transition-colors hover:text-accent">
                  {contact.phoneDisplay}
                </a>
              </dd>
            </div>
            <div class="flex gap-4 border-b border-border pb-4">
              <dt class="w-24 shrink-0 text-ink-faint">E-Mail</dt>
              <dd>
                <a href={contactLinks.mail} class="text-ink transition-colors hover:text-accent">
                  {contact.email}
                </a>
              </dd>
            </div>
            <div class="flex gap-4 border-b border-border pb-4">
              <dt class="w-24 shrink-0 text-ink-faint">Termin</dt>
              <dd>
                <a href={cta.primary.href} class="text-ink transition-colors hover:text-accent">
                  Termin online aussuchen
                </a>
              </dd>
            </div>
            <div class="flex gap-4 border-b border-border pb-4">
              <dt class="w-24 shrink-0 text-ink-faint">Adresse</dt>
              <dd class="not-italic text-ink">
                {address.street}<br />
                {address.postalCode}&nbsp;{address.city}
              </dd>
            </div>
            <div class="flex gap-4">
              <dt class="w-24 shrink-0 text-ink-faint">Zeiten</dt>
              <dd class="text-ink">{openingHours.display}</dd>
            </div>
          </dl>
        </div>
      </div>

      {/* --- Formular --- */}
      <div class="kontakt-formular">
        <h2 class="kontakt-formular-titel">Lieber schriftlich?</h2>
        <p class="mt-3 text-ink-muted">
          Kein Problem. Je konkreter Sie beschreiben, was gerade hakt, desto
          brauchbarer fällt meine erste Antwort aus.
        </p>

        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </Band>
</Base>

<style>
  .kontakt-raster {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  @media (width >= 64rem) {
    .kontakt-raster {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  .kontakt-kreise {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .kontakt-kreise-titel {
    margin: 0 0 1.25rem;
    color: var(--color-ink-faint);
  }

  .kontakt-daten {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .kontakt-daten-titel {
    margin: 0;
    color: var(--color-ink-faint);
  }

  .kontakt-formular-titel {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .kontakt-wege,
      .kontakt-formular {
        animation-name: auftauchen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 6% entry 45%;
      }
    }
  }
</style>
